test "an initially open sheet closes through its controlled parent"
  at "/initial"
  size 390x844
  clock data
  clock settle
  expect tree has "initial-sheet-panel"
  expect tree missing "initial-sheet-handle"
  expect state focused == "initial-sheet-panel"
  tap "initial-close"
  clock settle
  expect tree missing "initial-sheet-layer"
  expect state focused == "initial-open"
  tap "initial-open"
  clock settle
  expect tree has "initial-sheet-panel"
  type "initial-close" key "Escape"
  clock settle
  expect tree missing "initial-sheet-layer"
  expect no failures

test "reopening during a controlled exit keeps the sheet interactive"
  at "/initial"
  size 390x844
  clock data
  clock settle
  type "initial-close" key "F8"
  clock +80 real
  expect state initialOpen == false
  expect tree has "initial-sheet-layer"
  type "initial-open" key "F8"
  clock settle
  expect state initialOpen == true
  expect tree has "initial-sheet-panel"
  expect state focused == "initial-sheet-panel"
  tap "initial-close"
  clock settle
  expect tree missing "initial-sheet-layer"
  expect no failures
