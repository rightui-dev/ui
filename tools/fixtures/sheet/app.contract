font "Geist"
  100 900 = "assets/fonts/Geist.ttf"
use Demo from "./sheet-demo.contract"
shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool
component App
  resource viewport = exactViewport() as shape Viewport
  state backgroundPresses = 0
  action backgroundPress
    backgroundPresses = backgroundPresses + 1
  provide
    uiFont = "sans"
  view
    column min-height="200vh" gap=24 padding=24 background-color="ui.background" color="ui.foreground"
      text "Sheet viewport regression"
      button id="outside" testId="outside" press=backgroundPress
        text "Background control"
      text backgroundPresses.toString() testId="outside-counter"
      column position="relative" overflow="hidden" translate="0px 0px" border-color="ui.border" border-width="ui.border-width" border-style="solid" padding=24 max-width=560 height=400
        Demo(width=viewport.width, reduced=viewport.prefersReducedMotion)
