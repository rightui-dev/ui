use defaultFontWeights, DropdownMenu, MenuEntry, DropdownMenuLinks, MenuLinkEntry, Popover, NavigationMenu, NavigationMenuEntry from "@rightui/ui"
use Demo as DropdownDemo from "./dropdown-demo.contract"
use SectionsDemo from "./navigation-demo.contract"
font "Geist"
  100 900 = "assets/fonts/Geist.ttf"
shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool
routes nav
  main "/"
component App
  resource viewport = exactViewport() as shape Viewport
  state right = false
  action move
    right = not right
  action choose(value: string)
    right = right
  provide
    uiFont = "sans"
    uiWeights = defaultFontWeights()
  view
    column padding=32 gap=24 min-height="100vh" box-sizing="border-box" background-color="ui.background" color="ui.foreground"
      button id="outside" testId="outside" press=move align-self="flex-start"
        text "Move controls"
      column align-items=(right ? "flex-end" : "flex-start") gap=24
        DropdownDemo(width=viewport.width, reduced=viewport.prefersReducedMotion)
        DropdownMenu(id="simple", label="Actions", entries=[MenuEntry(id="one", label="Action", shortcut="", disabled=false, destructive=false)], reduced=viewport.prefersReducedMotion, choose=choose)
        DropdownMenuLinks(id="links", label="Links", entries=[MenuLinkEntry(id="one", label="Link", href="#link")], direction="ltr", customTrigger=false, reduced=viewport.prefersReducedMotion)
        Popover(id="popover", label="Popover", focusId="field", reduced=viewport.prefersReducedMotion)
          input id="field" testId="field" aria-label="Name" placeholder="Your name"
        NavigationMenu(id="legacy", label="Documentation", entries=[NavigationMenuEntry(id="one", title="Overview", description="Introduction", href="#overview")], reduced=viewport.prefersReducedMotion)
        SectionsDemo(reduced=viewport.prefersReducedMotion)
