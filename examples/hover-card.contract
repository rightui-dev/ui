use uiFontFamily, HoverCard from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
  derive narrow = width < 600
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      HoverCard(id="controls-hover", label="@shadcn")
        row gap="ui.space-12" align-items="center"
          view width="ui.space-40" height="ui.space-40" border-radius="ui.radius-full" background-color="ui.muted" display="flex" align-items="center" justify-content="center"
            text "SC" font-size="ui.text-sm" font-weight="ui.weight-semibold" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          column gap="ui.space-4"
            text "shadcn" font-size="ui.text-sm" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            text "Composants ouverts, accessibles et composables." font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        link id="controls-hover-profile" testId="controls-hover-profile" href="https://ui.shadcn.com" color="ui.foreground" font-size="ui.text-sm"
          text "Read documentation" font-family=uiFontFamily(uiFont) data-rightui-font="body"
