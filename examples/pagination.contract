use uiFontFamily, Pagination from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
  derive narrow = width < 600
  state page = 1
  action changePage(v: number)
    page = v
  state lastPage = 6
  action changeLastPage(v: number)
    lastPage = v
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      Pagination(id="catalog-pages", page=page, total=6, change=changePage)
      text "Last page boundary" font-size="ui.text-sm" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      Pagination(id="variation-pagination-last", page=lastPage, total=6, change=changeLastPage)
