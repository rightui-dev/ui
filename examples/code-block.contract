use uiFontFamily, CodeBlock, CodeBlockAdvanced from "@rightui/ui"
use codeBlockDemoCode, codeBlockDemoLines from "./code-block-data.contract"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
  view
    column gap="ui.space-28" min-width=0 width="100%" max-width="32rem" margin="ui.space-0 auto"
      CodeBlockAdvanced(id="content-codeblock", title="app/api/chat/route.ts", language="typescript", code=codeBlockDemoCode(), lines=codeBlockDemoLines(), numbers=true, startLine=1, showDownload=true, maxHeight=440, compact=false, variant="default")
      column gap="ui.space-12" min-width=0
        text "Diff" font-size="ui.text-sm" font-weight="ui.weight-medium" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        CodeBlock(id="code-diff", title="greeting.ts", language="typescript", code=" export function greeting(name: string) {\n-  return 'Hello, ' + name\n+  return `Hello, ${name}!`\n }", numbers=false, diff=true)
