use Typography from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  view
    column gap=16 min-width=0 max-width="100%"
      Typography(id="controls-heading", variant="h1", content="The Joke Tax Chronicles")
      text "h2" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-h2", variant="h2", content="Design with clear, readable content.")
      text "h3" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-h3", variant="h3", content="Design with clear, readable content.")
      text "h4" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-h4", variant="h4", content="Design with clear, readable content.")
      text "p" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-p", variant="p", content="Design with clear, readable content.")
      text "blockquote" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-blockquote", variant="blockquote", content="Design with clear, readable content.")
      text "code" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-code", variant="code", content="npm install @rightui/ui")
      text "lead" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-lead", variant="lead", content="Design with clear, readable content.")
      text "large" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-large", variant="large", content="Design with clear, readable content.")
      text "small" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-small", variant="small", content="Design with clear, readable content.")
      text "muted" font-size="0.875rem" font-weight=600
      Typography(id="variation-type-muted", variant="muted", content="Design with clear, readable content.")
