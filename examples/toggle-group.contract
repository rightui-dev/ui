use FontWeights from "@rightui/ui"
use uiFontFamily, ToggleGroup from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  derive narrow = width < 600
  state styles: string[] = ["Italic"]
  action setStyles(v: string[])
    styles = v
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      ToggleGroup(id="catalog-styles", label="Text styles", options=["Italic", "Underline", "Strikethrough"], selected=styles, disabled=false, reduced=reduced, change=setStyles)
      text "Disabled" font-size="ui.text-sm" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      ToggleGroup(id="variation-toggle-group-disabled", label="Text styles", options=["Italic", "Underline", "Strikethrough"], selected=styles, disabled=true, reduced=reduced, change=setStyles)
