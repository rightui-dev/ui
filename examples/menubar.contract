use MenubarAdvanced, AdvancedMenuEntry, AdvancedMenuGroup, AdvancedMenuSelection from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  state checks: string[] = ["status", "bookmarks"]
  state radios: AdvancedMenuSelection[] = [AdvancedMenuSelection(group="position", value="bottom"), AdvancedMenuSelection(group="person", value="pedro"), AdvancedMenuSelection(group="zoom", value="100")]
  action choose(value: string)
    chosen = value
  action check(id: string, value: bool)
    checks = value ? checks.filter(item => item != id).concat([id]) : checks.filter(item => item != id)
  action radio(group: string, value: string)
    radios = radios.filter(item => item.group != group).concat([AdvancedMenuSelection(group=group, value=value)])
  state chosen = "No action"
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      MenubarAdvanced(id="parity-menubar", label="Application menu", menus=[AdvancedMenuGroup(id="file", label="File", entries=[AdvancedMenuEntry(id="new-tab", parent="", label="New Tab", kind="item", shortcut="⌘T", disabled=false, group="", value=""), AdvancedMenuEntry(id="new-window", parent="", label="New Window", kind="item", shortcut="⌘N", disabled=false, group="", value=""), AdvancedMenuEntry(id="incognito", parent="", label="New Incognito Window", kind="item", shortcut="", disabled=true, group="", value=""), AdvancedMenuEntry(id="file-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="share", parent="", label="Share", kind="submenu", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="share-email", parent="share", label="Email link", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="share-messages", parent="share", label="Messages", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="share-notes", parent="share", label="Notes", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="print-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="print", parent="", label="Print…", kind="item", shortcut="⌘P", disabled=false, group="", value="")]), AdvancedMenuGroup(id="edit", label="Edit", entries=[AdvancedMenuEntry(id="undo", parent="", label="Undo", kind="item", shortcut="⌘Z", disabled=false, group="", value=""), AdvancedMenuEntry(id="redo", parent="", label="Redo", kind="item", shortcut="⇧⌘Z", disabled=false, group="", value=""), AdvancedMenuEntry(id="edit-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="find", parent="", label="Find", kind="submenu", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="find-web", parent="find", label="Search the web", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="find-next", parent="find", label="Find Next", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="find-previous", parent="find", label="Find Previous", kind="item", shortcut="", disabled=false, group="", value="")]), AdvancedMenuGroup(id="view", label="View", entries=[AdvancedMenuEntry(id="bookmarks", parent="", label="Always Show Bookmarks Bar", kind="checkbox", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="status", parent="", label="Always Show Status Bar", kind="checkbox", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="view-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="zoom", parent="", label="Zoom", kind="submenu", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="zoom-group", parent="zoom", label="Zoom level", kind="group", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="zoom-100", parent="zoom-group", label="100%", kind="radio", shortcut="", disabled=false, group="zoom", value="100"), AdvancedMenuEntry(id="zoom-125", parent="zoom-group", label="125%", kind="radio", shortcut="", disabled=false, group="zoom", value="125"), AdvancedMenuEntry(id="zoom-150", parent="zoom-group", label="150%", kind="radio", shortcut="", disabled=false, group="zoom", value="150")]), AdvancedMenuGroup(id="variation-person", label="People", entries=[AdvancedMenuEntry(id="variation-person-pedro", parent="", label="Pedro", kind="radio", shortcut="", disabled=false, group="person", value="pedro"),AdvancedMenuEntry(id="variation-person-alex", parent="", label="Alex", kind="radio", shortcut="", disabled=false, group="person", value="alex")])], checks=checks, radios=radios, reduced=reduced, choose=choose, check=check, radio=radio)
