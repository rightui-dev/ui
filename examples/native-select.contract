use uiFontFamily, NativeSelect from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
  derive narrow = width < 600
  state language = "English"
  action changeLanguage(value: string)
    language = value
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      NativeSelect(id="controls-native", label="Language", options=["English", "English", "العربية"], value=language, disabled=false, change=changeLanguage)
      text "Disabled" font-size="ui.text-sm" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NativeSelect(id="variation-native-select-disabled", label="Language", options=["English", "English", "العربية"], value=language, disabled=true, change=changeLanguage)
