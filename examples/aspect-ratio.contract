use uiFontFamily, AspectRatio from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
  derive narrow = width < 600
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      AspectRatio(ratio=3)
        view position="absolute" inset=0 background-color="ui.muted" display="flex" align-items="center" justify-content="center"
          text "3 : 1" font-size="ui.text-base" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "Square" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      column id="ratio-square" max-width=240
        AspectRatio(ratio=1)
          text "Square image area" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "Portrait" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      column id="ratio-portrait" max-width=240
        AspectRatio(ratio=0.5625)
          text "Portrait image area" font-family=uiFontFamily(uiFont) data-rightui-font="body"
