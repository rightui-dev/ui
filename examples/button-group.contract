use ButtonGroupSeparator from "@rightui/ui"
use Button, ButtonGroup from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  state hasItem = false
  action createItem
    hasItem = true
  action removeItem
    hasItem = false
  view
    column gap=16 min-width=0 max-width="100%"
      ButtonGroup(label="Manage items")
        Button(id="catalog-create", label="Add", variant="primary", disabled=false, press=createItem)
        Button(id="catalog-remove", label="Remove", variant="outline", disabled=not hasItem, press=removeItem)
      text "Separated nested groups" font-weight=600
      ButtonGroup(label="Nested actions")
        ButtonGroup(label="Create actions")
          Button(id="group-nested-add", label="Add", variant="outline", disabled=false, press=createItem)
        ButtonGroupSeparator(vertical=true)
        Button(id="group-nested-remove", label="Remove", variant="outline", disabled=not hasItem, press=removeItem)
