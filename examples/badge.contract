use Badge from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      Badge(label="1", variant="outline")
      Badge(label="Default", variant="default")
      Badge(label="Secondary", variant="secondary")
      Badge(label="Destructive", variant="destructive")
      Badge(label="Ghost", variant="ghost")
      Badge(label="Link", variant="link")
