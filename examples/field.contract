use FieldFocus from "@rightui/ui"
use FontWeights from "@rightui/ui"
use uiFontFamily, Slider from "@rightui/ui"
use RadioGroup from "@rightui/ui"
use Switch from "@rightui/ui"
use Checkbox from "@rightui/ui"
use FieldSet, FieldLegend, FieldGroup, FieldFrame, FieldContent, FieldLabel, FieldDescription, FieldError, FieldSeparator from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  derive narrow = width < 600
  state name = ""
  state email = ""
  state disabled = false
  state submitted = false
  derive errors = submitted and (not email.includes("@") or email.trim() == "") ? ["Enter a valid email address.", "Enter a valid email address.", "The address must contain @."] : []
  action editName(v: string)
    name = v
    saved = false
  action editEmail(v: string)
    email = v
    saved = false
  action validate
    submitted = true
    saved = name.trim() != "" and email.includes("@")
  state saved = false
  state enabled = true
  state frequency = "Daily"
  state volume = 50
  action setEnabled(v: bool)
    enabled = v
  action setFrequency(v: string)
    frequency = v
  action setVolume(v: number)
    volume = v
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      FieldSet(id="composition-fields", legendId="composition-legend", descriptionId="composition-help", disabled=disabled)
        FieldLegend(id="composition-legend", label="Profile information", variant="legend")
        FieldDescription(id="composition-help", description="This form validates locally without sending information.")
        FieldGroup(id="composition-group", nested=false)
          FieldFrame(id="composition-name-field", labelId="composition-name-label", descriptionId="composition-name-help", invalid=(submitted and name.trim() == ""), orientation="vertical")
            FieldLabel(id="composition-name-label", label="Name", controlId="composition-name", disabled=disabled)
            input class=FieldFocus id="composition-name" testId="composition-name" padding="ui.space-10" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-sm" background-color="ui.background" color="ui.foreground" value=name input=editName submit=validate disabled=disabled aria-labelledby="composition-name-label" aria-describedby="composition-name-help" aria-required=true aria-invalid=(submitted and name.trim() == "") font-family=uiFontFamily(uiFont) data-rightui-font="body"
            FieldDescription(id="composition-name-help", description="The name displayed on your profile.")
            FieldError(id="composition-name-error", messages=(submitted and name.trim() == "" ? ["Enter your name."] : []))
          FieldSeparator(id="composition-separator", label="Contact")
          FieldFrame(id="composition-email-field", labelId="composition-email-label", descriptionId="composition-email-help", invalid=(errors.length > 0), orientation="vertical")
            FieldContent(id="composition-email-content")
              FieldLabel(id="composition-email-label", label="E-mail", controlId="composition-email", disabled=disabled)
              FieldDescription(id="composition-email-help", description="Use an address containing @.")
            input class=FieldFocus id="composition-email" testId="composition-email" padding="ui.space-10" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-sm" background-color="ui.background" color="ui.foreground" type="email" value=email input=editEmail submit=validate disabled=disabled aria-labelledby="composition-email-label" aria-describedby="composition-email-help composition-email-error" aria-required=true aria-invalid=(errors.length > 0) font-family=uiFontFamily(uiFont) data-rightui-font="body"
            FieldError(id="composition-email-error", messages=errors)
      text "Responsive checkbox" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      FieldFrame(id="field-checkbox", labelId="field-checkbox-label", descriptionId="", invalid=false, orientation=(narrow ? "vertical" : "horizontal"))
        FieldLabel(id="field-checkbox-label", label="Checkbox preference", controlId="field-check-control", disabled=false)
        Checkbox(id="field-check-control", label="Notifications", checked=enabled, disabled=false, change=setEnabled)
      text "Responsive switch" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      FieldFrame(id="field-switch", labelId="field-switch-label", descriptionId="", invalid=false, orientation=(narrow ? "vertical" : "horizontal"))
        FieldLabel(id="field-switch-label", label="Switch preference", controlId="field-switch-control", disabled=false)
        Switch(id="field-switch-control", label="Email updates", checked=enabled, disabled=false, reduced=reduced, change=setEnabled)
      text "Responsive radio" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      FieldFrame(id="field-radio", labelId="field-radio-label", descriptionId="", invalid=false, orientation=(narrow ? "vertical" : "horizontal"))
        FieldLabel(id="field-radio-label", label="Radio preference", controlId="field-radio-control", disabled=false)
        RadioGroup(id="field-radio-control", label="Delivery", options=["Daily", "Weekly"], value=frequency, disabled=false, required=false, descriptionId="", change=setFrequency)
      text "Responsive slider" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      FieldFrame(id="field-slider", labelId="field-slider-label", descriptionId="", invalid=false, orientation=(narrow ? "vertical" : "horizontal"))
        FieldLabel(id="field-slider-label", label="Slider preference", controlId="field-slider-control", disabled=false)
        Slider(id="field-slider-control", label="Volume", value=volume, minimum=0, maximum=100, step=1, disabled=false, change=setVolume)
