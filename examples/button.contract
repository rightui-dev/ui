use Button, ButtonContent, IconButton, Spinner from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  state chosen = ""
  action choose(value: string)
    chosen = value
  view
    column gap=20 align-items="center"
      row gap=12 flex-wrap="wrap" justify-content="center"
        for variant in ["primary", "secondary", "outline", "ghost", "link", "destructive"] key=variant
          Button(id="button-" + variant, label=(variant == "primary" ? "Button" : variant.slice(0, 1).toUpperCase() + variant.slice(1)), variant=variant, disabled=false, press=choose(variant))
      Button(id="button-disabled", label="Disabled", variant="outline", disabled=true, press=choose("disabled"))
      row gap=12 flex-wrap="wrap" justify-content="center"
        for size in ["sm", "default", "lg"] key=size
          ButtonContent(id="button-size-" + size, label=size, variant="outline", size=size, disabled=false, press=choose(size))
            text (size == "sm" ? "Small" : size == "lg" ? "Large" : "Default")
      row gap=12 flex-wrap="wrap" justify-content="center"
        IconButton(id="button-icon", label="Next", variant="outline", disabled=false, press=choose("icon"))
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
            path d="m9 18 6-6-6-6"
        ButtonContent(id="button-with-icon", label="Send email", variant="outline", size="default", disabled=false, press=choose("email"))
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
            rect x=2 y=4 width=20 height=16 rx=2
            path d="m2 6 10 7 10-7"
          text "Send email"
        ButtonContent(id="button-loading", label="Please wait", variant="secondary", size="default", disabled=true, press=choose("loading"))
          Spinner(id="button-loading-spinner", label="Please wait", reduced=reduced)
      if chosen != ""
        text (chosen + " button pressed") role="status" font-size="0.875rem" color="ui.muted-foreground"
