use FontWeights from "@rightui/ui"
use uiFontFamily, Button, Dialog from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  derive narrow = width < 600
  state name = ""
  state volume = 64
  state preset = "Studio"
  state dialog = false
  derive reduce = reduced
  action closeDialog
    dialog = false
    focus("dialog-open")
  action save
    saved = true
    dialog = false
    focus("dialog-open")
  state saved = false
  action openExample
    dialog = true
  view
    column gap="ui.space-16" min-width=0 max-width="100%"
      Button(id="dialog-open", label="Open dialog", variant="outline", disabled=false, press=openExample)
      Dialog(id="save-dialog", open=dialog, reduced=reduce, title="Save your project?", description="Your preferences apply to this demo workspace.", confirmLabel="Save", focusIds=["save-dialog-cancel", "save-dialog-confirm"], dismiss=closeDialog, confirm=save)
        column gap="ui.space-8" padding="ui.space-16" background-color="ui.muted" border-radius="ui.radius-md"
          text (name.trim() == "" ? "Untitled project" : name) font-size="ui.text-sm" font-weight=uiWeights.medium color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          text (preset + " · Intensity " + volume.toFixed(0) + "%") font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        column id="dialog-long-content" max-height=180 overflow="auto" gap="ui.space-12"
          for section in ["Overview", "Preferences", "Permissions", "Storage", "Notifications", "Accessibility", "Review"] key=section
            text (section + ": review the project settings before continuing.") font-family=uiFontFamily(uiFont) data-rightui-font="body"
