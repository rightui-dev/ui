use InputGroup from "@rightui/ui"
use Button, Empty from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  action createItem
    hasItem = true
  state hasItem = false
  state query = ""
  action editQuery(v: string)
    query = v
  view
    column gap=16 min-width=0 max-width="100%"
      Empty(id="catalog-empty", title="No favorites", description="Add your first item to this workspace.")
        Button(id="catalog-empty-add", label="Ajouter un favori", variant="primary", disabled=false, press=createItem)
      text "Search empty items" font-weight=600
      Empty(id="empty-search", title="No matching items", description="Try another search.")
        InputGroup(id="empty-search-input", label="Search items", value=query, placeholder="Search", prefix="", suffix="", buttonLabel="", disabled=false, edit=editQuery, submit=createItem)
