use DropdownMenuAdvanced, AdvancedMenuEntry, AdvancedMenuSelection from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  state checks: string[] = ["status", "bookmarks"]
  state radios: AdvancedMenuSelection[] = [AdvancedMenuSelection(group="position", value="bottom"), AdvancedMenuSelection(group="person", value="pedro"), AdvancedMenuSelection(group="zoom", value="100")]
  action choose(value: string)
    chosen = value
  action check(id: string, value: bool)
    checks = value ? checks.filter(item => item != id).concat([id]) : checks.filter(item => item != id)
  action radio(group: string, value: string)
    radios = radios.filter(item => item.group != group).concat([AdvancedMenuSelection(group=group, value=value)])
  state chosen = "No action"
  view
    column gap=16 min-width=0 max-width="100%"
      DropdownMenuAdvanced(id="parity-dropdown", label="My Account", entries=[AdvancedMenuEntry(id="account-label", parent="", label="My Account", kind="label", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="account-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="account-group", parent="", label="Account", kind="group", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="profile", parent="account-group", label="Profile", kind="item", shortcut="⇧⌘P", disabled=false, group="", value=""), AdvancedMenuEntry(id="billing", parent="account-group", label="Billing", kind="item", shortcut="⌘B", disabled=false, group="", value=""), AdvancedMenuEntry(id="settings", parent="account-group", label="Settings", kind="item", shortcut="⌘S", disabled=false, group="", value=""), AdvancedMenuEntry(id="invite", parent="", label="Invite users", kind="submenu", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="email", parent="invite", label="Email", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="messages", parent="invite", label="Messages", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="invite-separator", parent="invite", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="advanced", parent="invite", label="More…", kind="submenu", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="link", parent="advanced", label="Copy invitation link", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="calendar", parent="advanced", label="Calendar invitation", kind="item", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="appearance-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="appearance", parent="", label="Appearance", kind="label", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="status", parent="", label="Status Bar", kind="checkbox", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="activity", parent="", label="Activity Bar", kind="checkbox", shortcut="", disabled=true, group="", value=""), AdvancedMenuEntry(id="panel", parent="", label="Panel", kind="checkbox", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="position-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="position-label", parent="", label="Panel Position", kind="label", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="position", parent="", label="Panel Position", kind="group", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="top", parent="position", label="Top", kind="radio", shortcut="", disabled=false, group="position", value="top"), AdvancedMenuEntry(id="bottom", parent="position", label="Bottom", kind="radio", shortcut="", disabled=false, group="position", value="bottom"), AdvancedMenuEntry(id="logout-separator", parent="", label="", kind="separator", shortcut="", disabled=false, group="", value=""), AdvancedMenuEntry(id="logout", parent="", label="Log out", kind="destructive", shortcut="⇧⌘Q", disabled=false, group="", value="")], checks=checks, radios=radios, reduced=reduced, choose=choose, check=check, radio=radio)
