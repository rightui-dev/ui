use Button, Checkbox, CardFrame, CardHeader, CardTitle, CardDescription, CardAction, CardContent, CardFooter, FieldSet, FieldLegend, FieldGroup, FieldFrame, FieldContent, FieldLabel, FieldDescription, FieldError, FieldSeparator from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  derive narrow = width < 600
  state name = ""
  state email = ""
  state disabled = false
  state submitted = false
  state saved = false
  derive errors = submitted and (not email.includes("@") or email.trim() == "") ? ["Enter a valid email address.", "Enter a valid email address.", "The address must contain @."] : []
  action editName(v: string)
    name = v
    saved = false
  action editEmail(v: string)
    email = v
    saved = false
  action disable(v: bool)
    disabled = v
  action validate
    submitted = true
    saved = name.trim() != "" and email.includes("@")
  action reset
    name = ""
    email = ""
    submitted = false
    saved = false
  view
    column gap=16 min-width=0 max-width="100%"
      CardFrame(id="composition-card")
        CardHeader(id="composition-card-header")
          CardTitle(id="composition-title", title="Profile overview", level=2)
          CardDescription(id="composition-description", description="Compose card sections independently and keep data in the parent.")
          CardAction(id="composition-card-action")
            Button(id="composition-reset", label="Effacer", variant="ghost", disabled=false, press=reset)
        CardContent(id="composition-content")
          FieldSet(id="composition-fields", legendId="composition-legend", descriptionId="composition-help", disabled=disabled)
            FieldLegend(id="composition-legend", label="Profile information", variant="legend")
            FieldDescription(id="composition-help", description="This form validates locally without sending information.")
            FieldGroup(id="composition-group", nested=false)
              FieldFrame(id="composition-name-field", labelId="composition-name-label", descriptionId="composition-name-help", invalid=(submitted and name.trim() == ""), orientation="vertical")
                FieldLabel(id="composition-name-label", label="Name", controlId="composition-name", disabled=disabled)
                input id="composition-name" testId="composition-name" padding=10 border="1px solid ui.border" border-radius=6 background-color="ui.background" color="ui.foreground" value=name input=editName submit=validate disabled=disabled aria-labelledby="composition-name-label" aria-describedby="composition-name-help" aria-required=true aria-invalid=(submitted and name.trim() == "")
                FieldDescription(id="composition-name-help", description="The name displayed on your profile.")
                FieldError(id="composition-name-error", messages=(submitted and name.trim() == "" ? ["Enter your name."] : []))
              FieldSeparator(id="composition-separator", label="Contact")
              FieldFrame(id="composition-email-field", labelId="composition-email-label", descriptionId="composition-email-help", invalid=(errors.length > 0), orientation="vertical")
                FieldContent(id="composition-email-content")
                  FieldLabel(id="composition-email-label", label="E-mail", controlId="composition-email", disabled=disabled)
                  FieldDescription(id="composition-email-help", description="Use an address containing @.")
                input id="composition-email" testId="composition-email" padding=10 border="1px solid ui.border" border-radius=6 background-color="ui.background" color="ui.foreground" type="email" value=email input=editEmail submit=validate disabled=disabled aria-labelledby="composition-email-label" aria-describedby="composition-email-help composition-email-error" aria-required=true aria-invalid=(errors.length > 0)
                FieldError(id="composition-email-error", messages=errors)
        CardFooter(id="composition-footer", divided=true)
          column gap=12 min-width=0
            Checkbox(id="composition-disable", label="Disable fields", checked=disabled, disabled=false, change=disable)
            Button(id="composition-save", label="Valider localement", variant="primary", disabled=disabled, press=validate)
            text (saved ? "Profile validated locally." : "No information sent.") testId="composition-result" role="status" font-size="0.875rem" color="ui.muted-foreground"
      text "Image content" font-weight=600
      CardFrame(id="card-image")
        CardContent(id="card-image-content")
          image "data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27640%27 height=%27360%27 viewBox=%270 0 640 360%27%3E%3Crect width=%27640%27 height=%27360%27 fill=%27%23e5e5e5%27/%3E%3Cpath d=%27M0 360 200 130 330 280 450 100 640 360%27 fill=%27%23a3a3a3%27/%3E%3Ccircle cx=%27460%27 cy=%2770%27 r=%2728%27 fill=%27%23fafafa%27/%3E%3C/svg%3E" alt="Workspace illustration" width="100%"
