use uiFontFamily, AttachmentOptions, Button, AttachmentGroup, AttachmentFrame, AttachmentMedia, AttachmentContent, AttachmentTitle, AttachmentDescription, AttachmentActions, AttachmentAction, AttachmentTrigger, AttachmentPreview from "@rightui/ui"
use AttachmentDemoFile, attachmentDemoFiles, attachmentDemoDocuments from "./attachment-data.contract"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
  state attached = true
  state linked = true
  state uploading = true
  state failed = true
  state processing = true
  state idle = true
  state processed = false
  state retried = false
  state recoveredContent = ""
  state errorPreview = false
  state files: AttachmentDemoFile[] = attachmentDemoFiles()
  state compactFiles: AttachmentDemoFile[] = attachmentDemoFiles()
  state documents: AttachmentDemoFile[] = attachmentDemoDocuments()
  action remove
    attached = false
  action removeLink
    linked = false
  action removeUpload
    uploading = false
  action removeError
    failed = false
  action removeProcessing
    processing = false
  action removeIdle
    idle = false
  action finish
    processed = true
  action retry
    recoveredContent = "component,status\nButton,ready\nCard,ready\nCheckbox,ready"
    retried = true
  action previewError
    errorPreview = true
  action closeError
    errorPreview = false
    focus("attachment-error-preview")
  action removeFile(key: string)
    files = files.filter(file => file.id != key)
  action removeCompact(key: string)
    compactFiles = compactFiles.filter(file => file.id != key)
  action removeDocument(key: string)
    documents = documents.filter(file => file.id != key)
  action restore
    attached = true
    linked = true
    uploading = true
    failed = true
    processing = true
    idle = true
    processed = false
    retried = false
    recoveredContent = ""
    files = attachmentDemoFiles()
    compactFiles = attachmentDemoFiles()
    documents = attachmentDemoDocuments()
  view
    column gap="ui.space-16" min-width="0px" max-width="100%" width="100%"
      text "Preview and actions" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if attached
        AttachmentOptions(id="content-attachment", name="project-brief.txt", metadata="Text · Project overview · Ready", content="RightUI component review\nCheck keyboard navigation, responsive layouts and shared themes.\nDeliver a reusable Exact interface.", status="done", copyable=true, reduced=reduced, remove=remove, size="default", orientation="horizontal", imageSource="", cardWidth="", previewHref="", copyValue="")
      Button(id="attachment-restore", label="Restore sample attachments", variant="outline", disabled=false, press=restore)
      if linked
        AttachmentOptions(id="attachment-link", name="rightui-guide.txt", metadata="Text · Open the RightUI guide", content="", imageSource="", previewHref="https://rightui.dev/llms.txt", copyable=true, copyValue="https://rightui.dev/llms.txt", status="done", reduced=reduced, remove=removeLink, size="default", orientation="horizontal", cardWidth="")
      text "Document previews" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      AttachmentGroup(id="attachment-documents", label="Document previews", compact=false)
        for file in documents key=file.id
          AttachmentOptions(id="attachment-document-" + file.id, name=file.name, metadata=file.metadata, content=file.content, imageSource=file.source, orientation="vertical", status="done", reduced=reduced, remove=removeDocument(file.id), size="default", cardWidth="", previewHref="", copyable=false, copyValue="")
      if documents.length == 0
        text "No documents. Restore the samples to start again." role="status" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "Full attachment group" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      AttachmentGroup(id="attachment-group-full", label="Project files", compact=false)
        for file in files key=file.id
          AttachmentOptions(id="attachment-full-" + file.id, name=file.name, metadata=file.metadata, content=file.content, imageSource=file.source, cardWidth="18rem", status="done", reduced=reduced, remove=removeFile(file.id), size="default", orientation="horizontal", previewHref="", copyable=false, copyValue="")
      if files.length == 0
        text "No attachments. Restore the samples to start again." role="status" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "Compact attachment group" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      AttachmentGroup(id="attachment-group-compact", label="Compact attachments", compact=true)
        for file in compactFiles key=file.id
          AttachmentOptions(id="attachment-compact-" + file.id, name=file.name, metadata=file.metadata, content=file.content, imageSource=file.source, cardWidth="15rem", size="xs", status="done", reduced=reduced, remove=removeCompact(file.id), orientation="horizontal", previewHref="", copyable=false, copyValue="")
      if compactFiles.length == 0
        text "No compact attachments." role="status" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "States and sizes" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "The following states demonstrate local preparation; no file is sent." font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if idle
        AttachmentOptions(id="attachment-idle", name="component-inventory.csv", metadata="CSV · Ready to upload", content="component,status\nButton,ready", status="idle", size="xs", reduced=reduced, remove=removeIdle, orientation="horizontal", imageSource="", cardWidth="", previewHref="", copyable=false, copyValue="")
      if uploading
        AttachmentOptions(id="attachment-uploading", name="layout-outline.txt", metadata="Uploading · 64% · Local demo", content="Header, content and footer share the same page container.", status="uploading", reduced=reduced, remove=removeUpload, size="default", orientation="horizontal", imageSource="", cardWidth="", previewHref="", copyable=false, copyValue="")
      if processing
        AttachmentOptions(id="attachment-processing", name="accessibility-notes.txt", metadata=(processed ? "Prepared locally" : "Processing document"), content="Check focus order, labels and keyboard controls in each component.", status=(processed ? "done" : "processing"), size="sm", reduced=reduced, remove=removeProcessing, orientation="horizontal", imageSource="", cardWidth="", previewHref="", copyable=false, copyValue="")
        Button(id="attachment-finish", label="Finish local processing", variant="outline", disabled=processed, press=finish)
      if failed
        AttachmentFrame(id="attachment-error", status=(retried ? "done" : "error"), size="default", orientation="horizontal", cardWidth="")
          AttachmentMedia(name="release-checklist.csv", status=(retried ? "done" : "error"), reduced=reduced, source="", size="default", orientation="horizontal")
          AttachmentContent()
            AttachmentTitle(name="release-checklist.csv", status=(retried ? "done" : "error"), reduced=reduced, size="default")
            AttachmentDescription(text=(retried ? "Local preview ready · CSV · 3 rows" : "Local preview unavailable. Retry preparation."), status=(retried ? "done" : "error"))
          AttachmentActions(orientation="horizontal")
            if not retried
              AttachmentAction(id="attachment-error-retry", label="Retry release-checklist.csv preparation", icon="retry", press=retry)
            AttachmentAction(id="attachment-error-remove", label="Remove release-checklist.csv", icon="remove", press=removeError)
          AttachmentTrigger(id="attachment-error-preview", label="Preview release-checklist.csv", disabled=(not retried), expanded=errorPreview, controls="attachment-error-dialog", press=previewError, href="")
        if retried
          text "Preview prepared. Open the card to inspect the CSV." role="status" font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      AttachmentPreview(id="attachment-error-dialog", open=errorPreview, name="release-checklist.csv", metadata="CSV · Prepared locally", content=recoveredContent, reduced=reduced, dismiss=closeError, contentId="", imageSource="")
