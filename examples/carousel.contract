use CarouselControl, CarouselTrack, CarouselSlide, CardStyle, FontWeights, uiFontFamily from "@rightui/ui"

component NumberedCarousel
  props
    id: string
    label: string
    width: number
    visible: number
    spacing: number
    vertical: bool
    rtl: bool
    autoplay: bool
    fullWidth: bool
    externalControls: bool
    showPosition: bool
    reduced: bool
  inject
    uiFont: string
    uiWeights: FontWeights
    carouselTick: number
  state selected = 0
  state stopped = false
  state hovered = false
  state pausedAt = 0
  state resumedAt = 0
  derive playing = autoplay and not reduced and not stopped
  derive position = playing ? (pausedAt + (hovered ? 0 : carouselTick - resumedAt)) % 5 : selected
  derive axis = vertical ? "vertical" : "horizontal"
  derive viewportWidth = max(48, min(width - (vertical ? 0 : 96), width < 320 ? 192 : visible > 1 ? 384 : 320))
  derive height = vertical ? 270 : viewportWidth / visible
  action select(i: number)
    selected = i
    stopped = true
  action hover(active: bool)
    if playing and hovered != active
      if active
        pausedAt = position
      else
        resumedAt = carouselTick
      hovered = active
  view
    column width="100%" align-items="center"
      column width=(fullWidth ? "100%" : (viewportWidth + (vertical ? 0 : 96)).toString() + "px") max-width="100%" min-width=0 hover=hover
        if externalControls
          row align-items="center" gap="ui.space-8" padding-bottom="ui.space-12"
            text label flex=1 role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
            for prev in [true, false] key=prev
              CarouselControl(target=id, previous=prev, value=position, count=5, visible=visible, loop=autoplay, orientation=axis, rtl=rtl, change=select)
        CarouselTrack(id=id, label=label, value=position, count=5, orientation=axis, height=height, visible=visible, rtl=rtl, showPosition=showPosition, fullWidth=fullWidth, showControls=not externalControls, loop=autoplay, reduced=reduced, change=select)
          for n, i in [1, 2, 3, 4, 5] key=n
            CarouselSlide(id=id + "-slide-" + n.toString(), label="Card " + n.toString(), index=i, value=position, count=5, orientation=axis, height=height, reduced=reduced, rtl=rtl, visible=visible)
              column padding=spacing height="100%" width="100%" box-sizing="border-box"
                column class=CardStyle padding=0 flex=1 min-height=0 align-items="center" justify-content="center"
                  text n.toString() font-size=(visible == 1 ? "ui.text-display" : "ui.text-2xl") font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
    uiWeights: FontWeights
  derive perPage = width >= 500 ? 3 : 2
  view
    column gap="ui.space-32" width="100%" min-width=0
      NumberedCarousel(id="carousel-basic", label="Featured cards", width=width, fullWidth=false, externalControls=false, visible=1, spacing=4, vertical=false, rtl=false, autoplay=false, showPosition=false, reduced=reduced)
      NumberedCarousel(id="carousel-full-width", label="Full width", width=width, fullWidth=true, externalControls=true, visible=1, spacing=0, vertical=false, rtl=false, autoplay=false, showPosition=false, reduced=reduced)
      text "Sizes" role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NumberedCarousel(id="carousel-sizes", label="Sizes", width=width, fullWidth=false, externalControls=false, visible=perPage, spacing=8, vertical=false, rtl=false, autoplay=false, showPosition=false, reduced=reduced)
      text "Spacing" role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NumberedCarousel(id="carousel-spacing", label="Spacing", width=width, fullWidth=false, externalControls=false, visible=perPage, spacing=3, vertical=false, rtl=false, autoplay=false, showPosition=false, reduced=reduced)
      text "Vertical" role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NumberedCarousel(id="carousel-vertical", label="Vertical", width=width, fullWidth=false, externalControls=false, visible=2, spacing=4, vertical=true, rtl=false, autoplay=false, showPosition=false, reduced=reduced)
      text "Current slide" role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NumberedCarousel(id="carousel-api", label="Current slide", width=width, fullWidth=false, externalControls=false, visible=1, spacing=4, vertical=false, rtl=false, autoplay=false, showPosition=true, reduced=reduced)
      text "Autoplay" role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NumberedCarousel(id="carousel-autoplay", label="Autoplay", width=width, fullWidth=false, externalControls=false, visible=1, spacing=4, vertical=false, rtl=false, autoplay=true, showPosition=false, reduced=reduced)
      text "Right to left" role="heading" aria-level=3 font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      NumberedCarousel(id="carousel-rtl", label="Right to left", width=width, fullWidth=false, externalControls=false, visible=1, spacing=4, vertical=false, rtl=true, autoplay=false, showPosition=false, reduced=reduced)
