use Control from "./styles.contract"

component CheckboxMixed
  props
    id: string
    label: string
    checked: string
    labelVisible: bool
    disabled: bool
    change: action
  action toggle
    if not disabled
      change(checked != "true")
  view
    button id=id testId=id appearance="none" role=(checked == "mixed" ? "button" : "checkbox") aria-checked=(checked == "true") aria-label=(checked == "mixed" ? label + ", partially selected" : label) aria-description=(checked == "mixed" ? "Some items are selected. Activate to select all items." : "") disabled=disabled press=toggle
      display="flex" align-items="center" justify-content=(labelVisible ? "flex-start" : "center") gap=8 min-height=32 padding=0 border="0" background-color="transparent" color="ui.foreground" cursor="pointer"
      :disabled
        opacity=0.5
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      view width=16 height=16 flex-shrink=0 box-sizing="border-box" border-radius="ui.radius-checkbox" border=(checked == "false" ? "1px solid ui.input" : "1px solid ui.primary") background-color=(checked == "false" ? "ui.surface" : "ui.primary") display="flex" align-items="center" justify-content="center" aria-hidden=true
        if checked != "false"
          svg width=12 height=12 viewBox="0 0 24 24" fill="none" stroke="ui.primary-foreground" stroke-width=2 stroke-linecap="round"
            path d=(checked == "mixed" ? "M5 12h14" : "M5 12l4 4L19 6")
      if labelVisible
        text label font-family="Geist" font-size="0.875rem" text-align="left" min-width=0

fn rangeClean(value: number): number = match parseNumber(value.toFixed(10)) { case some(result) => result, case none => value }
fn rangeValue(value: number, minimum: number, maximum: number, step: number): number = max(minimum, min(maximum, rangeClean(minimum + round((value - minimum) / max(0.000001, step)) * max(0.000001, step))))

component RangeSlider
  props
    id: string
    label: string
    lower: number
    upper: number
    minimum: number
    maximum: number
    step: number
    minimumSteps: number
    vertical: bool
    disabled: bool
    change: action
  state active = 0
  state dragging = false
  state pointer = -1
  state coincident = false
  state origin = 0
  state extent = 1
  derive low = max(minimum, min(maximum, min(lower, upper)))
  derive high = max(minimum, min(maximum, max(lower, upper)))
  derive span = max(0.000001, maximum - minimum)
  derive gap = min(span, max(0, minimumSteps) * max(0.000001, step))
  derive lowRatio = (low - minimum) / span
  derive highRatio = (high - minimum) / span
  action update(which: number, value: number)
    if not disabled and maximum > minimum
      let next = rangeValue(value, minimum, maximum, step)
      if which == 0
        change(min(next, max(minimum, high - gap)), high)
      else
        change(low, max(next, min(maximum, low + gap)))
  action begin(forced: number, e: PointerEvent)
    if not disabled and e.button == 0 and pointer == -1 and maximum > minimum
      let bounds = frame(id + "-track")
      let length = max(1, vertical ? bounds.height - 16 : bounds.width - 16)
      let offset = max(0, min(length, vertical ? bounds.y + bounds.height - e.clientY - 8 : e.clientX - bounds.x - 8))
      let value = minimum + offset / length * span
      let which = forced >= 0 ? forced : max(value - low, low - value) <= max(value - high, high - value) ? 0 : 1
      stopPropagation()
      extent = length
      origin = vertical ? bounds.y + bounds.height - 8 : bounds.x + 8
      active = which
      dragging = true
      pointer = e.pointerId
      coincident = low == high
      update(which, value)
      focus(id + "-thumb-" + which.toString())
  action move(e: PointerEvent)
    if dragging and not disabled and e.pointerId == pointer
      let next = max(0, min(extent, vertical ? origin - e.clientY : e.clientX - origin))
      let value = rangeValue(minimum + next / extent * span, minimum, maximum, step)
      let which = coincident ? (value < low ? 0 : 1) : active
      if coincident and value != low
        active = which
        coincident = false
        focus(id + "-thumb-" + which.toString())
      update(which, value)
  action finish(e: PointerEvent)
    if e.pointerId == pointer
      dragging = false
      pointer = -1
  action keys(which: number, key: string)
    if not disabled and (key == "ArrowRight" or key == "ArrowUp" or key == "ArrowLeft" or key == "ArrowDown" or key == "Home" or key == "End" or key == "PageUp" or key == "PageDown")
      preventDefault()
      let value = which == 0 ? low : high
      let next = key == "Home" ? minimum : key == "End" ? maximum : value + (key == "ArrowRight" or key == "ArrowUp" ? step : key == "PageUp" ? step * 10 : key == "PageDown" ? -step * 10 : -step)
      update(which, next)
  view
    column id=id testId=id gap=8 min-width=0 color="ui.foreground"
      row gap=8 align-items="center" justify-content="space-between" flex-wrap="wrap"
        text label font-size="0.875rem" font-weight=500
        text (low.toString() + " — " + high.toString()) testId=(id + "-value") font-size="0.875rem" font-variant-numeric="tabular-nums" color="ui.muted-foreground"
      view id=(id + "-track") testId=(id + "-track") role="group" aria-label=label position="relative" width=(vertical ? "44px" : "100%") height=(vertical ? 192 : 44) touch-action="none" pointerdown=begin(-1) pointerup=finish pointermove=move opacity=(disabled ? 0.5 : 1) cursor=(disabled ? "default" : "pointer")
        view position="absolute" left=(vertical ? "20px" : "8px") top=(vertical ? "8px" : "20px") right=(vertical ? "auto" : "8px") bottom=(vertical ? "8px" : "auto") width=(vertical ? "4px" : "auto") height=(vertical ? "auto" : "4px") background-color="ui.muted" border-radius="ui.radius-full"
          view position="absolute" left=(vertical ? "0px" : (lowRatio * 100).toString() + "%") bottom=(vertical ? (lowRatio * 100).toString() + "%" : "0px") width=(vertical ? "100%" : ((highRatio - lowRatio) * 100).toString() + "%") height=(vertical ? ((highRatio - lowRatio) * 100).toString() + "%" : "100%") background-color="ui.primary" border-radius="ui.radius-full" pointer-events="none"
          for which in [0, 1] key=which
            view id=(id + "-thumb-" + which.toString()) testId=(id + "-thumb-" + which.toString()) role="slider" tabindex=(disabled ? -1 : 0) key=keys(which) pointerdown=begin(which) pointerup=finish pointermove=move touch-action="none" aria-label=(label + (which == 0 ? " minimum" : " maximum")) aria-orientation=(vertical ? "vertical" : "horizontal") aria-disabled=disabled aria-valuemin=(which == 0 ? minimum : low + gap) aria-valuemax=(which == 0 ? high - gap : maximum) aria-valuenow=(which == 0 ? low : high)
              position="absolute" z-index=(which + 1) left=(vertical ? "-6px" : ((which == 0 ? lowRatio : highRatio) * 100).toString() + "%") bottom=(vertical ? ((which == 0 ? lowRatio : highRatio) * 100).toString() + "%" : "auto") top=(vertical ? "auto" : "-6px") translate=(vertical ? "0px 8px" : "-8px 0px") width=16 height=16 border="2px solid ui.primary" border-radius="ui.radius-full" box-sizing="border-box" background-color="ui.background" box-shadow="0 1px 2px 0 ui.shadow"
              :hover
                box-shadow="0 0 0 4px ui.ring"
              :focus-visible
                box-shadow="0 0 0 4px ui.ring"

component AccordionMultiple
  props
    id: string
    titles: string[]
    descriptions: string[]
    expanded: number[]
    reduced: bool
    change: action
  state hovered = -1
  action hoverItem(index: number, inside: bool)
    hovered = inside ? index : -1
  action toggle(index: number)
    change(expanded.includes(index) ? expanded.filter(i => i != index) : expanded.concat([index]))
  action keys(index: number, key: string)
    if key == "ArrowDown" or key == "ArrowUp" or key == "Home" or key == "End"
      preventDefault()
      let next = key == "Home" ? 0 : key == "End" ? titles.length - 1 : (index + (key == "ArrowDown" ? 1 : titles.length - 1)) % max(1, titles.length)
      focus(id + "-trigger-" + next.toString())
  view
    column id=id testId=id min-width=0
      for title, i in titles key=title
        column border-bottom=(i == titles.length - 1 ? "none" : "1px solid ui.border")
          button id=(id + "-trigger-" + i.toString()) testId=(id + "-trigger-" + i.toString()) class=Control aria-expanded=expanded.includes(i) aria-controls=(id + "-panel-" + i.toString()) press=toggle(i) key=keys(i) hover=hoverItem(i)
            display="flex" align-items="flex-start" gap=16 padding=16 border="0" background-color="transparent" color="ui.foreground"
            text title flex=1 min-width=0 text-align="left" text-decoration=(hovered == i ? "underline" : "none")
            svg width=16 height=16 flex-shrink=0 viewBox="0 0 24 24" fill="none" stroke="ui.muted-foreground" stroke-width=2 rotate=(expanded.includes(i) ? "180deg" : "0deg") transition=(reduced ? "none" : "rotate 200ms ease-out") aria-hidden=true
              path d="m6 9 6 6 6-6"
          column id=(id + "-panel-" + i.toString()) testId=(expanded.includes(i) ? id + "-panel-" + i.toString() : "") role="region" aria-labelledby=(id + "-trigger-" + i.toString()) aria-hidden=(not expanded.includes(i)) inert=(not expanded.includes(i)) height=(expanded.includes(i) ? "auto" : "0px") overflow="hidden" -exact-layout-transition=(reduced ? "none" : "200ms ease-out")
            column padding="0px 16px 16px" min-width=0
              match descriptions.at(i)
                case some(description)
                  text description font-size="0.875rem" line-height=1.5
                case none
                  text ""
