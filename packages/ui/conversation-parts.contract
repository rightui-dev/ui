use uiFontFamily from "./typography-context.contract"
use ButtonControl, ButtonContent from "./button.contract"

component MessageFrame
  props
    id: string
    align: string
  slot
  view
    row id=id testId=id width="100%" min-width="0px" gap="ui.space-8" flex-direction=(align == "end" ? "row-reverse" : "row")
      children

component MessageContent
  props
    id: string
    align: string
  slot
  view
    column id=id testId=id width="100%" min-width="0px" gap="ui.space-8" align-items=(align == "end" ? "flex-end" : "stretch") font-size="ui.text-sm" line-height="ui.leading-code"
      children

component MessageFooter
  props
    id: string
    align: string
  slot
  view
    row id=id testId=id gap="0px" min-width="0px" padding=(align == "end" ? "0px ui.space-12" : "0px") justify-content=(align == "end" ? "flex-end" : "flex-start") color="ui.muted-foreground"
      children

fn bubbleFill(variant: string): string = variant == "primary" or variant == "default" ? "ui.primary" : variant == "ghost" ? "transparent" : variant == "outline" ? "ui.surface" : variant == "tinted" ? "color-mix(in srgb, ui.primary 12%, ui.surface)" : variant == "destructive" ? "color-mix(in srgb, ui.danger 12%, ui.surface)" : variant == "secondary" ? "ui.muted" : "color-mix(in srgb, ui.muted 65%, ui.surface)"
fn bubbleInk(variant: string): string = variant == "primary" or variant == "default" ? "ui.primary-foreground" : variant == "destructive" ? "ui.danger" : "ui.foreground"

component BubbleFrame
  props
    id: string
    align: string
    variant: string
  slot
  view
    column id=id testId=id position="relative" width=(variant == "ghost" ? "100%" : "auto") max-width=(variant == "ghost" ? "100%" : "80%") min-width="0px" box-sizing="border-box" align-self=(align == "end" ? "flex-end" : "flex-start") padding=(variant == "ghost" ? "0px" : "ui.space-10 ui.space-12") border-radius=(variant == "ghost" ? "0px" : "ui.ai-radius-bubble") border-width=(variant == "ghost" ? "0px" : "ui.border-width") border-style="solid" border-color=(variant == "outline" ? "ui.border" : "transparent") background-color=bubbleFill(variant) color=bubbleInk(variant)
      children

component MessageAction
  props
    id: string
    label: string
    icon: string
    pressed: bool
    press: action
  inject
    uiFont: string
  view
    row
      ButtonControl(id=id, label=label, variant="ghost", size="icon-sm", disabled=false, pressed=(icon == "hand.thumbsup" or icon == "hand.thumbsdown" ? some(pressed) : none), describedBy=id + "-tip", press=press)
        MessageIcon(name=icon, filled=pressed)
      view id=(id + "-tip") testId=(id + "-tip") role="tooltip" popover="auto" position-area="top" position-try-fallbacks="flip-block, flip-inline" margin="ui.space-4" padding="ui.space-6 ui.space-12" border="0" border-radius="ui.ai-radius-item" background-color="ui.foreground" color="ui.background"
        text label font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component MessageIcon
  props
    name: string
    filled: bool
  view
    svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill=(filled and (name == "hand.thumbsup" or name == "hand.thumbsdown") ? "currentColor" : "none") stroke="currentColor" stroke-width="ui.stroke-standard" stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
      if name == "copy"
        rect x=9 y=9 width=13 height=13 rx=2
        path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
      else if name == "check"
        path d="m20 6-11 11-5-5"
      else if name == "pencil"
        path d="m16 3 5 5M4 15 15.5 3.5a3.5 3.5 0 0 1 5 5L9 20l-6 1z"
      else if name == "hand.thumbsup"
        path d="M7 10v12H3V10zm0 10h12a2 2 0 0 0 2-1.7l1-7A2 2 0 0 0 20 9h-6l1-5a3 3 0 0 0-3-3L7 10"
      else if name == "hand.thumbsdown"
        path d="M17 14V2h4v12zm0-10H5a2 2 0 0 0-2 1.7l-1 7A2 2 0 0 0 4 15h6l-1 5a3 3 0 0 0 3 3l5-9"
      else if name == "arrow.up"
        path d="M12 19V5m-7 7 7-7 7 7"
      else if name == "plus"
        path d="M12 5v14M5 12h14"
      else if name == "message"
        path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"
      else
        path d="M3 11a9 9 0 0 1 15.4-6.4L21 7M21 3v4h-4M21 13a9 9 0 0 1-15.4 6.4L3 17m4 0H3v4"

component MessageEditor
  props
    id: string
    value: string
    edit: action
    save: action
  inject
    uiFont: string
  view
    column gap="ui.space-8" width="100%"
      textarea id=id testId=id value=value input=edit aria-label="Edit message" min-height="ui.space-80" padding="ui.space-12" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.ai-radius-control" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      ButtonContent(id=id + "-save", label="Save", variant="default", size="sm", disabled=(value.trim() == ""), press=save)
        text "Save" font-family=uiFontFamily(uiFont) data-rightui-font="body"
