use uiPopupIn, uiPopupOut from "./popup-motion.contract"
use uiReveal, uiPopover from "./motion.contract"
use Control from "./styles.contract"
use DisclosureButton from "./button.contract"
component Accordion
  props
    id: string
    titles: string[]
    descriptions: string[]
    expanded: number
    reduced: bool
    change: action
  state hovered = -1
  action setHover(i: number, inside: bool)
    hovered = inside ? i : -1
  action toggle(i: number)
    change(expanded == i ? -1 : i)
  action keys(i: number, k: string)
    if k == "Enter" or k == " "
      preventDefault()
      toggle(i)
    else if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
      preventDefault()
      let next = (k == "Home" ? 0 : k == "End" ? titles.length - 1 : (i + (k == "ArrowDown" ? 1 : titles.length - 1)) % max(1, titles.length))
      focus(id + "-trigger-" + next.toString())
  view
    column id=id testId=id
      for title, i in titles key=title
        column border-bottom=(i == titles.length - 1 ? "none" : "1px solid ui.border") min-width=0
          button id=(id + "-trigger-" + i.toString()) testId=(id + "-trigger-" + i.toString()) class=Control
            aria-expanded=(expanded == i) aria-controls=(id + "-panel-" + i.toString()) press=toggle(i) key=keys(i) hover=setHover(i)
            display="flex" align-items="flex-start" justify-content="space-between" gap=16 padding=16 border="0" background-color="transparent" color="ui.foreground"
            text title flex=1 min-width=0 text-align="left" text-decoration=(hovered == i ? "underline" : "none") font-size="0.875rem" font-weight=500
            svg width=16 height=16 margin-top=2 flex-shrink=0 viewBox="0 0 24 24" fill="none" stroke="ui.muted-foreground" stroke-width=2 rotate=(expanded == i ? "180deg" : "0deg") transition=(reduced ? "none" : "rotate 200ms ease-out") aria-hidden=true
              path d="m6 9 6 6 6-6"
          column id=(id + "-panel-" + i.toString()) testId=(expanded == i ? id + "-panel-" + i.toString() : "") role="region" aria-labelledby=(id + "-trigger-" + i.toString()) aria-hidden=(expanded != i) inert=(expanded != i) height=(expanded == i ? "auto" : "0px") min-height=0 overflow="hidden"
            -exact-layout-transition=(reduced ? "none" : "200ms ease-out")
            column padding="0px 16px 16px" min-width=0
              match descriptions.at(i)
                case some(description)
                  text description font-size="0.875rem" line-height=1.5 color="ui.foreground"
                case none
                  text "" font-size="0.875rem"

component Collapsible
  props
    id: string
    label: string
    open: bool
    reduced: bool
    change: action
  slot
  action toggle
    change(not open)
  view
    column gap=0 min-width=0
      DisclosureButton(id=id, label=label, variant="outline", controls=id + "-content", expanded=open, icon=false, press=toggle)
        text label
      column id=(id + "-content") testId=(open ? id + "-content" : "") height=(open ? "auto" : "0px") min-height=0 overflow="hidden" aria-hidden=(not open) inert=(not open)
        -exact-layout-transition=(reduced ? "none" : "200ms ease-out")
        column padding-top=12 gap=8 min-width=0
          children

component Popover
  props
    id: string
    label: string
    focusId: string
    reduced: bool
  slot
  state expanded = false
  state openEpoch = 0
  action toggle
    if expanded
      expanded = false
    else
      openEpoch = openEpoch + 1
      expanded = true
      showPopover(id + "-content", source=id)
      focus(focusId)
  action changed(epoch: number, e: ToggleEvent)
    if epoch == openEpoch
      expanded = e.newState == "open"

  action keys(k: string)
    if k == "Escape"
      preventDefault()
      expanded = false
      focus(id)
  view
    column align-items="flex-start"
      button id=id testId=id class=Control aria-expanded=expanded aria-controls=(id + "-content") press=toggle
        padding="8px 12px" border="1px solid ui.border" background-color="ui.surface" color="ui.foreground"
        text label
      if expanded
        for epoch in [openEpoch] key=epoch
          column id=(id + "-content") testId=(id + "-content") popover="auto" toggle=changed(epoch) keycapture=keys
            position-area="bottom" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline"
            animation=(reduced ? "none" : "uiPopupIn 150ms ease-out both")
            -exact-exit-animation=(reduced ? "none" : "uiPopupOut 100ms ease-in both")
            width="18rem" max-width="calc(100vw - 32px)" max-height="min(30rem, 70vh)" overflow="auto"
            box-sizing="border-box" margin=4 padding=16 gap=16 border="1px solid ui.border" border-radius="ui.radius-popover" background-color="ui.surface" color="ui.foreground" box-shadow="0 4px 6px -1px #0000001a, 0 2px 4px -2px #0000001a"
            children
