use FontWeights from "./typography-context.contract"
use uiFontFamily from "./typography-context.contract"
use Control, Field from "./styles.contract"
use CheckboxMixed from "./advanced-controls.contract"
use Popover from "./disclosure.contract"
use Select from "./select.contract"

shape GridColumn
  id: string
  label: string
  kind: string
  align: string
  sortable: bool
  searchable: bool
shape GridRow
  id: string
  values: string[]
fn gridValue(row: GridRow, index: number): string = match row.values.at(index) { case some(value) => value, case none => "" }
fn gridNumber(row: GridRow, index: number): number = match parseNumber(gridValue(row, index)) { case some(value) => value, case none => 0 }
fn gridSearch(row: GridRow, columns: GridColumn[], query: string): bool = columns.filter((column, i) => column.searchable and gridValue(row, i).toLowerCase().includes(query)).length > 0

component DataGrid
  props
    id: string
    label: string
    columns: GridColumn[]
    rows: GridRow[]
    initialPageSize: number
    reduced: bool
    selectionChanged: action
    openRow: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state query = ""
  state sortColumn = ""
  state sortOrder = "none"
  state page = 0
  state pageSize = max(1, floor(initialPageSize))
  state selected: string[] = []
  state hidden: string[] = []
  derive filtered = query.trim() == "" ? rows : rows.filter(row => gridSearch(row, columns, query.trim().toLowerCase()))
  derive sortIndex = columns.map(column => column.id).indexOf(sortColumn)
  derive sortKind = match columns.at(sortIndex) { case some(column) => column.kind, case none => "text" }
  derive ordered = sortOrder == "none" or sortIndex < 0 ? filtered : sortKind == "number" or sortKind == "currency" or sortKind == "percent" ? (sortOrder == "desc" ? sortBy(filtered, row => gridNumber(row, sortIndex), "desc") : sortBy(filtered, row => gridNumber(row, sortIndex))) : (sortOrder == "desc" ? sortBy(filtered, row => gridValue(row, sortIndex).toLowerCase(), "desc") : sortBy(filtered, row => gridValue(row, sortIndex).toLowerCase()))
  derive pageCount = max(1, ceil(ordered.length / pageSize))
  derive currentPage = min(max(0, page), pageCount - 1)
  derive visible = ordered.slice(currentPage * pageSize, (currentPage + 1) * pageSize)
  derive visibleColumns = columns.filter(column => not hidden.includes(column.id))
  derive visibleSelected = visible.filter(row => selected.includes(row.id)).length
  derive rowIds = rows.map(row => row.id)
  derive visibleIds = visible.map(row => row.id)
  derive liveSelected = selected.filter(key => rowIds.includes(key))
  derive selectedFiltered = filtered.filter(row => selected.includes(row.id)).length
  derive focusColumn = match first(columns.filter(column => hidden.includes(column.id) or visibleColumns.length > 1)) { case some(column) => columns.map(value => value.id).indexOf(column.id), case none => 0 }
  derive pageChecked = visibleSelected == 0 ? "false" : visibleSelected == visible.length ? "true" : "mixed"
  action search(value: string)
    query = value
    page = 0
  action sortByColumn(column: GridColumn)
    if column.sortable
      sortOrder = sortColumn != column.id or sortOrder == "none" ? "asc" : sortOrder == "asc" ? "desc" : "none"
      sortColumn = column.id
      page = 0
  action selectRow(key: string, checked: bool)
    let next = checked ? liveSelected.filter(value => value != key).concat([key]) : liveSelected.filter(value => value != key)
    selected = next
    selectionChanged(next)
  action selectPage(checked: bool)
    let keep = liveSelected.filter(key => not visibleIds.includes(key))
    let next = checked ? keep.concat(visibleIds) : keep
    selected = next
    selectionChanged(next)
  action showColumn(key: string, checked: bool)
    if checked
      hidden = hidden.filter(value => value != key)
    else if visibleColumns.length > 1
      hidden = hidden.filter(value => value != key).concat([key])
  action chooseSize(value: string)
    match parseNumber(value)
      case some(size)
        pageSize = max(1, floor(size))
        page = 0
      case none
        page = page
  action go(target: number)
    page = max(0, min(pageCount - 1, target))
  view
    column id=id testId=id gap="ui.space-16" min-width="0px" color="ui.foreground"
      row gap="ui.space-12" flex-wrap="wrap" align-items="flex-end" justify-content="space-between"
        input id=(id + "-search") testId=(id + "-search") class=Field font-weight=uiWeights.regular value=query input=search placeholder="Filter rows..." aria-label=("Filter " + label) flex="1 1 12rem" max-width="20rem" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if columns.length > 0
          Popover(id=id + "-columns", label="Columns", focusId=id + "-column-" + focusColumn.toString(), reduced=reduced)
            text "Toggle columns" font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column gap="ui.space-4"
              for column, i in columns key=column.id
                CheckboxMixed(id=id + "-column-" + i.toString(), label=column.label, labelVisible=true, checked=(hidden.includes(column.id) ? "false" : "true"), disabled=(not hidden.includes(column.id) and visibleColumns.length == 1), change=showColumn(column.id))
      scroll min-width="0px" max-height="30rem" overflow="auto" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" tabindex=0 aria-label=label
        table aria-label=label width="100%" border-spacing=0 font-size="ui.text-sm" line-height="ui.leading-control"
          thead
            tr
              th scope="col" padding="0px ui.space-12" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" width="ui.space-44"
                CheckboxMixed(id=id + "-all", label="Select page", labelVisible=false, checked=pageChecked, disabled=visible.length == 0, change=selectPage)
              for column in visibleColumns key=column.id
                th scope="col" padding="ui.space-8 ui.space-12" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" text-align=column.align aria-sort=(sortColumn == column.id and sortOrder != "none" ? (sortOrder == "desc" ? "descending" : "ascending") : "none")
                  if column.sortable
                    button id=(id + "-sort-" + column.id) testId=(id + "-sort-" + column.id) class=Control font-weight=uiWeights.medium press=sortByColumn(column) padding="ui.space-4 0px" min-height="ui.space-32" border="0" background-color="transparent" color="ui.foreground" text-align=column.align
                      text (column.label + (sortColumn == column.id and sortOrder != "none" ? (sortOrder == "desc" ? " ↓" : " ↑") : "")) font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  else
                    text column.label font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
              th scope="col" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12"
                text "Actions" font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          tbody
            for row in visible key=row.id
              tr testId=(id + "-row-" + row.id) background-color=(selected.includes(row.id) ? "ui.muted" : "transparent")
                td padding="ui.space-4 ui.space-12" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border"
                  CheckboxMixed(id=id + "-select-" + row.id, label="Select row " + row.id, labelVisible=false, checked=(selected.includes(row.id) ? "true" : "false"), disabled=false, change=selectRow(row.id))
                for column in visibleColumns key=column.id
                  td testId=(id + "-cell-" + row.id + "-" + column.id) padding="ui.space-12" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" text-align=column.align
                    if column.kind == "badge"
                      row justify-content=(column.align == "right" ? "flex-end" : "flex-start")
                        text gridValue(row, columns.map(value => value.id).indexOf(column.id)) border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-full" padding="ui.space-2 ui.space-8" font-size="ui.text-xs" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    else
                      text (column.kind == "currency" ? "$" + gridNumber(row, columns.map(value => value.id).indexOf(column.id)).toFixed(2) : column.kind == "percent" ? gridValue(row, columns.map(value => value.id).indexOf(column.id)) + "%" : gridValue(row, columns.map(value => value.id).indexOf(column.id))) font-variant-numeric=(column.kind == "text" ? "normal" : "tabular-nums") font-family=uiFontFamily(uiFont) data-rightui-font="body"
                td padding="ui.space-4 ui.space-12" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border"
                  button class=Control font-weight=uiWeights.medium id=(id + "-open-" + row.id) testId=(id + "-open-" + row.id) press=openRow(row.id) aria-label=("Open row " + row.id) min-height="ui.space-32" width="ui.space-32" padding="0px" border="0" background-color="transparent" color="ui.foreground"
                    svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.stroke-standard" stroke-linecap="round" aria-hidden=true
                      path d="M5 12h.01M12 12h.01M19 12h.01"
            if visible.length == 0
              tr
                td colspan=(visibleColumns.length + 2) padding="ui.space-32" text-align="center"
                  text "No results." testId=(id + "-empty") font-family=uiFontFamily(uiFont) data-rightui-font="body"
      row gap="ui.space-16" flex-wrap="wrap" align-items="center" justify-content="space-between"
        text (selectedFiltered.toString() + " of " + filtered.length.toString() + " row(s) selected.") testId=(id + "-selection") font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        row gap="ui.space-16" align-items="flex-end" flex-wrap="wrap"
          view width="7rem"
            Select(id=id + "-page-size", label="Rows per page", options=["5", "10", "20", "50"], value=pageSize.toString(), disabled=false, reduced=reduced, change=chooseSize)
          row gap="ui.space-8" align-items="center"
            text ("Page " + (currentPage + 1).toString() + " of " + pageCount.toString()) testId=(id + "-page") font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
            for command in ["first", "previous", "next", "last"] key=command
              button id=(id + "-" + command) testId=(id + "-" + command) class=Control font-weight=uiWeights.medium press=go(command == "first" ? 0 : command == "previous" ? currentPage - 1 : command == "next" ? currentPage + 1 : pageCount - 1) disabled=(command == "first" or command == "previous" ? currentPage == 0 : currentPage == pageCount - 1) aria-label=(command + " page") width="ui.space-32" height="ui.space-32" min-height="ui.space-32" padding="0px" border-width="ui.border-width" border-style="solid" border-color="ui.input" background-color="ui.surface" color="ui.foreground"
                text (command == "first" ? "«" : command == "previous" ? "‹" : command == "next" ? "›" : "»") font-family=uiFontFamily(uiFont) data-rightui-font="body"
