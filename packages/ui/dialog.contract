use Button from "./button.contract"
use Control from "./styles.contract"
use uiModalFadeIn, uiModalFadeOut, uiModalZoomIn, uiModalZoomOut from "./overlays.contract"
component Dialog
  props
    id: string
    open: bool
    reduced: bool
    title: string
    description: string
    confirmLabel: string
    focusIds: string[]
    dismiss: action
    confirm: action
  slot
  state focused = ""
  action rememberFocus(e: FocusEvent)
    focused = e.target
  action keys(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      dismiss()
    if k == "Tab"
      preventDefault()
      let targets = [id + "-close"].concat(focusIds)
      let index = targets.indexOf(focused)
      let next = (index + (e.shiftKey ? targets.length - 1 : 1)) % max(1, targets.length)
      match targets.at(next)
        case some(target)
          focus(target)
        case none
          focus(id + "-cancel")
  view
    column position="absolute" inset=0 z-index=110 pointer-events="none" align-items="center" justify-content="center" padding=16 box-sizing="border-box"
      if open
        view id=(id + "-backdrop") testId=(id + "-backdrop") position="absolute" inset=0 background-color="ui.overlay" pointer-events="auto" aria-hidden=true press=dismiss
          animation=(reduced ? "none" : "uiModalFadeIn 200ms ease-in-out both")
          -exact-exit-animation=(reduced ? "none" : "uiModalFadeOut 200ms ease-in-out both")
      if open
        column id=id testId=id role="dialog" aria-modal=true aria-labelledby=(id + "-title")
          aria-describedby=(id + "-description") pointer-events="auto" position="relative" keycapture=keys focusin=rememberFocus width="100%" max-width="32rem" max-height="100%" box-sizing="border-box"
          background-color="ui.surface" border="1px solid ui.border" border-radius="ui.radius-panel" padding=24 gap=16 box-shadow="0 10px 15px -3px ui.shadow, 0 4px 6px -4px ui.shadow"
          animation=(reduced ? "none" : "uiModalZoomIn 200ms ease-in-out both")
          -exact-exit-animation=(reduced ? "none" : "uiModalZoomOut 200ms ease-in-out both")
          button id=(id + "-close") testId=(id + "-close") class=Control press=dismiss aria-label="Close" position="absolute" top=16 right=16 width=16 height=16 min-height=16 padding=0 border="none" background-color="transparent" color="ui.foreground" opacity=0.7
            svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
              path d="m6 6 12 12M6 18 18 6"
          scroll flex="1 1 auto" min-height=0
            column gap=16
              column gap=8 padding-right=24
                text title hyphens="auto" id=(id + "-title") role="heading" aria-level=2 font-size="1.125rem" font-weight=600 color="ui.foreground"
                text description hyphens="auto" id=(id + "-description") font-size="0.875rem" line-height=1.5 color="ui.muted-foreground"
              children
          row gap=8 flex-shrink=0 justify-content="flex-end" flex-wrap="wrap"
            button id=(id + "-cancel") testId=(id + "-cancel") autofocus=true appearance="none" press=dismiss
              min-height="2.25rem" max-width="100%" border="1px solid ui.border" border-radius="ui.radius-control" padding="8px 16px" background-color="ui.surface" color="ui.foreground"
              :focus-visible
                box-shadow="0 0 0 3px ui.ring"
              text "Cancel" font-size="0.875rem"
            Button(id=id + "-confirm", label=confirmLabel, variant="primary", disabled=false, press=confirm)
