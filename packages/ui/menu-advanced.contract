use FontWeights from "./typography-context.contract"
use uiFontFamily from "./typography-context.contract"
use Control from "./styles.contract"
use uiPopupIn, uiPopupOut from "./popup-motion.contract"

keyframes advancedSubmenuIn
  from opacity=0 scale=0.95 translate="-8px 0px"
  to opacity=1 scale=1 translate="0px 0px"

shape AdvancedMenuEntry
  id: string
  parent: string
  label: string
  kind: string
  shortcut: string
  disabled: bool
  group: string
  value: string

shape AdvancedMenuSelection
  group: string
  value: string

shape AdvancedMenuGroup
  id: string
  label: string
  entries: AdvancedMenuEntry[]

shape AdvancedMenuBranch
  parent: string
  epoch: number

fn advancedMenuPrefix(id: string, bar: bool, group: string): string = bar ? id + "-" + group : id
fn advancedMenuFocusable(entry: AdvancedMenuEntry): bool = not entry.disabled and ["item", "destructive", "checkbox", "radio", "submenu"].includes(entry.kind)
fn advancedMenuRows(entries: AdvancedMenuEntry[], panel: string): AdvancedMenuEntry[] = entries.filter(entry => entry.parent == panel or entries.filter(group => group.kind == "group" and group.parent == panel).map(group => group.id).includes(entry.parent)).filter(entry => advancedMenuFocusable(entry))
fn advancedMenuRadio(entry: AdvancedMenuEntry, selections: AdvancedMenuSelection[]): bool = selections.filter(selection => selection.group == entry.group and selection.value == entry.value).length > 0

component AdvancedMenuLine
  props
    id: string
    radius: string
    entry: AdvancedMenuEntry
    checks: string[]
    radios: AdvancedMenuSelection[]
    openParents: string[]
    activate: action
    hover: action
    keys: action
  inject
    uiWeights: FontWeights
    uiFont: string
  derive checked = entry.kind == "checkbox" ? checks.includes(entry.id) : advancedMenuRadio(entry, radios)
  view
    if entry.kind == "separator"
      view testId=(id + "-separator-" + entry.id) role="separator" height="ui.border-width" margin="ui.space-4 ui.space-negative-4" background-color="ui.border"
    else if entry.kind == "label"
      text entry.label testId=(id + "-label-" + entry.id) padding="ui.space-6 ui.space-8" font-size="ui.text-sm" font-weight=uiWeights.medium color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
    else if entry.kind == "checkbox" or entry.kind == "radio"
      button id=(id + "-item-" + entry.id) testId=(id + "-item-" + entry.id) class=Control press=activate hover=hover key=keys disabled=entry.disabled tabindex=-1
        aria-label=entry.label role=(entry.kind == "checkbox" ? "menuitemcheckbox" : "menuitemradio") aria-checked=checked
        display="flex" width="100%" box-sizing="border-box" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius=radius
        background-color=(openParents.includes(entry.id) ? "ui.muted" : "transparent") color=(entry.kind == "destructive" ? "ui.danger" : "ui.foreground")
        font-size="ui.text-sm" font-weight=uiWeights.regular cursor="default"
        :hover
          background-color="ui.muted"
        :focus-visible
          box-shadow="none"
          background-color="ui.muted"
        if entry.kind == "checkbox" or entry.kind == "radio"
          view width="ui.space-16" height="ui.space-16" flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
            if checked
              svg width=(entry.kind == "radio" ? "ui.space-8" : "ui.space-16") height=(entry.kind == "radio" ? "ui.space-8" : "ui.space-16") viewBox="0 0 24 24" fill=(entry.kind == "radio" ? "currentColor" : "none") stroke="currentColor" stroke-width="ui.stroke-standard"
                if entry.kind == "radio"
                  circle cx=12 cy=12 r=10
                else
                  path d="m5 12 4 4L19 6"
        text entry.label flex=1 min-width="0px" text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if entry.shortcut != ""
          text entry.shortcut font-size="ui.text-xs" letter-spacing="ui.tracking-wide" color="ui.muted-foreground" aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if entry.kind == "submenu"
          svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.muted-foreground" stroke-width="ui.stroke-standard" aria-hidden=true
            path d="m9 5 7 7-7 7"
    else if entry.kind == "submenu"
      button id=(id + "-item-" + entry.id) testId=(id + "-item-" + entry.id) class=Control press=activate hover=hover key=keys disabled=entry.disabled tabindex=-1
        aria-label=entry.label role="menuitem" aria-haspopup="menu" aria-expanded=openParents.includes(entry.id) aria-controls=(id + "-sub-" + entry.id)
        display="flex" width="100%" box-sizing="border-box" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius=radius
        background-color=(openParents.includes(entry.id) ? "ui.muted" : "transparent") color=(entry.kind == "destructive" ? "ui.danger" : "ui.foreground")
        font-size="ui.text-sm" font-weight=uiWeights.regular cursor="default"
        :hover
          background-color="ui.muted"
        :focus-visible
          box-shadow="none"
          background-color="ui.muted"
        if entry.kind == "checkbox" or entry.kind == "radio"
          view width="ui.space-16" height="ui.space-16" flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
            if checked
              svg width=(entry.kind == "radio" ? "ui.space-8" : "ui.space-16") height=(entry.kind == "radio" ? "ui.space-8" : "ui.space-16") viewBox="0 0 24 24" fill=(entry.kind == "radio" ? "currentColor" : "none") stroke="currentColor" stroke-width="ui.stroke-standard"
                if entry.kind == "radio"
                  circle cx=12 cy=12 r=10
                else
                  path d="m5 12 4 4L19 6"
        text entry.label flex=1 min-width="0px" text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if entry.shortcut != ""
          text entry.shortcut font-size="ui.text-xs" letter-spacing="ui.tracking-wide" color="ui.muted-foreground" aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if entry.kind == "submenu"
          svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.muted-foreground" stroke-width="ui.stroke-standard" aria-hidden=true
            path d="m9 5 7 7-7 7"
    else if entry.kind != "group"
      button id=(id + "-item-" + entry.id) testId=(id + "-item-" + entry.id) class=Control press=activate hover=hover key=keys disabled=entry.disabled tabindex=-1
        aria-label=entry.label role="menuitem"
        display="flex" width="100%" box-sizing="border-box" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius=radius
        background-color=(openParents.includes(entry.id) ? "ui.muted" : "transparent") color=(entry.kind == "destructive" ? "ui.danger" : "ui.foreground")
        font-size="ui.text-sm" font-weight=uiWeights.regular cursor="default"
        :hover
          background-color="ui.muted"
        :focus-visible
          box-shadow="none"
          background-color="ui.muted"
        if entry.kind == "checkbox" or entry.kind == "radio"
          view width="ui.space-16" height="ui.space-16" flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
            if checked
              svg width=(entry.kind == "radio" ? "ui.space-8" : "ui.space-16") height=(entry.kind == "radio" ? "ui.space-8" : "ui.space-16") viewBox="0 0 24 24" fill=(entry.kind == "radio" ? "currentColor" : "none") stroke="currentColor" stroke-width="ui.stroke-standard"
                if entry.kind == "radio"
                  circle cx=12 cy=12 r=10
                else
                  path d="m5 12 4 4L19 6"
        text entry.label flex=1 min-width="0px" text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if entry.shortcut != ""
          text entry.shortcut font-size="ui.text-xs" letter-spacing="ui.tracking-wide" color="ui.muted-foreground" aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if entry.kind == "submenu"
          svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.muted-foreground" stroke-width="ui.stroke-standard" aria-hidden=true
            path d="m9 5 7 7-7 7"

component AdvancedMenuPanel
  props
    id: string
    prefix: string
    label: string
    panel: string
    entries: AdvancedMenuEntry[]
    checks: string[]
    radios: AdvancedMenuSelection[]
    openParents: string[]
    reduced: bool
    activate: action
    hover: action
    keys: action
    panelKeys: action
    changed: action
  view
    column id=id testId=id popover="auto" toggle=changed key=panelKeys role="menu" aria-label=label tabindex=-1
      position-area=(panel == "" ? "bottom" : "right span-bottom") position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline"
      margin="ui.space-4" width="14rem" min-width="8rem" max-width="calc(100vw - ui.space-32)" max-height="min(28rem, 75vh)" overflow="auto" box-sizing="border-box"
      padding="ui.space-4" gap="0px" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-menu" background-color="ui.surface" color="ui.foreground"
      box-shadow=(panel == "" ? "ui.shadow-menu" : "ui.shadow-panel")
      animation=(reduced ? "none" : panel == "" ? "uiPopupIn ui.duration-fast ui.easing both" : "advancedSubmenuIn ui.duration-fast ui.easing both")
      -exact-exit-animation=(reduced ? "none" : "uiPopupOut ui.duration-fast ui.easing both")
      column role="none" align-items="stretch" gap="0px" min-width="0px"
        for entry in entries.filter(item => item.parent == panel) key=entry.id
          if entry.kind == "group"
            column role="group" aria-label=entry.label gap="0px" min-width="0px"
              for child in entries.filter(item => item.parent == entry.id) key=child.id
                AdvancedMenuLine(radius="ui.radius-item", id=prefix, entry=child, checks=checks, radios=radios, openParents=openParents, activate=activate(panel, child), hover=hover(panel, child), keys=keys(panel, child))
          else
            AdvancedMenuLine(radius="ui.radius-item", id=prefix, entry=entry, checks=checks, radios=radios, openParents=openParents, activate=activate(panel, entry), hover=hover(panel, entry), keys=keys(panel, entry))

component AdvancedMenuRoot
  props
    id: string
    label: string
    menus: AdvancedMenuGroup[]
    bar: bool
    contextual: bool
    checks: string[]
    radios: AdvancedMenuSelection[]
    reduced: bool
    choose: action
    check: action
    radio: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state active = 0
  state expanded = false
  state opening = 0
  state subSequence = 0
  state contextFocus = false
  state branch: AdvancedMenuBranch[] = []
  state openParents: string[] = []
  derive current = match menus.at(active) { case some(menu) => menu.entries, case none => [] }
  derive prefix = match menus.at(active) { case some(menu) => advancedMenuPrefix(id, bar, menu.id), case none => id }
  action openGroup(index: number, lastItem: bool)
    contextFocus = false
    match menus.at(index)
      case some(menu)
        let root = advancedMenuPrefix(id, bar, menu.id)
        active = index
        opening = opening + 1
        expanded = true
        branch = []
        openParents = []
        showPopover(root + "-menu", source=root)
        let enabled = advancedMenuRows(menu.entries, "")
        match enabled.at(lastItem ? enabled.length - 1 : 0)
          case some(entry)
            focus(root + "-item-" + entry.id)
          case none
            focus(root + "-menu")
      case none
        expanded = false
  action closeRoot
    expanded = false
    branch = []
    openParents = []
    focus(prefix)
  action toggle(index: number)
    if expanded and active == index
      closeRoot()
    else
      openGroup(index, false)
  action context(index: number)
    if contextual
      active = index
      opening = opening + 1
      expanded = true
      branch = []
      openParents = []
      contextFocus = true
  action rootChanged(index: number, epoch: number, e: ToggleEvent)
    if index == active and epoch == opening
      expanded = e.newState == "open"
      if e.newState == "closed"
        branch = []
        openParents = []
      else if contextFocus
        match first(advancedMenuRows(current, ""))
          case some(entry)
            focus(prefix + "-item-" + entry.id)
          case none
            focus(prefix + "-menu")
      contextFocus = false
  action subChanged(parent: string, epoch: number, e: ToggleEvent)
    if expanded and e.newState == "closed" and branch.filter(item => item.parent == parent and item.epoch == epoch).length > 0
      let index = openParents.indexOf(parent)
      branch = branch.slice(0, max(0, index))
      openParents = openParents.slice(0, max(0, index))
  action moveGroup(index: number, delta: number)
    let next = (index + delta + menus.length) % max(1, menus.length)
    if expanded
      openGroup(next, false)
    else
      active = next
      match menus.at(next)
        case some(menu)
          focus(advancedMenuPrefix(id, bar, menu.id))
        case none
          active = 0
  action hoverTrigger(index: number, inside: bool)
    if bar and expanded and inside and active != index
      openGroup(index, false)
  action triggerKeys(index: number, k: string, e: KeyboardEvent)
    if not e.isComposing
      if k == "Enter" or k == " "
        preventDefault()
        toggle(index)
      else if k == "ArrowDown" or k == "ArrowUp" or k == "ContextMenu" or (k == "F10" and e.shiftKey)
        preventDefault()
        openGroup(index, k == "ArrowUp")
      else if bar and (k == "ArrowRight" or k == "ArrowLeft" or k == "Home" or k == "End")
        preventDefault()
        let next = k == "Home" ? 0 : k == "End" ? menus.length - 1 : (index + (k == "ArrowRight" ? 1 : menus.length - 1)) % max(1, menus.length)
        moveGroup(index, next - index)
      else if k == "Escape" and expanded
        preventDefault()
        closeRoot()
  action openSub(panel: string, entry: AdvancedMenuEntry, keyboard: bool)
    if not entry.disabled and entry.kind == "submenu"
      let depth = panel == "" ? 0 : openParents.indexOf(panel) + 1
      let next = subSequence + 1
      subSequence = next
      branch = branch.slice(0, max(0, depth)).concat([AdvancedMenuBranch(parent=entry.id, epoch=next)])
      openParents = openParents.slice(0, max(0, depth)).concat([entry.id])
      showPopover(prefix + "-sub-" + entry.id, source=prefix + "-item-" + entry.id)
      if keyboard
        match first(advancedMenuRows(current, entry.id))
          case some(child)
            focus(prefix + "-item-" + child.id)
          case none
            focus(prefix + "-sub-" + entry.id)
  action closeSub(panel: string)
    let index = openParents.indexOf(panel)
    branch = branch.slice(0, max(0, index))
    openParents = openParents.slice(0, max(0, index))
    focus(prefix + "-item-" + panel)
  action activate(panel: string, entry: AdvancedMenuEntry)
    if advancedMenuFocusable(entry)
      if entry.kind == "submenu"
        openSub(panel, entry, true)
      else
        if entry.kind == "checkbox"
          check(entry.id, not checks.includes(entry.id))
        else if entry.kind == "radio"
          radio(entry.group, entry.value)
        else
          choose(entry.id)
        closeRoot()
  action hoverEntry(panel: string, entry: AdvancedMenuEntry, inside: bool)
    if inside and expanded and advancedMenuFocusable(entry)
      focus(prefix + "-item-" + entry.id)
      if entry.kind == "submenu"
        if not openParents.includes(entry.id)
          openSub(panel, entry, false)
      else
        let depth = panel == "" ? 0 : openParents.indexOf(panel) + 1
        branch = branch.slice(0, max(0, depth))
        openParents = openParents.slice(0, max(0, depth))
  action rowKeys(panel: string, entry: AdvancedMenuEntry, k: string, e: KeyboardEvent)
    stopPropagation()
    if not e.isComposing
      if k == "Enter" or k == " "
        preventDefault()
        activate(panel, entry)
      else if k == "ArrowRight" and entry.kind == "submenu"
        preventDefault()
        openSub(panel, entry, true)
      else if k == "ArrowLeft" and panel != ""
        preventDefault()
        closeSub(panel)
      else if bar and panel == "" and (k == "ArrowRight" or k == "ArrowLeft")
        preventDefault()
        moveGroup(active, k == "ArrowRight" ? 1 : -1)
      else if k == "Escape"
        preventDefault()
        if panel == ""
          closeRoot()
        else
          closeSub(panel)
      else if k == "Tab"
        closeRoot()
      else
        let enabled = advancedMenuRows(current, panel)
        let index = enabled.map(item => item.id).indexOf(entry.id)
        if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
          preventDefault()
          let next = k == "Home" ? 0 : k == "End" ? enabled.length - 1 : (index + (k == "ArrowDown" ? 1 : enabled.length - 1)) % max(1, enabled.length)
          match enabled.at(next)
            case some(target)
              focus(prefix + "-item-" + target.id)
            case none
              closeRoot()
        else if k.length == 1 and not e.ctrlKey and not e.metaKey and not e.altKey
          let ordered = enabled.slice(index + 1).concat(enabled.slice(0, index + 1))
          match first(ordered.filter(item => item.label.toLowerCase().startsWith(k.toLowerCase())))
            case some(target)
              preventDefault()
              focus(prefix + "-item-" + target.id)
            case none
              stopPropagation()
  action panelKeys(panel: string, k: string)
    if k == "Escape"
      preventDefault()
      if panel == ""
        closeRoot()
      else
        closeSub(panel)
    else if k == "Tab"
      closeRoot()
  view
    row id=(bar ? id : id + "-container") testId=(bar ? id : id + "-container") role=(bar ? "menubar" : "group") aria-label=label
      gap="ui.space-4" align-items="center" flex-wrap="wrap" padding=(bar ? "ui.space-4" : "0px") border-width=(bar ? "ui.border-width" : "0px") border-style=(bar ? "solid" : "solid") border-color=(bar ? "ui.border" : "transparent") border-radius="ui.radius-menu" background-color=(bar ? "ui.surface" : "transparent")
      for menu, index in menus key=menu.id
        column align-items="flex-start"
          button id=advancedMenuPrefix(id, bar, menu.id) testId=advancedMenuPrefix(id, bar, menu.id) class=Control role=(bar ? "menuitem" : "button")
            press=toggle(index) hover=hoverTrigger(index) contextmenu=context(index) key=triggerKeys(index) contextPopover=(contextual ? advancedMenuPrefix(id, bar, menu.id) + "-menu" : "") tabindex=(not bar or active == index ? 0 : -1)
            aria-haspopup="menu" aria-expanded=(expanded and active == index) aria-controls=(advancedMenuPrefix(id, bar, menu.id) + "-menu")
            padding=(contextual ? "ui.space-24 ui.space-32" : bar ? "ui.space-4 ui.space-8" : "ui.space-8 ui.space-16") min-height=(bar ? "ui.space-28" : "ui.space-36")
            border-width=(contextual ? "ui.border-width" : bar ? "0px" : "ui.border-width") border-style=(contextual ? "dashed" : bar ? "solid" : "solid") border-color=(contextual ? "ui.border" : bar ? "transparent" : "ui.border") border-radius=(bar ? "ui.radius-sm" : "ui.radius-control") background-color=(bar and expanded and active == index ? "ui.muted" : "ui.surface") color="ui.foreground" font-size="ui.text-sm" font-weight=(bar ? uiWeights.medium : uiWeights.medium)
            text menu.label font-family=uiFontFamily(uiFont) data-rightui-font="body"
          if expanded and active == index
            for epoch in [opening] key=epoch
              AdvancedMenuPanel(id=advancedMenuPrefix(id, bar, menu.id) + "-menu", prefix=advancedMenuPrefix(id, bar, menu.id), label=menu.label, panel="", entries=menu.entries, checks=checks, radios=radios, openParents=openParents, reduced=reduced, activate=activate, hover=hoverEntry, keys=rowKeys, panelKeys=panelKeys(""), changed=rootChanged(index, epoch))
              for opened in branch key=opened.epoch
                AdvancedMenuPanel(id=advancedMenuPrefix(id, bar, menu.id) + "-sub-" + opened.parent, prefix=advancedMenuPrefix(id, bar, menu.id), label=(match first(menu.entries.filter(entry => entry.id == opened.parent)) { case some(entry) => entry.label, case none => menu.label }), panel=opened.parent, entries=menu.entries, checks=checks, radios=radios, openParents=openParents, reduced=reduced, activate=activate, hover=hoverEntry, keys=rowKeys, panelKeys=panelKeys(opened.parent), changed=subChanged(opened.parent, opened.epoch))

component DropdownMenuAdvanced
  props
    id: string
    label: string
    entries: AdvancedMenuEntry[]
    checks: string[]
    radios: AdvancedMenuSelection[]
    reduced: bool
    choose: action
    check: action
    radio: action
  view
    AdvancedMenuRoot(id=id, label=label, menus=[AdvancedMenuGroup(id="root", label=label, entries=entries)], bar=false, contextual=false, checks=checks, radios=radios, reduced=reduced, choose=choose, check=check, radio=radio)

component ContextMenuAdvanced
  props
    id: string
    label: string
    entries: AdvancedMenuEntry[]
    checks: string[]
    radios: AdvancedMenuSelection[]
    reduced: bool
    choose: action
    check: action
    radio: action
  view
    AdvancedMenuRoot(id=id, label=label, menus=[AdvancedMenuGroup(id="root", label=label, entries=entries)], bar=false, contextual=true, checks=checks, radios=radios, reduced=reduced, choose=choose, check=check, radio=radio)

component MenubarAdvanced
  props
    id: string
    label: string
    menus: AdvancedMenuGroup[]
    checks: string[]
    radios: AdvancedMenuSelection[]
    reduced: bool
    choose: action
    check: action
    radio: action
  view
    AdvancedMenuRoot(id=id, label=label, menus=menus, bar=true, contextual=false, checks=checks, radios=radios, reduced=reduced, choose=choose, check=check, radio=radio)
