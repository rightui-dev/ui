use FontWeights from "./typography-context.contract"
use uiFontFamily, uiContentFontFamily from "./typography-context.contract"
component Typography
  props
    id: string
    variant: string
    content: string
  inject
    uiWeights: FontWeights
    uiFont: string
  view
    if variant == "blockquote"
      text content id=id testId=id font-family=uiFontFamily(uiFont) data-rightui-font="body" font-size="ui.text-base" font-style="italic" line-height="ui.leading-relaxed" border-left-width="ui.border-strong-width" border-left-style="solid" border-left-color="ui.border" padding-left="ui.space-24" color="ui.foreground"
    else
      text content id=id testId=id role=(variant == "h1" or variant == "h2" or variant == "h3" or variant == "h4" ? "heading" : "none")
        aria-level=(variant == "h1" ? 1 : variant == "h2" ? 2 : variant == "h3" ? 3 : 4)
        font-size=(variant == "h1" ? "ui.text-4xl" : variant == "h2" ? "ui.text-3xl" : variant == "h3" ? "ui.text-2xl" : variant == "h4" ? "ui.text-xl" : variant == "small" or variant == "muted" or variant == "code" ? "ui.text-sm" : variant == "lead" ? "ui.text-xl" : "ui.text-base")
        font-weight=(variant == "h1" ? uiWeights.heavy : variant == "h2" or variant == "h3" or variant == "h4" or variant == "large" or variant == "small" ? uiWeights.semibold : variant == "code" ? uiWeights.medium : uiWeights.regular)
        color=(variant == "muted" or variant == "lead" ? "ui.muted-foreground" : "ui.foreground")
        line-height=(variant == "p" ? "ui.leading-relaxed" : "ui.leading-compact") letter-spacing=(variant == "h1" or variant == "h2" ? "ui.tracking-heading" : "0px")
        font-family=uiContentFontFamily(uiFont, variant == "code") data-rightui-font=(variant == "code" ? "code" : "body") font-style="normal"
        background-color=(variant == "code" ? "ui.muted" : "transparent") border-radius=(variant == "code" ? "ui.radius-inline" : "0px")
