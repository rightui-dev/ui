use uiFontFamily from "./typography-context.contract"
use Control from "./styles.contract"
use ChartSeries, SeriesLegendOptions, SeriesValuesTooltipOptions, chartNiceStep, chartDisplayLabel, chartDisplayValue from "./chart-series.contract"
shape ChartPoint
  label: string
  desktop: number
  mobile: number
component Chart
  props
    id: string
    points: ChartPoint[]
  view
    ChartOptions(id=id, points=points, label="Desktop and mobile visitors. Use arrow keys to inspect values.", showLegend=true, stacked=false, showGrid=true, showAxis=true, showTooltip=true, showSeriesControl=true, showPointControls=true, showTotals=false, initialSeries="both", direction="ltr", initialIndex=-1, indicator="dot", hideLabel=false, hideIndicator=false, labelFormat="auto", tooltipTitle="", nameOverride="", valueFormat="decimal", valuePrefix="", valueSuffix="", showTotal=false, showCursor=true, icons=[], hideLegendIcon=false, legendAlign="bottom", desktopLabel="Desktop", mobileLabel="Mobile")

component ChartOptions
  props
    id: string
    points: ChartPoint[]
    label: string
    showLegend: bool
    stacked: bool
    showGrid: bool
    showAxis: bool
    showTooltip: bool
    showSeriesControl: bool
    showPointControls: bool
    showTotals: bool
    initialSeries: string
    direction: string
    initialIndex: number
    indicator: string
    hideLabel: bool
    hideIndicator: bool
    labelFormat: string
    tooltipTitle: string
    nameOverride: string
    valueFormat: string
    valuePrefix: string
    valueSuffix: string
    showTotal: bool
    showCursor: bool
    icons: string[]
    hideLegendIcon: bool
    legendAlign: string
    desktopLabel: string
    mobileLabel: string
  inject
    uiFont: string
  state hidden: string[] = initialSeries == "desktop" ? ["mobile"] : initialSeries == "mobile" ? ["desktop"] : []
  state active = initialIndex
  state pinned = false
  state width = 560
  derive current = min(active, points.length - 1)
  derive series = hidden.length == 0 ? "both" : hidden.includes("mobile") and not hidden.includes("desktop") ? "desktop" : hidden.includes("desktop") and not hidden.includes("mobile") ? "mobile" : "none"
  derive config = [ChartSeries(id="desktop", label=desktopLabel, color="ui.chart-1"), ChartSeries(id="mobile", label=mobileLabel, color="ui.chart-2")]
  derive peak = match first(sortBy(points, p => stacked ? (hidden.includes("desktop") ? 0 : max(0, p.desktop)) + (hidden.includes("mobile") ? 0 : max(0, p.mobile)) : max(hidden.includes("desktop") ? 0 : max(0, p.desktop), hidden.includes("mobile") ? 0 : max(0, p.mobile)), "desc")) { case some(p) => max(1, stacked ? (hidden.includes("desktop") ? 0 : max(0, p.desktop)) + (hidden.includes("mobile") ? 0 : max(0, p.mobile)) : max(hidden.includes("desktop") ? 0 : max(0, p.desktop), hidden.includes("mobile") ? 0 : max(0, p.mobile))), case none => 1 }
  derive domain = ceil(peak / chartNiceStep(peak / 4)) * chartNiceStep(peak / 4)
  derive rtl = direction == "rtl"
  derive spacing = 520 / max(1, points.length)
  action choose(v: string)
    hidden = v == "both" ? [] : v == "desktop" ? ["mobile"] : ["desktop"]
  action toggle(v: string)
    hidden = hidden.includes(v) ? hidden.filter(s => s != v) : hidden.concat([v])
  action measure(w: number, h: number)
    if w != width
      width = max(1, w)
  action inspect(i: number)
    active = i
    pinned = true
  action pointer(e: PointerEvent)
    let bounds = frame(id + "-plot")
    active = max(0, min(points.length - 1, floor(((rtl ? 1 - (e.clientX - bounds.x) / max(1, bounds.width) : (e.clientX - bounds.x) / max(1, bounds.width)) * 560 - 20) / 520 * points.length)))
  action press(e: PointerEvent)
    pinned = e.pointerType != "mouse"
    pointer(e)
    focus(id + "-plot")
  action hover(inside: bool)
    if not inside and not pinned
      active = -1
  action leaveFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        if not target.startsWith(id)
          active = -1
          pinned = false
      case none
        active = -1
        pinned = false
  action dismiss(k: string)
    if k == "Escape"
      keys(k)
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      stopPropagation()
      active = -1
      pinned = false
    else if points.length > 0 and (k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End" or k == "Enter" or k == " ")
      preventDefault()
      pinned = true
      active = k == "Home" ? 0 : k == "End" ? points.length - 1 : active < 0 ? ((k == "ArrowLeft" and not rtl) or (k == "ArrowRight" and rtl) ? points.length - 1 : 0) : k == "ArrowLeft" or k == "ArrowRight" ? max(0, min(points.length - 1, current + ((k == "ArrowLeft" and not rtl) or (k == "ArrowRight" and rtl) ? -1 : 1))) : current
  view
    column id=id testId=id gap="ui.space-16" min-width="0px" color="ui.foreground" direction=direction focusout=leaveFocus key=dismiss
      if showSeriesControl
        row gap="ui.space-8" flex-wrap="wrap" role="group" aria-label="Chart series"
          for name in ["both", "desktop", "mobile"] key=name
            button class=Control id=(id + "-" + name) testId=(id + "-" + name) press=choose(name) aria-pressed=series == name padding="ui.space-6 ui.space-12" min-height="ui.space-32" border-width="ui.border-width" border-style="solid" border-color="ui.border" background-color=(series == name ? "ui.muted" : "transparent") color="ui.foreground" text-transform="capitalize"
              text (name == "desktop" ? desktopLabel : name == "mobile" ? mobileLabel : name) font-family=uiFontFamily(uiFont) data-rightui-font="body"
              if showTotals and name != "both"
                text chartDisplayValue(sum(points.map(p => name == "desktop" ? p.desktop : p.mobile)), valueFormat) font-weight="ui.weight-semibold" font-variant-numeric="tabular-nums" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if showLegend and legendAlign == "top"
        SeriesLegendOptions(id=id, series=config, hidden=hidden, change=toggle, icons=icons, hideIcon=hideLegendIcon, verticalAlign="top")
      view id=(id + "-plot") testId=(id + "-plot") position="relative" min-width="0px" height=260 role="group" aria-label=label aria-describedby=(showTooltip and current >= 0 and hidden.length < 2 ? id + "-tooltip" : "") tabindex=0 key=keys pointermove=pointer pointerdown=press hover=hover resize=measure outline="none"
        :focus-visible
          box-shadow="ui.shadow-focus"
        svg viewBox="0 0 560 250" width="100%" height=250 aria-hidden=true preserveAspectRatio="none"
          if showGrid
            for tick in range(5) key=tick
              line x1=20 x2=540 y1=(20 + tick * 47.5) y2=(20 + tick * 47.5) stroke="ui.chart-grid" stroke-width="ui.stroke-thin" vector-effect="non-scaling-stroke"
          for point, i in points key=point.label
            if i == current and showCursor
              rect x=(20 + (rtl ? points.length - 1 - i : i) * spacing) y=20 width=spacing height=190 fill="ui.muted" opacity="ui.chart-opacity-soft"
            if not hidden.includes("desktop")
              rect x=(20 + (rtl ? points.length - 1 - i : i) * spacing + spacing * (stacked or series != "both" ? 0.15 : 0.12)) y=(210 - max(0, point.desktop) / domain * 190) width=(spacing * (stacked or series != "both" ? 0.7 : 0.34)) height=(max(0, point.desktop) / domain * 190) rx=3 fill="ui.chart-1" stroke=(showTooltip and i == current ? "ui.chart-1" : "transparent") stroke-width="ui.stroke-standard" vector-effect="non-scaling-stroke"
            if not hidden.includes("mobile")
              rect x=(20 + (rtl ? points.length - 1 - i : i) * spacing + spacing * (stacked or series != "both" ? 0.15 : 0.54)) y=(210 - (max(0, point.mobile) + (stacked and not hidden.includes("desktop") ? max(0, point.desktop) : 0)) / domain * 190) width=(spacing * (stacked or series != "both" ? 0.7 : 0.34)) height=(max(0, point.mobile) / domain * 190) rx=3 fill="ui.chart-2" stroke=(showTooltip and i == current ? "ui.chart-2" : "transparent") stroke-width="ui.stroke-standard" vector-effect="non-scaling-stroke"
        if showAxis
          for point, i in points key=point.label
            if i % max(1, ceil(points.length / max(1, floor(width / 56)))) == 0
              text chartDisplayLabel(point.label, "axis") position="absolute" top=230 left=(max(16, min(max(16, width - 16), (20 + ((rtl ? points.length - 1 - i : i) + 0.5) * spacing) / 560 * width))) max-width="100%" translate="-50% 0px" font-size="ui.text-xs" line-height="ui.leading-heading" color="ui.muted-foreground" white-space="nowrap" overflow="hidden" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if showTooltip and current >= 0
          for point, i in points key=point.label
            if i == current
              SeriesValuesTooltipOptions(id=id, title=(tooltipTitle == "" ? point.label : tooltipTitle), series=config, values=[point.desktop, point.mobile], hidden=hidden, indicator=indicator, hideLabel=hideLabel, hideIndicator=hideIndicator, labelFormat=labelFormat, nameOverride=nameOverride, valueFormat=valueFormat, valuePrefix=valuePrefix, valueSuffix=valueSuffix, formattedValues=[], icons=icons, showTotal=showTotal, totalLabel="Total", plotWidth=width, anchor=((20 + ((rtl ? points.length - 1 - i : i) + 0.5) * spacing) / 560 * width))
        if points.length == 0 or hidden.length == 2
          text (points.length == 0 ? "No chart data." : "All series are hidden. Use the legend to show a series.") testId=(id + "-empty") position="absolute" inset=0 display="flex" align-items="center" justify-content="center" text-align="center" padding="ui.space-12" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if showLegend and legendAlign != "top"
        SeriesLegendOptions(id=id, series=config, hidden=hidden, change=toggle, icons=icons, hideIcon=hideLegendIcon, verticalAlign="bottom")
      if showPointControls
        row gap="ui.space-8" flex-wrap="wrap" aria-label="Explore monthly values"
          for point, i in points key=point.label
            button class=Control id=(id + "-point-" + i.toString()) testId=(id + "-point-" + i.toString()) press=inspect(i) aria-pressed=current == i padding="ui.space-4 ui.space-8" min-height="ui.space-28" background-color=(current == i ? "ui.muted" : "transparent") border="0" color="ui.muted-foreground" font-size="ui.text-xs"
              text chartDisplayLabel(point.label, "axis") font-family=uiFontFamily(uiFont) data-rightui-font="body"

fn naturalPower(k: number): number = k > 44 ? 0 : k == 0 ? 1 : k == 1 ? 0.26794919243112281 : k == 2 ? 0.07179676972449088 : k == 3 ? 0.019237886466840617 : k == 4 ? 0.0051547761428715703 : k == 5 ? 0.0013812181046456555 : k == 6 ? 0.00037009627571104941 : k == 7 ? 9.9166998198541869e-05 : k == 8 ? 2.6571717083117901e-05 : k == 9 ? 7.119870133929712e-06 : k == 10 ? 1.9077634526009366e-06 : k == 11 ? 5.1118367647403156e-07 : k == 12 ? 1.3697125329518911e-07 : k == 13 ? 3.6701336706724693e-08 : k == 14 ? 9.8340935317096054e-09 : k == 15 ? 2.6350374201137172e-09 : k == 16 ? 7.0605614874525981e-10 : k == 17 ? 1.8918717486732108e-10 : k == 18 ? 5.0692550724024295e-11 : k == 19 ? 1.358302802877604e-11 : k == 20 ? 3.6395613910798461e-12 : k == 21 ? 9.7521753554333854e-13 : k == 22 ? 2.6130875109350738e-13 : k == 23 ? 7.0017468830690579e-14 : k == 24 ? 1.8761124229254853e-14 : k == 25 ? 5.0270280863288097e-15 : k == 26 ? 1.3469881160603771e-15 : k == 27 ? 3.6092437791269757e-16 : k == 28 ? 9.6709395590412697e-17 : k == 29 ? 2.591320444895307e-17 : k == 30 ? 6.9434222053995546e-18 : k == 31 ? 1.8604843726451361e-18 : k == 32 ? 4.9851528518098844e-19 : k == 33 ? 1.3357676807881673e-19 : k == 34 ? 3.5791787134278322e-20 : k == 35 ? 9.5903804582965288e-21 : k == 36 ? 2.5697346989077761e-21 : k == 37 ? 6.8855833733457311e-22 : k == 38 ? 1.8449865043051551e-22 : k == 39 ? 4.9436264387488662e-23 : k == 40 ? 1.3246407119439064e-23 : k == 41 ? 3.5493640902675723e-24 : k == 42 ? 9.5104924163122292e-25 : k == 43 ? 2.5483287625731797e-25 : k == 44 ? 6.8282263398048592e-26 : 0
fn naturalValue(values: number[], i: number): number = match values.at(i) { case some(v) => v, case none => 0 }
fn naturalInverse(i: number, j: number, n: number): number = ((i + j) % 2 == 0 ? 1 : -1) * naturalPower(max(i - j, j - i) + 1) * (1 - naturalPower(2 * min(i, j))) * (1 - naturalPower(2 * (n - max(i, j) + 1))) / ((1 - 0.07179676972449088) * (1 - naturalPower(2 * (n + 1))))
fn naturalTerm(values: number[], i: number, j: number): number = naturalInverse(i, j, values.length - 2) * 6 * (naturalValue(values, j + 1) - 2 * naturalValue(values, j) + naturalValue(values, j - 1))
fn naturalSecond(values: number[], i: number): number = i == 0 or i == values.length - 1 ? 0 : sum(range(min(values.length - 2, i + 20) - max(1, i - 20) + 1).map(k => naturalTerm(values, i, max(1, i - 20) + k)))
fn naturalValues(points: ChartPoint[], peak: number, mobile: bool): number[] = points.map(p => 215 - max(0, mobile ? p.mobile : p.desktop + p.mobile) / peak * 210)
fn naturalSeconds(values: number[]): number[] = values.map((v, i) => naturalSecond(values, i))
fn naturalX(i: number, count: number): number = 20 + i * 520 / max(1, count - 1)
fn naturalSegment(values: number[], second: number[], i: number): string = " C " + (naturalX(i, values.length) + 520 / max(1, values.length - 1) / 3).toFixed(3) + "," + (naturalValue(values, i) + (naturalValue(values, i + 1) - naturalValue(values, i) - (2 * naturalValue(second, i) + naturalValue(second, i + 1)) / 6) / 3).toFixed(3) + " " + (naturalX(i + 1, values.length) - 520 / max(1, values.length - 1) / 3).toFixed(3) + "," + (naturalValue(values, i + 1) - (naturalValue(values, i + 1) - naturalValue(values, i) + (naturalValue(second, i) + 2 * naturalValue(second, i + 1)) / 6) / 3).toFixed(3) + " " + naturalX(i + 1, values.length).toFixed(3) + "," + naturalValue(values, i + 1).toFixed(3)
fn naturalReverseSegment(values: number[], second: number[], i: number): string = " C " + (naturalX(i, values.length) - 520 / max(1, values.length - 1) / 3).toFixed(3) + "," + (naturalValue(values, i) - (naturalValue(values, i) - naturalValue(values, i - 1) + (naturalValue(second, i - 1) + 2 * naturalValue(second, i)) / 6) / 3).toFixed(3) + " " + (naturalX(i - 1, values.length) + 520 / max(1, values.length - 1) / 3).toFixed(3) + "," + (naturalValue(values, i - 1) + (naturalValue(values, i) - naturalValue(values, i - 1) - (2 * naturalValue(second, i - 1) + naturalValue(second, i)) / 6) / 3).toFixed(3) + " " + naturalX(i - 1, values.length).toFixed(3) + "," + naturalValue(values, i - 1).toFixed(3)
fn naturalPath(values: number[], second: number[]): string = values.length == 0 ? "" : "M 20," + naturalValue(values, 0).toFixed(3) + range(max(0, values.length - 1)).map(i => naturalSegment(values, second, i)).join("")

fn naturalReturn(values: number[], second: number[]): string = range(max(0, values.length - 1)).map(i => naturalReverseSegment(values, second, values.length - 1 - i)).join("")

fn chartDateLabel(label: string): string = chartDisplayLabel(label, "axis")


shape ChartDateMetric
  label: string
  width: number
shape ChartAxisTick
  index: number
  label: string
  coordinate: number
  size: number
  tickCoord: number
shape ChartTickScan
  candidates: ChartAxisTick[]
  remaining: number
  start: number
  end: number
  selected: ChartAxisTick[]
fn chartMeasuredWidth(metrics: ChartDateMetric[], index: number, label: string): number = match metrics.at(index) { case some(m) => (m.label == label ? m.width : 0), case none => 0 }
fn chartAlignedMetrics(points: ChartPoint[], metrics: ChartDateMetric[]): ChartDateMetric[] = points.map((p, i) => ChartDateMetric(label=p.label, width=chartMeasuredWidth(metrics, i, p.label)))
fn chartCandidates(points: ChartPoint[], metrics: ChartDateMetric[], width: number): ChartAxisTick[] = points.map((p, i) => ChartAxisTick(index=i, label=p.label, coordinate=(points.length == 1 ? width / 2 : 5 + i * max(1, width - 10) / max(1, points.length - 1)), size=chartMeasuredWidth(metrics, i, p.label), tickCoord=0))
fn chartAcceptEnd(scan: ChartTickScan, tick: ChartAxisTick): ChartTickScan = tick.tickCoord >= scan.start and tick.tickCoord <= scan.end and tick.tickCoord - tick.size / 2 >= scan.start and tick.tickCoord + tick.size / 2 <= scan.end ? ChartTickScan(scan, remaining=tick.index - 1, end=tick.tickCoord - tick.size / 2 - 32, selected=scan.selected.concat([tick])) : ChartTickScan(scan, remaining=scan.remaining - 1)
fn chartAdjustEnd(scan: ChartTickScan, tick: ChartAxisTick): ChartTickScan = chartAcceptEnd(scan, ChartAxisTick(tick, tickCoord=(scan.remaining == scan.candidates.length - 1 ? min(tick.coordinate, scan.end - tick.size / 2) : tick.coordinate)))
fn chartInitialEnd(scan: ChartTickScan): ChartTickScan = match scan.candidates.at(scan.remaining) { case some(t) => chartAdjustEnd(scan, t), case none => ChartTickScan(scan, remaining=-1) }
fn chartMatchesEnd(scan: ChartTickScan): ChartAxisTick[] = scan.candidates.filter(t => t.index <= scan.remaining and t.coordinate >= scan.start and t.coordinate <= scan.end and t.coordinate - t.size / 2 >= scan.start and t.coordinate + t.size / 2 <= scan.end)
fn chartLastEnd(scan: ChartTickScan, matches: ChartAxisTick[]): ChartTickScan = match matches.at(matches.length - 1) { case some(t) => chartAcceptEnd(scan, ChartAxisTick(t, tickCoord=t.coordinate)), case none => ChartTickScan(scan, remaining=-1) }
fn chartScan1(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartLastEnd(scan, chartMatchesEnd(scan))
fn chartScan2(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan1(chartScan1(scan))
fn chartScan4(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan2(chartScan2(scan))
fn chartScan8(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan4(chartScan4(scan))
fn chartScan16(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan8(chartScan8(scan))
fn chartScan32(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan16(chartScan16(scan))
fn chartScan64(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan32(chartScan32(scan))
fn chartScan128(scan: ChartTickScan): ChartTickScan = scan.remaining < 0 ? scan : chartScan64(chartScan64(scan))
fn chartEndTicks(candidates: ChartAxisTick[], width: number): ChartTickScan = chartScan128(chartInitialEnd(ChartTickScan(candidates=candidates, remaining=candidates.length - 1, start=0, end=width, selected=[])))

component AreaChart
  props
    id: string
    points: ChartPoint[]
  view
    AreaChartOptions(id=id, points=points, label="Daily desktop and mobile visitors. Use arrow keys to explore.", showLegend=true, initialIndex=-1, indicator="dot", hideLabel=false, hideIndicator=false, labelFormat="auto", tooltipTitle="", nameOverride="", valueFormat="decimal", valuePrefix="", valueSuffix="", showTotal=false, showCursor=true, icons=[], hideLegendIcon=false, legendAlign="bottom")

component AreaChartOptions
  props
    id: string
    points: ChartPoint[]
    label: string
    showLegend: bool
    initialIndex: number
    indicator: string
    hideLabel: bool
    hideIndicator: bool
    labelFormat: string
    tooltipTitle: string
    nameOverride: string
    valueFormat: string
    valuePrefix: string
    valueSuffix: string
    showTotal: bool
    showCursor: bool
    icons: string[]
    hideLegendIcon: bool
    legendAlign: string
  inject
    uiFont: string
  state active = initialIndex
  state pinned = false
  state hidden: string[] = []
  state width = 560
  state dateMetrics: ChartDateMetric[] = points.map(p => ChartDateMetric(label=p.label, width=0))
  state tickHeight = 16
  derive config = [ChartSeries(id="desktop", label="Desktop", color="ui.chart-1"), ChartSeries(id="mobile", label="Mobile", color="ui.chart-2")]
  derive visiblePoints = points.map(p => ChartPoint(p, desktop=(hidden.includes("desktop") ? 0 : p.desktop), mobile=(hidden.includes("mobile") ? 0 : p.mobile)))
  derive current = min(active, points.length - 1)
  derive metricsReady = points.filter((p, i) => chartMeasuredWidth(dateMetrics, i, p.label) > 0).length == points.length
  derive candidates = chartCandidates(points, dateMetrics, width)
  derive tickScan = metricsReady ? chartEndTicks(candidates, width) : ChartTickScan(candidates=[], remaining=-1, start=0, end=width, selected=[])
  derive scanComplete = chartMatchesEnd(tickScan).length == 0
  derive axisTicks = metricsReady and scanComplete ? sortBy(tickScan.selected, t => t.index) : []
  derive peak = match first(sortBy(visiblePoints, p => p.desktop + p.mobile, "desc")) { case some(p) => max(1, p.desktop + p.mobile), case none => 1 }
  derive tickStep = chartNiceStep(peak / 4)
  derive domain = ceil(peak / tickStep) * tickStep
  derive mobileY = naturalValues(visiblePoints, domain, true)
  derive totalY = naturalValues(visiblePoints, domain, false)
  derive mobileSecond = naturalSeconds(mobileY)
  derive totalSecond = naturalSeconds(totalY)
  derive mobilePath = naturalPath(mobileY, mobileSecond)
  derive totalPath = naturalPath(totalY, totalSecond)
  derive mobileReturn = naturalReturn(mobileY, mobileSecond)
  derive desktopArea = totalPath + " L " + naturalX(points.length - 1, points.length).toFixed(3) + "," + naturalValue(mobileY, mobileY.length - 1).toFixed(3) + mobileReturn + " Z"
  action measure(w: number, h: number)
    if w != width
      width = max(1, w)
  action measureTick(index: number, label: string, w: number, h: number)
    match points.at(index)
      case some(point)
        if point.label == label and w > 0 and chartMeasuredWidth(dateMetrics, index, label) != w
          let aligned = chartAlignedMetrics(points, dateMetrics)
          dateMetrics = aligned.map((m, i) => i == index ? ChartDateMetric(label=label, width=w) : m)
      case none
        active = active
    if h > 0 and h != tickHeight
      tickHeight = h
  action toggle(v: string)
    hidden = hidden.includes(v) ? hidden.filter(s => s != v) : hidden.concat([v])
  action press(e: PointerEvent)
    pinned = e.pointerType != "mouse"
    inspect(e)
    focus(id)
  action leaveFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        if not target.startsWith(id)
          active = -1
          pinned = false
      case none
        active = -1
        pinned = false
  action hover(inside: bool)
    if not inside and not pinned
      active = -1
  action inspect(e: PointerEvent)
    let bounds = frame(id)
    let next = max(0, min(points.length - 1, round((e.clientX - bounds.x - 5) / max(1, bounds.width - 10) * (points.length - 1))))
    if next != active
      active = next
  action dismiss(k: string)
    if k == "Escape"
      keys(k)
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      stopPropagation()
      active = -1
      pinned = false
    else if points.length > 0 and (k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End" or k == "Enter" or k == " ")
      preventDefault()
      pinned = true
      active = k == "Home" ? 0 : k == "End" ? points.length - 1 : active < 0 ? (k == "ArrowLeft" ? points.length - 1 : 0) : k == "ArrowLeft" ? max(0, current - 1) : k == "ArrowRight" ? min(points.length - 1, current + 1) : current
  view
    column gap="ui.space-12" min-width="0px" color="ui.foreground" focusout=leaveFocus key=dismiss
      if showLegend and legendAlign == "top"
        SeriesLegendOptions(id=id, series=config, hidden=hidden, change=toggle, icons=icons, hideIcon=hideLegendIcon, verticalAlign="top")
      view id=id testId=id role="group" aria-label=label aria-describedby=(current >= 0 and hidden.length < 2 ? id + "-tooltip" : "") tabindex=0 key=keys pointermove=inspect pointerdown=press hover=hover resize=measure position="relative" min-width="0px" height=(max(250, 228 + tickHeight))
        :focus-visible
          box-shadow="ui.shadow-focus"
        svg position="absolute" left=5 top="0px" viewBox="20 0 520 250" width="calc(100% - 10px)" height=250 preserveAspectRatio="none" aria-hidden=true
          defs
            linearGradient id=(id + "-desktop-fill") x1="0" y1="0" x2="0" y2="1"
              stop offset="5%" stop-color="ui.chart-1-gradient-start"
              stop offset="95%" stop-color="ui.chart-1-gradient-end"
            linearGradient id=(id + "-mobile-fill") x1="0" y1="0" x2="0" y2="1"
              stop offset="5%" stop-color="ui.chart-2-gradient-start"
              stop offset="95%" stop-color="ui.chart-2-gradient-end"
          for tick in range(5) key=tick
            line x1=20 x2=540 y1=(5 + tick * 52.5) y2=(5 + tick * 52.5) stroke="ui.chart-grid" stroke-width="ui.stroke-thin" vector-effect="non-scaling-stroke"
          if points.length > 0
            if not hidden.includes("desktop")
              path d=desktopArea fill=("url(#" + id + "-desktop-fill)")
              path d=totalPath fill="none" stroke="ui.chart-1" stroke-width="ui.stroke-thin" vector-effect="non-scaling-stroke"
            if not hidden.includes("mobile")
              path d=(mobilePath + " L " + naturalX(points.length - 1, points.length).toFixed(3) + ",215 L 20,215 Z") fill=("url(#" + id + "-mobile-fill)")
              path d=mobilePath fill="none" stroke="ui.chart-2" stroke-width="ui.stroke-thin" vector-effect="non-scaling-stroke"
          if current >= 0 and hidden.length < 2
            if showCursor
              line x1=naturalX(current, points.length) x2=naturalX(current, points.length) y1=5 y2=215 stroke="ui.chart-grid" stroke-width="ui.stroke-standard" vector-effect="non-scaling-stroke"
        if current >= 0
          for item, layer in config key=item.id
            if not hidden.includes(item.id)
              view position="absolute" left=(5 + current * max(1, width - 10) / max(1, points.length - 1)) top=(layer == 0 ? naturalValue(totalY, current) : naturalValue(mobileY, current)) width="ui.space-8" height="ui.space-8" border-radius="ui.radius-full" border-width="ui.border-strong-width" border-style="solid" border-color="ui.surface" box-sizing="border-box" background-color=item.color translate="-50% -50%" pointer-events="none" aria-hidden=true
        for metricSet in [points.map(p => p.label).join("|")] key=metricSet
          view position="absolute" inset=0 overflow="clip" opacity=0 aria-hidden=true pointer-events="none"
            for p, i in points key=p.label
              text chartDateLabel(p.label) id=(id + "-tick-probe-" + p.label) position="absolute" left="0px" top="0px" resize=measureTick(i, p.label) aria-hidden=true pointer-events="none" font-family=uiFontFamily(uiFont) data-rightui-font="body" font-size="ui.text-xs" line-height="ui.leading-heading" white-space="nowrap"
        for tick in axisTicks key=tick.label
          text chartDateLabel(tick.label) position="absolute" top=228 left=tick.tickCoord translate="-50% 0px" pointer-events="none" font-family=uiFontFamily(uiFont) data-rightui-font="body" font-size="ui.text-xs" line-height="ui.leading-heading" color="ui.muted-foreground" white-space="nowrap"
        if metricsReady and not scanComplete
          text "Axis labels exceed 129 visible dates." position="absolute" top=228 left="0px" font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if current >= 0
          for p, i in points key=p.label
            if i == current
              SeriesValuesTooltipOptions(id=id, title=(tooltipTitle == "" ? p.label : tooltipTitle), series=config, values=[p.desktop, p.mobile], hidden=hidden, indicator=indicator, hideLabel=hideLabel, hideIndicator=hideIndicator, labelFormat=labelFormat, nameOverride=nameOverride, valueFormat=valueFormat, valuePrefix=valuePrefix, valueSuffix=valueSuffix, formattedValues=[], icons=icons, showTotal=showTotal, totalLabel="Total", plotWidth=width, anchor=(5 + i * max(1, width - 10) / max(1, points.length - 1)))
        if points.length == 0 or hidden.length == 2
          text (points.length == 0 ? "No chart data." : "All series are hidden. Use the legend to show a series.") testId=(id + "-empty") position="absolute" inset=0 display="flex" align-items="center" justify-content="center" text-align="center" padding="ui.space-12" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if showLegend and legendAlign != "top"
        SeriesLegendOptions(id=id, series=config, hidden=hidden, change=toggle, icons=icons, hideIcon=hideLegendIcon, verticalAlign="bottom")
