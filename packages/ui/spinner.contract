use uiFontFamily from "./typography-context.contract"
keyframes uiSpin
  from rotate="0deg"
  to rotate="360deg"
component Spinner
  props
    id: string
    label: string
    reduced: bool
  inject
    uiFont: string
  view
    row id=id testId=id role="status" aria-label=label align-items="center" gap="ui.space-8"
      svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.stroke-standard" aria-hidden=true
        animation=(reduced ? "none" : "uiSpin ui.duration-spin ui.easing-linear infinite")
        circle cx=12 cy=12 r=9 opacity="ui.opacity-faint"
        path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"
      text label font-size="ui.text-caption" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
