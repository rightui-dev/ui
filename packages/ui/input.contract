use Field from "./styles.contract"
component Input
  props
    id: string
    label: string
    value: string
    placeholder: string
    error: string
    disabled: bool
    edit: action
  view
    column gap=8 min-width=0
      text label id=(id + "-label") font-size="0.875rem" font-weight=500 color="ui.foreground"
      input id=id testId=id class=Field value=value input=edit placeholder=placeholder disabled=disabled
        aria-labelledby=(id + "-label") aria-invalid=(error != "") aria-describedby=(id + "-hint")
        border-color=(error == "" ? "ui.border" : "ui.danger")
        ::placeholder
          color="ui.muted-foreground"
      text error id=(id + "-hint") font-size="0.75rem" color="ui.danger" display=(error == "" ? "none" : "block")
