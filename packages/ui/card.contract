component Card
  props
    id: string
    title: string
    description: string
  slot
  view
    column testId=id background-color="ui.surface" border="1px solid ui.border"
      box-shadow="0 1px 3px 0 ui.shadow" border-radius="ui.panel-radius" padding=24 gap=24 min-width=0 box-sizing="border-box"
      column gap=8
        text title font-size="1.0rem" font-weight=600 color="ui.foreground" role="heading" aria-level=2
        text description font-size="0.875rem" color="ui.muted-foreground" line-height=1.5
      children
