use Control from "./styles.contract"

shape CarouselSlideData
  id: string
  title: string
  description: string
  src: string

component CarouselItemAdvanced
  props
    id: string
    label: string
    index: number
    value: number
    count: number
    orientation: string
    height: number
    reduced: bool
  slot
  view
    column id=id testId=(index == value ? id : "") role="group" aria-description="Slide" aria-label=(label + ", " + (index + 1).toString() + " of " + count.toString())
      aria-hidden=(index != value) inert=(index != value) pointer-events=(index == value ? "auto" : "none")
      grid-column="1" grid-row="1" width="100%" min-width=0 height=height min-height=0 box-sizing="border-box"
      translate=(orientation == "vertical" ? "0px " + ((index - value) * 100).toString() + "%" : ((index - value) * 100).toString() + "% 0px")
      transition=(reduced ? "none" : "translate 220ms cubic-bezier(0.22, 1, 0.36, 1)")
      children

component CarouselFrameAdvanced
  props
    id: string
    label: string
    value: number
    count: number
    orientation: string
    height: number
    loop: bool
    reduced: bool
    change: action
  slot
  state extent = 1
  state distance = 0
  state crossDistance = 0
  state dragging = false
  derive vertical = orientation == "vertical"
  derive current = max(0, min(count - 1, value))
  action move(delta: number)
    if count > 0
      change(loop ? (current + delta + count) % count : max(0, min(count - 1, current + delta)))
  action keys(k: string, e: KeyboardEvent)
    if not e.isComposing and not e.ctrlKey and not e.metaKey and not e.altKey
      if k == "ArrowLeft" or k == "ArrowRight" or (vertical and (k == "ArrowUp" or k == "ArrowDown"))
        preventDefault()
        move(k == "ArrowLeft" or k == "ArrowUp" ? -1 : 1)
      else if k == "Home" or k == "End"
        preventDefault()
        if count > 0
          change(k == "Home" ? 0 : count - 1)
  action begin(e: PointerEvent)
    if e.button == 0
      let box = frame(id + "-viewport")
      extent = max(1, vertical ? box.height : box.width)
      distance = 0
      crossDistance = 0
      dragging = false
  action dragPan(dx: number, dy: number)
    let delta = distance + (vertical ? dy : dx)
    let cross = crossDistance + (vertical ? dx : dy)
    distance = max(-extent, min(extent, delta))
    crossDistance = cross
    dragging = true
  action releasePan(vx: number, vy: number)
    let velocity = vertical ? vy : vx
    let traveled = max(distance, -distance)
    let cross = max(crossDistance, -crossDistance)
    if traveled > cross and (traveled > 40 or max(velocity, -velocity) > 0.35)
      move(distance < 0 ? 1 : -1)
    distance = 0
    crossDistance = 0
    dragging = false
  view
    column id=id testId=id role="region" aria-label=label aria-description="Carousel" tabindex=0 key=keys min-width=0 gap=12
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      column position="relative" min-width=0 padding=(vertical ? "48px 0px" : "0px 48px") box-sizing="border-box"
        view id=(id + "-viewport") testId=(id + "-viewport") height=height min-height=0 min-width=0 overflow="hidden" touch-action=(vertical ? "pan-x" : "pan-y") pointerdown=begin pan=dragPan panrelease=releasePan
          if count == 0
            text "No slides." role="status" padding=24 color="ui.muted-foreground" font-size="0.875rem"
          view id=(id + "-track") display="grid" grid-template-columns="minmax(0, 1fr)" width="100%" height=height min-width=0 min-height=0
            translate=(vertical ? "0px " + distance.toString() + "px" : distance.toString() + "px 0px")
            transition=(reduced or dragging ? "none" : "translate 220ms cubic-bezier(0.22, 1, 0.36, 1)")
            children
        button id=(id + "-previous") testId=(id + "-previous") class=Control press=move(-1) disabled=(count == 0 or (not loop and current == 0)) aria-label="Previous slide"
          position="absolute" left=(vertical ? "50%" : "0px") top=(vertical ? "0px" : "50%") translate=(vertical ? "-50% 0px" : "0px -50%")
          width=32 height=32 min-height=32 padding=0 border="1px solid ui.input" border-radius="ui.radius-full" background-color="ui.outline" color="ui.foreground" display="flex" align-items="center" justify-content="center"
          box-shadow="0 1px 2px 0 ui.shadow"
          :hover
            background-color="ui.outline-hover"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 rotate=(vertical ? "90deg" : "0deg") aria-hidden=true
            path d="M19 12H5m7-7-7 7 7 7"
        button id=(id + "-next") testId=(id + "-next") class=Control press=move(1) disabled=(count == 0 or (not loop and current >= count - 1)) aria-label="Next slide"
          position="absolute" right=(vertical ? "auto" : "0px") bottom=(vertical ? "0px" : "auto") left=(vertical ? "50%" : "auto") top=(vertical ? "auto" : "50%") translate=(vertical ? "-50% 0px" : "0px -50%")
          width=32 height=32 min-height=32 padding=0 border="1px solid ui.input" border-radius="ui.radius-full" background-color="ui.outline" color="ui.foreground" display="flex" align-items="center" justify-content="center"
          box-shadow="0 1px 2px 0 ui.shadow"
          :hover
            background-color="ui.outline-hover"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 rotate=(vertical ? "90deg" : "0deg") aria-hidden=true
            path d="M5 12h14m-7-7 7 7-7 7"
      text (count == 0 ? "0 slides" : "Slide " + (current + 1).toString() + " of " + count.toString()) testId=(id + "-position") aria-live="polite" font-size="0.875rem" color="ui.muted-foreground" text-align="center"

component CarouselImageAdvanced
  props
    id: string
    src: string
    alt: string
    ratio: number
  state failedSource = ""
  action imageFailed(source: string, message: string)
    failedSource = source
  view
    view id=id testId=id aspect-ratio=max(0.1, ratio) width="100%" min-width=0 position="relative" overflow="hidden" border-radius="ui.radius-control" background-color="ui.muted"
      if src != "" and failedSource != src
        image src alt=alt width="100%" height="100%" position="absolute" inset=0 object-fit="cover" pointer-events="none" user-select="none" error=imageFailed(src)
      else
        text alt padding=16 font-size="0.875rem" color="ui.muted-foreground"

component CarouselAdvanced
  props
    id: string
    label: string
    slides: CarouselSlideData[]
    value: number
    orientation: string
    height: number
    imageRatio: number
    loop: bool
    reduced: bool
    change: action
  derive current = max(0, min(slides.length - 1, value))
  view
    CarouselFrameAdvanced(id=id, label=label, value=current, count=slides.length, orientation=orientation, height=height, loop=loop, reduced=reduced, change=change)
      for slide, i in slides key=slide.id
        CarouselItemAdvanced(id=id + "-slide-" + slide.id, label=slide.title, index=i, value=current, count=slides.length, orientation=orientation, height=height, reduced=reduced)
          column height="100%" box-sizing="border-box" min-width=0 min-height=0 padding=16 gap=12 border="1px solid ui.border" border-radius="ui.radius-panel" background-color="ui.surface" justify-content=(slide.src == "" ? "center" : "flex-start")
            if slide.src != ""
              CarouselImageAdvanced(id=id + "-image-" + slide.id, src=slide.src, alt=slide.title, ratio=imageRatio)
            text slide.title role="heading" aria-level=3 font-size="1.125rem" font-weight=600 color="ui.foreground"
            text slide.description font-size="0.875rem" line-height=1.5 color="ui.muted-foreground"

component ScrollAreaAdvanced
  props
    id: string
    label: string
    height: number
    contentWidth: number
    direction: string
    type: string
    reduced: bool
    observeScroll: action
  slot
  state x = 0
  state y = 0
  state portWidth = 0
  state portHeight = height
  state contentHeight = height
  state measuredWidth = 0
  state hovered = false
  state focused = false
  state pointer = -1
  state axis = ""
  state start = 0
  state origin = 0
  derive maxY = max(0, contentHeight - portHeight)
  derive maxX = max(0, measuredWidth - portWidth)
  derive vertical = direction != "horizontal" and (maxY > 1 or type == "always")
  derive horizontal = direction != "vertical" and (maxX > 1 or type == "always")
  derive trackHeight = max(1, portHeight - (horizontal ? 10 : 0))
  derive trackWidth = max(1, portWidth - (vertical ? 10 : 0))
  derive thumbHeight = max(18, min(trackHeight, trackHeight * portHeight / max(1, contentHeight)))
  derive thumbWidth = max(18, min(trackWidth, trackWidth * portWidth / max(1, measuredWidth)))
  derive thumbY = maxY > 0 ? max(0, min(maxY, y)) / maxY * max(0, trackHeight - thumbHeight) : 0
  derive thumbX = maxX > 0 ? max(0, min(maxX, x)) / maxX * max(0, trackWidth - thumbWidth) : 0
  derive shown = type == "always" or type == "auto" or hovered or focused or pointer != -1
  action viewportResized(w: number, h: number)
    portWidth = w
    portHeight = h
  action contentResized(w: number, h: number)
    measuredWidth = w + 32
    contentHeight = h + 32
  action scrolled(left: number, top: number, e: ScrollEvent)
    x = left
    y = top
    portWidth = e.clientWidth
    portHeight = e.clientHeight
    measuredWidth = e.scrollWidth
    contentHeight = e.scrollHeight
    observeScroll(left, top, e.scrollWidth, e.scrollHeight, e.clientWidth, e.clientHeight)
  action hoverChanged(inside: bool)
    hovered = inside
  action gainedFocus
    focused = true
  action lostFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        focused = target.startsWith(id)
      case none
        focused = false
  action begin(which: string, e: PointerEvent)
    if e.button == 0
      stopPropagation()
      preventDefault()
      pointer = e.pointerId
      axis = which
      start = which == "vertical" ? e.clientY : e.clientX
      origin = which == "vertical" ? y : x
      focus(id + (which == "vertical" ? "-v-thumb" : "-h-thumb"))
  action dragged(e: PointerEvent)
    if e.pointerId == pointer
      preventDefault()
      stopPropagation()
      if axis == "vertical"
        y = max(0, min(maxY, origin + (e.clientY - start) / max(1, trackHeight - thumbHeight) * maxY))
      else
        x = max(0, min(maxX, origin + (e.clientX - start) / max(1, trackWidth - thumbWidth) * maxX))
  action ended(e: PointerEvent)
    if e.pointerId == pointer
      pointer = -1
      axis = ""
  action track(which: string, e: PointerEvent)
    if e.button == 0
      preventDefault()
      if which == "vertical"
        let box = frame(id + "-v-track")
        y = max(0, min(maxY, y + (e.clientY - box.y < thumbY ? -portHeight : portHeight)))
      else
        let box = frame(id + "-h-track")
        x = max(0, min(maxX, x + (e.clientX - box.x < thumbX ? -portWidth : portWidth)))
  action keys(which: string, k: string)
    if ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "PageUp", "PageDown", "Home", "End"].includes(k)
      preventDefault()
      let low = k == "ArrowUp" or k == "ArrowLeft" or k == "PageUp"
      if which == "vertical"
        y = k == "Home" ? 0 : k == "End" ? maxY : max(0, min(maxY, y + (low ? -1 : 1) * (k == "PageUp" or k == "PageDown" ? portHeight : 40)))
      else
        x = k == "Home" ? 0 : k == "End" ? maxX : max(0, min(maxX, x + (low ? -1 : 1) * (k == "PageUp" or k == "PageDown" ? portWidth : 40)))
  view
    view id=id testId=id role="group" aria-label=label position="relative" height=height min-height=0 min-width=0
      hover=hoverChanged focusin=gainedFocus focusout=lostFocus
      scroll id=(id + "-viewport") testId=(id + "-viewport") aria-label=label tabindex=0 width="100%" height="100%" box-sizing="border-box" min-width=0
        overflow-x=(direction == "vertical" ? "hidden" : "auto") overflow-y=(direction == "horizontal" ? "hidden" : "auto") scrollbar-width="none"
        scrollLeft=x scrollTop=y scroll=scrolled resize=viewportResized border-radius="ui.radius-control"
        :focus-visible
          box-shadow="inset 0 0 0 3px ui.ring"
        column id=(id + "-content") resize=contentResized width=(contentWidth > 0 ? contentWidth.toString() + "px" : "auto") min-width=0 padding=16 gap=12 box-sizing="border-box"
          children
      if vertical
        view id=(id + "-v-track") testId=(shown ? id + "-v-track" : "") position="absolute" right=0 top=0 width=10 height=trackHeight
          touch-action="none" user-select="none" opacity=(shown ? 1 : 0) pointer-events=(shown ? "auto" : "none") aria-hidden=(not shown)
          transition=(reduced ? "none" : "opacity 150ms ease-out") pointerdown=track("vertical")
          button id=(id + "-v-thumb") testId=(shown ? id + "-v-thumb" : "") role="scrollbar" aria-label=(label + " vertical scrollbar") aria-orientation="vertical" aria-controls=(id + "-viewport")
            aria-valuemin=0 aria-valuemax=maxY aria-valuenow=y disabled=(maxY == 0) tabindex=(shown ? 0 : -1)
            position="absolute" left=1 top=thumbY width=8 height=thumbHeight min-height=0 appearance="none" padding=0 border="0" border-radius="ui.radius-full" background-color="ui.border" touch-action="none" user-select="none"
            pointerdown=begin("vertical") pointermove=dragged pointerup=ended key=keys("vertical")
            :focus-visible
              box-shadow="0 0 0 2px ui.ring"
      if horizontal
        view id=(id + "-h-track") testId=(shown ? id + "-h-track" : "") position="absolute" left=0 bottom=0 height=10 width=trackWidth
          touch-action="none" user-select="none" opacity=(shown ? 1 : 0) pointer-events=(shown ? "auto" : "none") aria-hidden=(not shown)
          transition=(reduced ? "none" : "opacity 150ms ease-out") pointerdown=track("horizontal")
          button id=(id + "-h-thumb") testId=(shown ? id + "-h-thumb" : "") role="scrollbar" aria-label=(label + " horizontal scrollbar") aria-orientation="horizontal" aria-controls=(id + "-viewport")
            aria-valuemin=0 aria-valuemax=maxX aria-valuenow=x disabled=(maxX == 0) tabindex=(shown ? 0 : -1)
            position="absolute" top=1 left=thumbX height=8 width=thumbWidth min-height=0 appearance="none" padding=0 border="0" border-radius="ui.radius-full" background-color="ui.border" touch-action="none" user-select="none"
            pointerdown=begin("horizontal") pointermove=dragged pointerup=ended key=keys("horizontal")
            :focus-visible
              box-shadow="0 0 0 2px ui.ring"
      if vertical and horizontal
        view position="absolute" right=0 bottom=0 width=10 height=10 background-color="transparent"
