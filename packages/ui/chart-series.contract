use Control from "./styles.contract"
use chartNiceStep from "./chart.contract"
shape SeriesPoint
  id: string
  label: string
  values: number[]
shape ChartSeries
  id: string
  label: string
  color: string
shape ChartSlice
  id: string
  label: string
  value: number
  color: string
shape ChartSector
  index: number
  start: number
  sweep: number
fn seriesValue(values: number[], i: number): number = match values.at(i) { case some(v) => v, case none => 0 }
fn seriesMaximum(values: number[]): number = match first(sortBy(values, v => v, "desc")) { case some(v) => max(0, v), case none => 0 }
fn seriesMinimum(values: number[]): number = match first(sortBy(values, v => v)) { case some(v) => min(0, v), case none => 0 }
fn seriesSinCore(x: number): number = x * (1 - x * x / 6 * (1 - x * x / 20 * (1 - x * x / 42 * (1 - x * x / 72 * (1 - x * x / 110 * (1 - x * x / 156 * (1 - x * x / 210)))))))
fn seriesSin(a: number): number = seriesSinCore(((a + 3.141592653589793) % 6.283185307179586 + 6.283185307179586) % 6.283185307179586 - 3.141592653589793)
fn seriesCos(a: number): number = seriesSin(a + 1.5707963267948966)
fn seriesX(angle: number, radius: number): number = 120 + seriesCos(angle) * radius
fn seriesY(angle: number, radius: number): number = 120 - seriesSin(angle) * radius
fn seriesPair(angle: number, radius: number): string = seriesX(angle, radius).toFixed(3) + "," + seriesY(angle, radius).toFixed(3)
fn seriesArc(start: number, sweep: number, radius: number): string = sweep >= 6.283185307179585 ? "M " + seriesPair(start, radius) + " A " + radius.toFixed(3) + "," + radius.toFixed(3) + " 0 1 0 " + seriesPair(start + 3.141592653589793, radius) + " A " + radius.toFixed(3) + "," + radius.toFixed(3) + " 0 1 0 " + seriesPair(start + 6.283185307179586, radius) : "M " + seriesPair(start, radius) + " A " + radius.toFixed(3) + "," + radius.toFixed(3) + " 0 " + (sweep > 3.141592653589793 ? "1" : "0") + " 0 " + seriesPair(start + sweep, radius)
fn seriesWedge(start: number, sweep: number): string = seriesArc(start, sweep, 90) + " L 120,120 Z"
fn seriesSectors(items: ChartSlice[], total: number): ChartSector[] = items.map((item, i) => ChartSector(index=i, start=sum(items.slice(0, i).map(p => max(0, p.value))) / (total > 0 ? total : 1) * 6.283185307179586, sweep=max(0, item.value) / (total > 0 ? total : 1) * 6.283185307179586))
fn seriesContains(start: number, sweep: number, x: number, y: number): bool = sweep >= 6.283185307179585 or (sweep <= 3.141592653589793 ? seriesCos(start) * y + seriesSin(start) * x <= 0.000001 and -x * seriesSin(start + sweep) - y * seriesCos(start + sweep) <= 0.000001 : seriesCos(start) * y + seriesSin(start) * x <= 0.000001 or -x * seriesSin(start + sweep) - y * seriesCos(start + sweep) <= 0.000001)
fn seriesLineY(points: SeriesPoint[], index: number, low: number, high: number): number[] = points.map(p => 210 - (seriesValue(p.values, index) - low) / (high > low ? high - low : 1) * 190)
fn seriesSign(value: number): number = value < 0 ? -1 : 1
fn seriesMagnitude(value: number): number = max(value, -value)
fn seriesMonotoneInterior(values: number[], index: number): number = (seriesSign(seriesValue(values, index) - seriesValue(values, index - 1)) + seriesSign(seriesValue(values, index + 1) - seriesValue(values, index))) * min(min(seriesMagnitude(seriesValue(values, index) - seriesValue(values, index - 1)), seriesMagnitude(seriesValue(values, index + 1) - seriesValue(values, index))), seriesMagnitude(seriesValue(values, index + 1) - seriesValue(values, index - 1)) / 4)
fn seriesMonotoneTangent(values: number[], index: number): number = values.length < 3 ? seriesValue(values, 1) - seriesValue(values, 0) : index == 0 ? (3 * (seriesValue(values, 1) - seriesValue(values, 0)) - seriesMonotoneInterior(values, 1)) / 2 : index == values.length - 1 ? (3 * (seriesValue(values, index) - seriesValue(values, index - 1)) - seriesMonotoneInterior(values, index - 1)) / 2 : seriesMonotoneInterior(values, index)
fn seriesLineX(index: number, count: number): number = 20 + index * 520 / max(1, count - 1)
fn seriesMonotoneSegment(values: number[], tangents: number[], index: number): string = " C " + (seriesLineX(index, values.length) + 520 / max(1, values.length - 1) / 3).toFixed(3) + "," + (seriesValue(values, index) + seriesValue(tangents, index) / 3).toFixed(3) + " " + (seriesLineX(index + 1, values.length) - 520 / max(1, values.length - 1) / 3).toFixed(3) + "," + (seriesValue(values, index + 1) - seriesValue(tangents, index + 1) / 3).toFixed(3) + " " + seriesLineX(index + 1, values.length).toFixed(3) + "," + seriesValue(values, index + 1).toFixed(3)
fn seriesMonotonePath(values: number[], tangents: number[]): string = values.length == 0 ? "" : "M 20," + seriesValue(values, 0).toFixed(3) + (values.length == 1 ? " Z" : values.length == 2 ? " L 540," + seriesValue(values, 1).toFixed(3) : range(values.length - 1).map(i => seriesMonotoneSegment(values, tangents, i)).join(""))
fn seriesMonotone(values: number[]): string = seriesMonotonePath(values, values.map((v, i) => seriesMonotoneTangent(values, i)))
fn seriesRadarPath(points: SeriesPoint[], index: number, maximum: number, radius: number): string = points.map((p, i) => (i == 0 ? "M " : " L ") + seriesPair(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), radius * max(0, min(1, seriesValue(p.values, index) / (maximum > 0 ? maximum : 1))))).join("") + (points.length > 0 ? " Z" : "")
fn seriesRadarGrid(count: number, radius: number): string = range(count).map(i => (i == 0 ? "M " : " L ") + seriesPair(1.5707963267948966 - i * 6.283185307179586 / max(1, count), radius)).join("") + (count > 0 ? " Z" : "")

component SeriesLegend
  props
    id: string
    series: ChartSeries[]
    hidden: string[]
    change: action
  action keys(itemId: string, k: string)
    if k == "Enter" or k == " "
      preventDefault()
      stopPropagation()
      change(itemId)
  view
    row gap=12 flex-wrap="wrap" justify-content="center" font-family="Geist"
      for item in series key=item.id
        button id=(id + "-legend-" + item.id) testId=(id + "-legend-" + item.id) class=Control press=change(item.id) key=keys(item.id) role="checkbox" aria-checked=(not hidden.includes(item.id)) aria-label=("Show " + item.label)
          display="flex" align-items="center" gap=6 border="0" padding="4px 6px" min-height="2rem" background-color="transparent" color="ui.foreground" font-size="0.75rem" font-weight=400 text-decoration=(hidden.includes(item.id) ? "line-through" : "none")
          view width=10 height=10 border-radius="ui.radius-detail" background-color=item.color
          text item.label

component SeriesValuesTooltip
  props
    id: string
    title: string
    series: ChartSeries[]
    values: number[]
    hidden: string[]
  view
    column id=(id + "-tooltip") testId=(id + "-tooltip") role="tooltip" aria-live="polite" position="absolute" top=12 left=12 z-index=10 pointer-events="none" padding=10 gap=8 width="11rem" max-width="calc(100% - 24px)" box-sizing="border-box" border="1px solid ui.border" border-radius="ui.radius-control" background-color="ui.surface" box-shadow="0 4px 6px -1px ui.shadow" font-family="Geist" font-size="0.75rem" line-height=1.333333
      if title != ""
        text title font-weight=500
      for item, i in series key=item.id
        if not hidden.includes(item.id)
          row gap=8 align-items="center"
            view width=10 height=10 border-radius="ui.radius-detail" background-color=item.color
            text item.label flex=1 color="ui.muted-foreground"
            text seriesValue(values, i).toString() testId=(id + "-value-" + item.id) font-weight=500 font-variant-numeric="tabular-nums"

component SliceTooltip
  props
    id: string
    item: ChartSlice
  view
    SeriesValuesTooltip(id=id, title="", series=[ChartSeries(id=item.id, label=item.label, color=item.color)], values=[item.value], hidden=[])

component LineChart
  props
    id: string
    label: string
    points: SeriesPoint[]
    series: ChartSeries[]
    showLegend: bool
    reduced: bool
  state active = -1
  state pinned = false
  state hidden: string[] = []
  state width = 560
  state labelWidth = 24
  state labelHeight = 16
  derive current = min(active, points.length - 1)
  derive peak = match first(sortBy(points, p => seriesMaximum(p.values), "desc")) { case some(p) => seriesMaximum(p.values), case none => 0 }
  derive bottom = match first(sortBy(points, p => seriesMinimum(p.values))) { case some(p) => seriesMinimum(p.values), case none => 0 }
  derive step = chartNiceStep(max(1, peak - bottom) / 4)
  derive low = floor(bottom / step) * step
  derive high = max(low + step, ceil(peak / step) * step)
  action measurePlot(w: number, h: number)
    if w != width
      width = max(1, w)
  action measureLabel(w: number, h: number)
    if w != labelWidth or h != labelHeight
      labelWidth = max(1, w)
      labelHeight = max(1, h)
  action toggle(v: string)
    hidden = hidden.includes(v) ? hidden.filter(s => s != v) : hidden.concat([v])
  action inspect(e: PointerEvent)
    let box = frame(id + "-plot")
    let next = max(0, min(points.length - 1, round(((e.clientX - box.x) / max(1, box.width) * 560 - 20) / 520 * (points.length - 1))))
    if next != active
      active = next
  action press(e: PointerEvent)
    pinned = e.pointerType != "mouse"
    inspect(e)
    focus(id)
  action leaveFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        if not target.startsWith(id)
          active = -1
          pinned = false
      case none
        active = -1
        pinned = false
  action hover(inside: bool)
    if not inside and not pinned
      active = -1
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      active = -1
      pinned = false
    else if points.length > 0 and (k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End" or k == "Enter" or k == " ")
      preventDefault()
      pinned = true
      active = k == "Home" ? 0 : k == "End" ? points.length - 1 : k == "Enter" or k == " " ? max(0, active) : max(0, min(points.length - 1, active + (k == "ArrowLeft" ? -1 : 1)))
  view
    column id=id testId=id gap=16 min-width=0 font-family="Geist" color="ui.foreground" role="group" aria-label=label tabindex=0 key=keys focusout=leaveFocus outline="none"
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      view id=(id + "-plot") testId=(id + "-plot") position="relative" height=(max(250, 230 + labelHeight)) min-width=0 resize=measurePlot pointermove=inspect pointerdown=press hover=hover
        svg viewBox="0 0 560 250" width="100%" height=250 preserveAspectRatio="none" aria-hidden=true
          for tick in range(5) key=tick
            line x1=20 x2=540 y1=(20 + tick * 47.5) y2=(20 + tick * 47.5) stroke="ui.chart-grid" stroke-width=1 vector-effect="non-scaling-stroke"
          for item, i in series key=item.id
            if not hidden.includes(item.id) and points.length > 0
              path d=seriesMonotone(seriesLineY(points, i, low, high)) fill="none" stroke=item.color stroke-width=2 vector-effect="non-scaling-stroke" transition=(reduced ? "none" : "d 220ms ease-out")
        view position="absolute" inset=0 overflow="clip" opacity=0 aria-hidden=true pointer-events="none"
          text "May" position="absolute" left=0 top=0 font-family="Geist" font-size="0.75rem" resize=measureLabel aria-hidden=true pointer-events="none" white-space="nowrap"
        for p, i in points key=p.id
          if i % max(1, ceil(points.length / max(1, floor(width / max(32, labelWidth + 5))))) == 0
            text p.label.slice(0, 3) position="absolute" top=230 left=(max(min(width, labelWidth) / 2, min(width - min(width, labelWidth) / 2, width * (20 + i * 520 / max(1, points.length - 1)) / 560))) max-width="100%" overflow="hidden" translate="-50% 0px" font-size="0.75rem" color="ui.muted-foreground" pointer-events="none" white-space="nowrap"
        if current >= 0
          for item, i in series key=item.id
            if not hidden.includes(item.id)
              for p, j in points key=p.id
                if j == current
                  view position="absolute" left=(((20 + j * 520 / max(1, points.length - 1)) / 560 * 100).toString() + "%") top=(210 - (seriesValue(p.values, i) - low) / (high > low ? high - low : 1) * 190) width=8 height=8 border-radius="ui.radius-full" border="2px solid ui.surface" box-sizing="border-box" background-color=item.color translate="-50% -50%" pointer-events="none" aria-hidden=true
        if current >= 0
          for p, i in points key=p.id
            if i == current
              SeriesValuesTooltip(id=id, title=(series.length > 1 ? p.label : ""), series=series, values=p.values, hidden=hidden)
        if points.length == 0 or series.length == 0
          text "No chart data." testId=(id + "-empty") position="absolute" inset=0 display="flex" align-items="center" justify-content="center" color="ui.muted-foreground" font-size="0.875rem"
      if showLegend
        SeriesLegend(id=id, series=series, hidden=hidden, change=toggle)

component SliceLegend
  props
    id: string
    items: ChartSlice[]
    active: number
    choose: action
  action keys(i: number, k: string)
    if k == "Enter" or k == " "
      preventDefault()
      stopPropagation()
      choose(i)
  view
    row gap=12 flex-wrap="wrap" justify-content="center" font-family="Geist"
      for item, i in items key=item.id
        button id=(id + "-legend-" + item.id) testId=(id + "-legend-" + item.id) class=Control press=choose(i) key=keys(i) aria-pressed=(active == i) aria-label=("Inspect " + item.label)
          display="flex" align-items="center" gap=6 border="0" padding="4px 6px" min-height="2rem" background-color=(active == i ? "ui.muted" : "transparent") color="ui.foreground" font-size="0.75rem" font-weight=400
          view width=10 height=10 border-radius="ui.radius-detail" background-color=item.color
          text item.label

component PieChart
  props
    id: string
    label: string
    items: ChartSlice[]
    donut: bool
    showLegend: bool
    reduced: bool
  state active = -1
  state pinned = false
  derive current = min(active, items.length - 1)
  derive total = sum(items.map(item => max(0, item.value)))
  derive sectors = seriesSectors(items, total)
  action choose(i: number)
    active = i
    pinned = true
  action press(e: PointerEvent)
    pinned = e.pointerType != "mouse"
    inspect(e)
    focus(id)
  action leaveFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        if not target.startsWith(id)
          active = -1
          pinned = false
      case none
        active = -1
        pinned = false
  action hover(inside: bool)
    if not inside and not pinned
      active = -1
  action inspect(e: PointerEvent)
    let box = frame(id + "-plot")
    let scale = max(1, min(box.width, box.height)) / 240
    let x = (e.clientX - box.x - box.width / 2) / scale
    let y = (e.clientY - box.y - box.height / 2) / scale
    if x * x + y * y > 8100 or (donut and x * x + y * y < 3600) or total <= 0
      active = -1
    else
      match first(sectors.filter(s => s.sweep > 0 and seriesContains(s.start, s.sweep, x, y)))
        case some(sector)
          if sector.index != active
            active = sector.index
        case none
          active = -1
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      active = -1
      pinned = false
    else if items.length > 0 and (k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End" or k == "Enter" or k == " ")
      preventDefault()
      pinned = true
      active = k == "Home" ? 0 : k == "End" ? items.length - 1 : active < 0 ? (k == "ArrowLeft" ? items.length - 1 : 0) : k == "ArrowLeft" ? (active + items.length - 1) % items.length : k == "ArrowRight" ? (active + 1) % items.length : active
  view
    column id=id testId=id role="group" aria-label=label tabindex=0 key=keys focusout=leaveFocus outline="none" gap=16 align-items="center" min-width=0 font-family="Geist" color="ui.foreground"
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      view id=(id + "-plot") testId=(id + "-plot") position="relative" width=250 max-width="100%" height=250 pointermove=inspect pointerdown=press hover=hover
        svg width="100%" height=250 viewBox="0 0 240 240" preserveAspectRatio="xMidYMid meet" aria-hidden=true
          if total > 0
            for sector in sectors key=sector.index
              if sector.sweep > 0
                match items.at(sector.index)
                  case some(item)
                    path d=seriesWedge(sector.start, sector.sweep) fill=item.color stroke="none" transition=(reduced ? "none" : "d 220ms ease-out")
                  case none
                    circle cx=120 cy=120 r=0 fill="none"
          else
            circle cx=120 cy=120 r=90 fill="none" stroke="ui.muted" stroke-width=24
          if donut
            circle cx=120 cy=120 r=60 fill="ui.surface"
        if donut
          column position="absolute" left="50%" top="50%" translate="-50% -50%" align-items="center" pointer-events="none" gap=2
            text total.toString() testId=(id + "-total") font-size="1.875rem" line-height=1.2 font-weight=700 font-variant-numeric="tabular-nums"
            text "Visitors" font-size="0.75rem" color="ui.muted-foreground"
        if total <= 0
          text "No chart data." testId=(id + "-empty") position="absolute" bottom=0 left=0 right=0 text-align="center" font-size="0.875rem" color="ui.muted-foreground"
        if current >= 0
          match items.at(current)
            case some(item)
              SliceTooltip(id=id, item=item)
            case none
              view
      if showLegend
        SliceLegend(id=id, items=items, active=current, choose=choose)

component RadarChart
  props
    id: string
    label: string
    points: SeriesPoint[]
    series: ChartSeries[]
    maximum: number
    showLegend: bool
    reduced: bool
  state active = -1
  state pinned = false
  state hidden: string[] = []
  derive current = min(active, points.length - 1)
  derive peak = match first(sortBy(points, p => seriesMaximum(p.values), "desc")) { case some(p) => seriesMaximum(p.values), case none => 0 }
  derive step = chartNiceStep(max(1, peak) / 4)
  derive domain = maximum > 0 ? maximum : max(1, ceil(peak / step) * step)
  action toggle(v: string)
    hidden = hidden.includes(v) ? hidden.filter(s => s != v) : hidden.concat([v])
  action press(e: PointerEvent)
    pinned = e.pointerType != "mouse"
    inspect(e)
    focus(id)
  action leaveFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        if not target.startsWith(id)
          active = -1
          pinned = false
      case none
        active = -1
        pinned = false
  action hover(inside: bool)
    if not inside and not pinned
      active = -1
  action inspect(e: PointerEvent)
    let box = frame(id + "-plot")
    let scale = max(1, min(box.width, box.height)) / 240
    let x = (e.clientX - box.x - box.width / 2) / scale
    let y = (e.clientY - box.y - box.height / 2) / scale
    if x * x + y * y > 12100
      active = -1
    else
      match first(sortBy(range(points.length), i => (seriesX(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 80) - 120 - x) * (seriesX(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 80) - 120 - x) + (seriesY(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 80) - 120 - y) * (seriesY(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 80) - 120 - y)))
        case some(i)
          if i != active
            active = i
        case none
          active = -1
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      active = -1
      pinned = false
    else if points.length > 0 and (k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End" or k == "Enter" or k == " ")
      preventDefault()
      pinned = true
      active = k == "Home" ? 0 : k == "End" ? points.length - 1 : active < 0 ? (k == "ArrowLeft" ? points.length - 1 : 0) : k == "ArrowLeft" ? (active + points.length - 1) % points.length : k == "ArrowRight" ? (active + 1) % points.length : active
  view
    column id=id testId=id role="group" aria-label=label tabindex=0 key=keys focusout=leaveFocus outline="none" gap=16 min-width=0 align-items="center" font-family="Geist" color="ui.foreground"
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      view id=(id + "-plot") testId=(id + "-plot") position="relative" width=250 max-width="100%" height=250 pointermove=inspect pointerdown=press hover=hover
        svg width="100%" height=250 viewBox="0 0 240 240" preserveAspectRatio="xMidYMid meet" aria-hidden=true
          for ring in range(5) key=ring
            path d=seriesRadarGrid(points.length, 16 * (ring + 1)) fill="none" stroke="ui.chart-grid" stroke-width=1
          for point, i in points key=point.id
            line x1=120 y1=120 x2=seriesX(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 80) y2=seriesY(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 80) stroke="ui.chart-grid" stroke-width=1
          for item, i in series key=item.id
            if not hidden.includes(item.id) and points.length >= 3
              path d=seriesRadarPath(points, i, domain, 80) fill=item.color fill-opacity=0.6 stroke=item.color stroke-width=1 transition=(reduced ? "none" : "d 220ms ease-out")
              if current >= 0
                for point, j in points key=point.id
                  if j == current
                    circle cx=seriesX(1.5707963267948966 - j * 6.283185307179586 / max(1, points.length), 80 * max(0, min(1, seriesValue(point.values, i) / domain))) cy=seriesY(1.5707963267948966 - j * 6.283185307179586 / max(1, points.length), 80 * max(0, min(1, seriesValue(point.values, i) / domain))) r=4 fill=item.color stroke="ui.surface" stroke-width=2
        for point, i in points key=point.id
          text point.label position="absolute" left=((seriesX(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 100) / 240 * 100).toString() + "%") top=((seriesY(1.5707963267948966 - i * 6.283185307179586 / max(1, points.length), 100) / 240 * 100).toString() + "%") translate="-50% -50%" font-size="min(-exact-caption1, 16px)" color="ui.muted-foreground" pointer-events="none" max-width="5rem" text-align="center" white-space="nowrap"
        if points.length < 3 or series.length == 0
          text "At least three axes are required." testId=(id + "-empty") position="absolute" bottom=0 left=0 right=0 text-align="center" color="ui.muted-foreground" font-size="0.875rem"
        if current >= 0
          for point, i in points key=point.id
            if i == current
              SeriesValuesTooltip(id=id, title=point.label, series=series, values=point.values, hidden=hidden)
      if showLegend
        SeriesLegend(id=id, series=series, hidden=hidden, change=toggle)

component RadialChart
  props
    id: string
    label: string
    items: ChartSlice[]
    maximum: number
    sweep: number
    showLegend: bool
    reduced: bool
  state active = -1
  state pinned = false
  derive current = min(active, items.length - 1)
  derive peak = match first(sortBy(items, item => item.value, "desc")) { case some(item) => max(0, item.value), case none => 0 }
  derive domain = maximum > 0 ? maximum : max(1, peak)
  derive angle = max(0, min(360, sweep)) / 360 * 6.283185307179586
  derive step = 80 / max(1, items.length)
  action choose(i: number)
    active = i
    pinned = true
  action press(e: PointerEvent)
    pinned = e.pointerType != "mouse"
    inspect(e)
    focus(id)
  action leaveFocus(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        if not target.startsWith(id)
          active = -1
          pinned = false
      case none
        active = -1
        pinned = false
  action hover(inside: bool)
    if not inside and not pinned
      active = -1
  action inspect(e: PointerEvent)
    let box = frame(id + "-plot")
    let scale = max(1, min(box.width, box.height)) / 240
    let x = (e.clientX - box.x - box.width / 2) / scale
    let y = (e.clientY - box.y - box.height / 2) / scale
    match first(range(items.length).filter(i => x * x + y * y >= (30 + i * step) * (30 + i * step) and x * x + y * y < (30 + (i + 1) * step) * (30 + (i + 1) * step)))
      case some(i)
        if i != active
          active = i
      case none
        active = -1
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      active = -1
      pinned = false
    else if items.length > 0 and (k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End" or k == "Enter" or k == " ")
      preventDefault()
      pinned = true
      active = k == "Home" ? 0 : k == "End" ? items.length - 1 : active < 0 ? (k == "ArrowLeft" ? items.length - 1 : 0) : k == "ArrowLeft" ? (active + items.length - 1) % items.length : k == "ArrowRight" ? (active + 1) % items.length : active
  view
    column id=id testId=id role="group" aria-label=label tabindex=0 key=keys focusout=leaveFocus outline="none" gap=16 min-width=0 align-items="center" font-family="Geist" color="ui.foreground"
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      view id=(id + "-plot") testId=(id + "-plot") position="relative" width=250 max-width="100%" height=250 pointermove=inspect pointerdown=press hover=hover
        svg width="100%" height=250 viewBox="0 0 240 240" preserveAspectRatio="xMidYMid meet" aria-hidden=true
          for item, i in items key=item.id
            path d=seriesArc(0, angle, 30 + (i + 0.5) * step) fill="none" stroke="ui.muted" stroke-width=max(1, step * 0.8)
            if item.value > 0 and angle > 0
              path d=seriesArc(0, angle * max(0, min(1, item.value / domain)), 30 + (i + 0.5) * step) fill="none" stroke=item.color stroke-width=max(1, step * 0.8) transition=(reduced ? "none" : "d 220ms ease-out")
        if items.length == 0
          text "No chart data." testId=(id + "-empty") position="absolute" inset=0 display="flex" align-items="center" justify-content="center" font-size="0.875rem" color="ui.muted-foreground"
        if current >= 0
          match items.at(current)
            case some(item)
              SliceTooltip(id=id, item=item)
            case none
              view
      if showLegend
        SliceLegend(id=id, items=items, active=current, choose=choose)
