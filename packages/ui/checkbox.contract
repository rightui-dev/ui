use uiFontFamily from "./typography-context.contract"
use Pressable from "./styles.contract"
component CheckboxFrame
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
    showLabel: bool
  view
    CheckboxField(id=id, label=label, checked=checked, disabled=disabled, change=change, showLabel=showLabel, description="", card=false, invalid=false)

component CheckboxField
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
    showLabel: bool
    description: string
    card: bool
    invalid: bool
  inject
    uiFont: string
  action toggle
    if not disabled
      change(not checked)
  view
    button id=id testId=id appearance="none" class=Pressable press=toggle disabled=disabled
      role="checkbox" aria-checked=checked aria-label=label aria-invalid=invalid aria-describedby=(description != "" ? id + "-description" : "")
      display="flex" align-items=(description == "" ? "center" : "flex-start") justify-content="flex-start" gap="ui.space-8"
      min-height="ui.touch-target" width=(showLabel ? "auto" : "ui.touch-target") padding=(card ? "ui.space-16" : "0px") border-width=(card ? "ui.border-width" : "0px") border-style="solid" border-color=(card and checked ? "ui.primary" : "ui.border") border-radius=(card ? "ui.radius-panel" : "ui.radius-control") background-color=(card and checked ? "ui.muted" : "transparent") color="ui.foreground"
      :hover
        background-color="transparent"
      :active
        background-color="transparent"
      :focus-visible
        box-shadow="ui.shadow-focus"
      :disabled
        opacity="ui.opacity-disabled"
      view flex-shrink=0 width="ui.space-16" height="ui.space-16" border-radius="ui.radius-checkbox" box-sizing="border-box"
        margin-top=(description == "" ? 0 : 2) border-width="ui.border-width" border-style="solid" border-color=(invalid ? "ui.destructive" : checked ? "ui.primary" : "ui.input")
        background-color=(checked ? "ui.primary" : "ui.surface")
        display="flex" align-items="center" justify-content="center" aria-hidden=true
        if checked
          svg width="ui.space-12" height="ui.space-12" viewBox="0 0 24 24" fill="none" stroke="ui.primary-foreground" stroke-width="ui.stroke-standard"
            path d="M5 12l4 4L19 6"
      if showLabel
        column flex=1 min-width=0 gap="ui.space-4" align-items="flex-start" text-align="start"
          text label font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          if description != ""
            text description id=(id + "-description") testId=(id + "-description") color="ui.muted-foreground" font-size="ui.text-sm" line-height="ui.leading-normal" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component Checkbox
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
  view
    CheckboxFrame(id=id, label=label, checked=checked, disabled=disabled, change=change, showLabel=true)

component CheckboxControl
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
  view
    CheckboxFrame(id=id, label=label, checked=checked, disabled=disabled, change=change, showLabel=false)
