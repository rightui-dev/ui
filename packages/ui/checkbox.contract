use uiFontFamily from "./typography-context.contract"
use Pressable from "./styles.contract"
component CheckboxFrame
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
    showLabel: bool
  inject
    uiFont: string
  action toggle
    if not disabled
      change(not checked)
  view
    button id=id testId=id appearance="none" class=Pressable press=toggle disabled=disabled
      role="checkbox" aria-checked=checked aria-label=label
      display="flex" align-items="center" justify-content="flex-start" gap="ui.space-8"
      min-height="ui.touch-target" width=(showLabel ? "auto" : "ui.touch-target") padding="0px" border="0" background-color="transparent" color="ui.foreground"
      :focus-visible
        box-shadow="ui.shadow-focus"
      :disabled
        opacity="ui.opacity-disabled"
      view flex-shrink=0 width="ui.space-16" height="ui.space-16" border-radius="ui.radius-checkbox" box-sizing="border-box"
        border-width=(checked ? "ui.border-width" : "ui.border-width") border-style=(checked ? "solid" : "solid") border-color=(checked ? "ui.primary" : "ui.border")
        background-color=(checked ? "ui.primary" : "ui.surface")
        display="flex" align-items="center" justify-content="center" aria-hidden=true
        if checked
          svg width="ui.space-12" height="ui.space-12" viewBox="0 0 24 24" fill="none" stroke="ui.primary-foreground" stroke-width="ui.stroke-standard"
            path d="M5 12l4 4L19 6"
      if showLabel
        text label flex=1 min-width="0px" text-align="left" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component Checkbox
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
  view
    CheckboxFrame(id=id, label=label, checked=checked, disabled=disabled, change=change, showLabel=true)

component CheckboxControl
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
  view
    CheckboxFrame(id=id, label=label, checked=checked, disabled=disabled, change=change, showLabel=false)
