use Pressable from "./styles.contract"
component Checkbox
  props
    id: string
    label: string
    checked: bool
    disabled: bool
    change: action
  action toggle
    if not disabled
      change(not checked)
  view
    button id=id testId=id appearance="none" class=Pressable press=toggle disabled=disabled
      role="checkbox" aria-checked=checked aria-label=label
      display="flex" align-items="center" justify-content="flex-start" gap=8
      min-height=44 padding=0 border="0" background-color="transparent" color="ui.foreground"
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      :disabled
        opacity=0.5
      view flex-shrink=0 width=16 height=16 border-radius="ui.radius-checkbox" box-sizing="border-box"
        border=(checked ? "1px solid ui.primary" : "1px solid ui.border")
        background-color=(checked ? "ui.primary" : "ui.surface")
        display="flex" align-items="center" justify-content="center" aria-hidden=true
        if checked
          svg width=12 height=12 viewBox="0 0 24 24" fill="none" stroke="ui.primary-foreground" stroke-width=2
            path d="M5 12l4 4L19 6"
      text label flex=1 min-width=0 text-align="left" font-size="0.875rem"
