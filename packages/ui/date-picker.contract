use Calendar from "./calendar.contract"
use Control from "./styles.contract"
component DatePicker
  props
    id: string
    value: string
    initialYear: number
    initialMonth: number
    disabled: bool
    change: action
  state opened = false
  state year = initialYear
  state month = initialMonth
  action toggle
    if not disabled
      if opened
        hidePopover(id + "-popup")
      else
        year = match parseNumber(value.slice(0, 4)) { case some(y) => max(1, min(9999, floor(y))), case none => initialYear }
        month = match parseNumber(value.slice(5, 7)) { case some(m) => max(1, min(12, floor(m))), case none => initialMonth }
        opened = true
        showPopover(id + "-popup", source=id)
  action changeMonth(y: number, m: number)
    year = y
    month = m
  action toggled(e: ToggleEvent)
    opened = e.newState == "open"
  action selected(v: string)
    change(v)
    hidePopover(id + "-popup")
    focus(id)
  action triggerKeys(k: string)
    if k == "Enter" or k == " "
      preventDefault()
      toggle()
    else if k == "ArrowDown"
      preventDefault()
      if not opened
        toggle()
  action keys(k: string)
    if k == "Escape"
      hidePopover(id + "-popup")
      focus(id)
  view
    column min-width=0
      button id=id testId=id class=Control press=toggle key=triggerKeys disabled=disabled aria-expanded=opened aria-controls=(id + "-popup") aria-haspopup="dialog"
        display="flex" align-items="center" gap=8 padding="8px 12px" width="15rem" max-width="100%" border="1px solid ui.border" background-color="ui.surface" color=(value == "" ? "ui.muted-foreground" : "ui.foreground")
        svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width=2 aria-hidden=true
          rect x=3 y=5 width=18 height=16 rx=2
          path d="M16 3v4M8 3v4M3 11h18"
        text (value == "" ? "Pick a date" : value)
      if opened
        column id=(id + "-popup") testId=(id + "-popup") popover="auto" toggle=toggled key=keys role="dialog" aria-label="Choose a date" tabindex=-1
          position-area="bottom" position-try-fallbacks="flip-block, flip-inline" max-width="calc(100vw - 32px)" max-height="calc(100vh - 32px)" overflow="auto" margin=4 padding=0 border="1px solid ui.border" border-radius="ui.radius-popover" background-color="ui.surface"
          Calendar(id=id + "-calendar", year=year, month=month, changeMonth=changeMonth, value=value, end="", mode="single", disabled=disabled, change=selected)
