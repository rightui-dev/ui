use uiFontFamily from "./typography-context.contract"
keyframes traceSweep64
  from translate="-64px 0px"
  to translate="64px 0px"
keyframes traceCounter64
  from translate="64px 0px"
  to translate="-64px 0px"

keyframes traceSweep128
  from translate="-64px 0px"
  to translate="128px 0px"
keyframes traceCounter128
  from translate="64px 0px"
  to translate="-128px 0px"

keyframes traceSweep256
  from translate="-64px 0px"
  to translate="256px 0px"
keyframes traceCounter256
  from translate="64px 0px"
  to translate="-256px 0px"

keyframes traceSweep512
  from translate="-64px 0px"
  to translate="512px 0px"
keyframes traceCounter512
  from translate="64px 0px"
  to translate="-512px 0px"

keyframes traceSweep1024
  from translate="-64px 0px"
  to translate="1024px 0px"
keyframes traceCounter1024
  from translate="64px 0px"
  to translate="-1024px 0px"

keyframes traceSpin
  from rotate="0deg"
  to rotate="360deg"

use Control from "./styles.contract"
component TraceIcon
  props
    icon: string
    status: string
    reduced: bool
  view
    svg width="ui.space-16" height="ui.space-16" flex-shrink=0 viewBox="0 0 24 24" fill="none" stroke=(status == "error" ? "ui.danger" : "currentColor") stroke-width="ui.stroke-standard" stroke-linecap="round" stroke-linejoin="round" animation=(status == "running" and (icon == "check" or icon == "loader") and not reduced ? "traceSpin ui.duration-spin ui.easing-linear infinite" : "none") aria-hidden=true
      if icon == "loader" or (status == "running" and icon == "check")
        path d="M12 2a10 10 0 1 0 10 10"
      else if icon == "dot"
        circle cx=12 cy=12 r=10
        circle cx=12 cy=12 r=3
      else if icon == "terminal"
        path d="m4 17 6-5-6-5M12 19h8"
      else if icon == "search"
        circle cx=10.5 cy=10.5 r=7.5
        path d="m16 16 5 5"
      else if icon == "clock"
        circle cx=12 cy=12 r=10
        path d="M12 6v6l4 2"
      else if icon == "brain"
        path d="M12 18V5a3 3 0 0 0-5.8-1A4 4 0 0 0 4 11a4 4 0 0 0 2 7.5A3 3 0 0 0 12 18ZM12 5a3 3 0 0 1 5.8-1A4 4 0 0 1 20 11a4 4 0 0 1-2 7.5A3 3 0 0 1 12 18M8 8c-1 0-2-.5-2-1.5M16 8c1 0 2-.5 2-1.5M6 14a3 3 0 0 1 3 2M18 14a3 3 0 0 0-3 2"
      else if icon == "globe"
        circle cx=12 cy=12 r=10
        path d="M2 12h20M12 2a18 18 0 0 1 0 20 18 18 0 0 1 0-20"
      else if icon == "external"
        path d="M7 17 17 7M7 7h10v10"
      else if icon == "file"
        path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M10 13l-2 2 2 2M14 13l2 2-2 2"
      else if icon == "layers"
        path d="m12 3 10 5-10 5L2 8ZM2 12l10 5 10-5M2 16l10 5 10-5"
      else if icon == "flask"
        path d="M9 3h6M10 3v7L4 20a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1l-6-10V3M8 15h8"
      else if icon == "route"
        circle cx=6 cy=6 r=3
        circle cx=18 cy=18 r=3
        path d="M9 6h8a4 4 0 0 1 0 8H7a4 4 0 0 0 0 8h5"
      else if icon == "list"
        path d="m3 6 1 1 2-2M10 6h11M3 12h3M10 12h11M3 18h3M10 18h11"
      else if icon == "x"
        path d="m6 6 12 12M6 18 18 6"
      else if icon == "tick"
        path d="m5 12 4 4L19 6"
      else if status == "pending"
        circle cx=12 cy=12 r=10
      else if status == "error"
        circle cx=12 cy=12 r=10
        path d="M12 8v4M12 16h.01"
      else
        circle cx=12 cy=12 r=10
        path d="m8 12 3 3 5-6"
component TraceFrame
  slot
  view
    column gap="ui.space-8" min-width="0px" color="ui.muted-foreground" font-size="ui.text-sm"
      children
style TraceTitleText
  font-size="ui.text-sm"
  line-height="ui.leading-control"
  font-weight="ui.weight-regular"
  white-space="nowrap"

component TraceTitle
  props
    title: string
    running: bool
    reduced: bool
  inject
    uiFont: string
  state width = 64
  action measure(w: number, h: number)
    width = w
  derive band = width <= 64 ? "64" : width <= 128 ? "128" : width <= 256 ? "256" : width <= 512 ? "512" : "1024"
  view
    view position="relative" flex="0 1 auto" min-width="0px" max-width="100%" overflow="hidden" resize=measure
      text title class=TraceTitleText min-width="0px" overflow="hidden" text-overflow="ellipsis" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if running and not reduced
        view position="absolute" left="0px" top="0px" bottom="0px" width=64 pointer-events="none" aria-hidden=true mask-image="linear-gradient(to right, transparent 0%, #000000 50%, transparent 100%)" animation=("traceSweep" + band + " ui.duration-shimmer ui.easing-linear infinite")
          text title class=TraceTitleText position="absolute" left="0px" top="0px" width=width color="ui.trace-shimmer" animation=("traceCounter" + band + " ui.duration-shimmer ui.easing-linear infinite") font-family=uiFontFamily(uiFont) data-rightui-font="body"

component TraceLine
  props
    title: string
    icon: string
    status: string
    reduced: bool
  view
    row gap="ui.space-8" align-items="center" flex="0 1 auto" min-width="0px" max-width="100%" color=(status == "error" ? "ui.danger" : "ui.muted-foreground") opacity=(status == "pending" ? "ui.opacity-quiet" : 1)
      if icon != "none"
        TraceIcon(icon=icon, status=status, reduced=reduced)
      TraceTitle(title=title, running=(status == "running"), reduced=reduced)
component TraceDescription
  props
    description: string
  inject
    uiFont: string
  view
    text description flex-shrink=0 font-size="ui.text-xs" line-height="ui.leading-normal" color="ui.muted-foreground" font-variant-numeric="tabular-nums" font-family=uiFontFamily(uiFont) data-rightui-font="body"
component TraceDisclosure
  props
    id: string
    title: string
    icon: string
    status: string
    open: bool
    reduced: bool
    toggle: action
  slot
  view
    column min-width="0px"
      button id=id testId=id class=Control press=toggle aria-label=title aria-expanded=open aria-controls=(id + "-content")
        display="flex" align-items="center" align-self="flex-start" text-align="left" gap="ui.space-4" padding="ui.space-4 0px" margin="ui.space-negative-4 0px" min-height="ui.space-28" border="0" border-radius="ui.radius-md" background-color="transparent" color=(status == "error" ? "ui.danger" : "ui.muted-foreground")
        transition=(reduced ? "none" : "color ui.duration-fast ui.easing")
        :hover
          color="ui.foreground"
        TraceLine(title=title, icon=icon, status=status, reduced=reduced)
        svg width="ui.space-16" height="ui.space-16" flex-shrink=0 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.stroke-standard" rotate=(open ? "90deg" : "0deg") transition=(reduced ? "none" : "rotate ui.duration-normal ui.easing") aria-hidden=true
          path d="m9 6 6 6-6 6"
      column id=(id + "-content") testId=(open ? id + "-content" : "") height=(open ? "auto" : "0px") min-height="0px" overflow="hidden" aria-hidden=(not open) inert=(not open)
        -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing")
        column margin="ui.space-8 ui.space-4 ui.space-4 ui.space-7" padding-left="ui.space-16" border-left-width="ui.border-width" border-left-style="solid" border-left-color="ui.border" gap="ui.space-8" min-width="0px" font-size="ui.text-sm" color="ui.muted-foreground" line-height="ui.leading-code"
          children
component TraceCollapsible
  props
    id: string
    title: string
    icon: string
    status: string
    initiallyOpen: bool
    reduced: bool
  slot
  state open = initiallyOpen
  action toggle
    open = not open
  view
    TraceDisclosure(id=id, title=title, icon=icon, status=status, open=open, reduced=reduced, toggle=toggle)
      children
component TraceSource
  props
    title: string
    href: string
    reduced: bool
  inject
    uiFont: string
  view
    link href=href target="_blank" rel="noopener noreferrer" aria-label=(title + " (opens in a new tab)") color="ui.muted-foreground" text-decoration="none" min-width="0px" max-width="100%" border-radius="ui.radius-md"
      :hover
        color="ui.foreground"
      :focus-visible
        box-shadow="ui.shadow-focus"
      row gap="ui.space-8" align-items="center" min-width="0px"
        TraceIcon(icon="globe", status="", reduced=reduced)
        text title font-size="ui.text-sm" line-height="ui.leading-control" min-width="0px" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        TraceIcon(icon="external", status="", reduced=reduced)
component CodeBlockContent
  props
    id: string
    code: string
  view
    scroll id=id testId=id max-height=256 min-width="0px" border-radius="ui.ai-radius-control" background-color="ui.muted" box-shadow="ui.shadow-border"
      text code padding="ui.space-12" color="ui.foreground" font-family="ui.font-code" font-size="ui.text-xs" line-height="ui.leading-code" white-space="pre-wrap" overflow-wrap="break-word"
