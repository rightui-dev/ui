use uiFontFamily from "./typography-context.contract"
use ButtonContent from "./button.contract"
component InputGroup
  props
    id: string
    label: string
    value: string
    placeholder: string
    prefix: string
    suffix: string
    buttonLabel: string
    disabled: bool
    edit: action
    submit: action
  inject
    uiFont: string
  view
    column gap="ui.space-8" min-width="0px"
      text label id=(id + "-label") font-size="ui.text-sm" font-weight="ui.weight-medium" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      row id=(id + "-group") testId=(id + "-group") role="group" aria-labelledby=(id + "-label") align-items="center" gap="ui.space-8"
        min-height="ui.space-36" padding="0px ui.space-6 0px ui.space-12" box-sizing="border-box" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" background-color="ui.surface" color="ui.foreground"
        if prefix != ""
          text prefix font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        input id=id testId=id value=value input=edit submit=submit placeholder=placeholder disabled=disabled aria-labelledby=(id + "-label") font-family=uiFontFamily(uiFont) data-rightui-font="body"
          appearance="none" flex=1 min-width="0px" height="ui.space-34" padding="0px" border="0" background-color="transparent" color="ui.foreground" font-size="ui.text-sm"
          :focus-visible
            box-shadow="ui.shadow-focus"
        if suffix != ""
          text suffix font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if buttonLabel != ""
          ButtonContent(id=id + "-action", label=buttonLabel, variant="secondary", size="xs", disabled=disabled, press=submit)
            text buttonLabel font-family=uiFontFamily(uiFont) data-rightui-font="body"
