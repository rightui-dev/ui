use Control from "./styles.contract"
component Attachment
  props
    id: string
    name: string
    metadata: string
    content: string
    status: string
    remove: action
  state preview = false
  action toggle
    preview = not preview
  view
    column gap=8 min-width=0
      row gap=8 padding="8px 10px" align-items="center" border=(status == "error" ? "1px solid ui.danger" : "1px solid ui.border") border-radius="ui.radius-panel" background-color="ui.surface"
        view width="2.5rem" height="2.5rem" border-radius="ui.radius-lg" background-color="ui.muted" display="flex" align-items="center" justify-content="center"
          image "symbol:document" width=16 height=16
        button id=(id + "-preview") testId=(id + "-preview") class=Control press=toggle aria-expanded=preview aria-controls=(id + "-content") flex=1 padding=0 border="none" background-color="transparent" color="ui.foreground" text-align="left"
          column gap=2 min-width=0
            text name font-size="0.875rem" font-weight=500 overflow-wrap="break-word"
            text metadata font-size="0.75rem" color="ui.muted-foreground" overflow-wrap="break-word"
        button testId=(id + "-remove") class=Control press=remove aria-label=("Retirer " + name) padding=8 border="none" background-color="transparent" color="ui.muted-foreground"
          image "symbol:close" width=14 height=14
      if preview
        text content id=(id + "-content") testId=(id + "-content") padding=12 border="1px solid ui.border" border-radius="ui.radius-panel" font-size="0.875rem" line-height=1.5 color="ui.foreground" white-space="pre-wrap" overflow-wrap="break-word"

component Bubble
  props
    id: string
    body: string
    align: string
    variant: string
    collapsible: bool
  state bubbleCollapsed: bool = false
  state bubbleReacted: bool = false
  action toggle
    bubbleCollapsed = not bubbleCollapsed
  action react
    bubbleReacted = not bubbleReacted
  view
    column id=id testId=id gap=4 max-width="80%" min-width=0 align-self=(align == "end" ? "flex-end" : "flex-start")
      column gap=6 padding="8px 12px" border-radius="ui.radius-panel" border=(variant == "outline" ? "1px solid ui.border" : "1px solid transparent") background-color=((variant == "primary" or variant == "default") ? "ui.primary" : variant == "ghost" or variant == "outline" ? "transparent" : "ui.muted") color=((variant == "primary" or variant == "default") ? "ui.primary-foreground" : variant == "destructive" ? "ui.danger" : "ui.foreground")
        if not bubbleCollapsed
          text body testId=(id + "-body") font-size="0.875rem" line-height=1.625 white-space="pre-wrap" overflow-wrap="break-word"
        if collapsible
          button testId=(id + "-collapse") class=Control press=toggle aria-expanded=(not bubbleCollapsed) padding=0 min-height="1.5rem" border="none" background-color="transparent" color="inherit"
            text (bubbleCollapsed ? "Afficher le message" : "Collapse") font-size="0.75rem"
      button testId=(id + "-reaction") class=Control press=react aria-pressed=bubbleReacted aria-label="Helpful reaction" align-self="flex-end" min-height="1.5rem" padding="2px 8px" border="1px solid ui.border" border-radius="ui.radius-full" background-color="ui.muted" color="ui.foreground"
        text (bubbleReacted ? "Utile · 1" : "Utile") font-size="0.75rem"

component Marker
  props
    id: string
    label: string
    variant: string
  view
    row id=id testId=id gap=8 align-items="center" min-height=16 padding-bottom=(variant == "border" ? 8 : 0) border-bottom=(variant == "border" ? "1px solid ui.border" : "none")
      if variant == "separator"
        view flex=1 height=1 background-color="ui.border" aria-hidden=true
      text label font-size="0.875rem" color="ui.muted-foreground" overflow-wrap="break-word"
      if variant == "separator"
        view flex=1 height=1 background-color="ui.border" aria-hidden=true

component Message
  props
    id: string
    author: string
    initials: string
    time: string
    align: string
  slot
  view
    row id=id testId=id gap=8 min-width=0 flex-direction=(align == "end" ? "row-reverse" : "row")
      view width="2rem" height="2rem" flex-shrink=0 align-self="flex-end" border-radius="ui.radius-full" background-color="ui.muted" display="flex" align-items="center" justify-content="center"
        text initials font-size="0.75rem" color="ui.foreground" aria-label=author
      column gap=10 flex=1 min-width=0 align-items=(align == "end" ? "flex-end" : "flex-start")
        text author padding="0px 12px" font-size="0.75rem" font-weight=500 color="ui.muted-foreground"
        children
        if time != ""
          text time padding="0px 12px" font-size="0.75rem" color="ui.muted-foreground"
