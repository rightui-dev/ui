use uiFontFamily from "./typography-context.contract"
component Slider
  props
    id: string
    label: string
    value: number
    minimum: number
    maximum: number
    step: number
    disabled: bool
    change: action
  inject
    uiFont: string
  state start = 0
  state trackWidth = 1
  derive ratio = max(0, min(1, (value - minimum) / max(1, maximum - minimum)))
  action update(n: number)
    if not disabled
      change(max(minimum, min(maximum, minimum + round((n - minimum) / step) * step)))
  action begin(e: PointerEvent)
    let box = frame(id + "-track")
    let width = max(1, box.width)
    let position = max(0, min(width, e.clientX - box.x))
    trackWidth = width
    start = position
    update(minimum + position / width * (maximum - minimum))
    focus(id)
  action move(dx: number, dy: number)
    let position = start + dx
    start = position
    update(minimum + position / trackWidth * (maximum - minimum))
  action keys(k: string)
    if k == "ArrowRight" or k == "ArrowUp"
      preventDefault()
      update(value + step)
    if k == "ArrowLeft" or k == "ArrowDown"
      preventDefault()
      update(value - step)
    if k == "Home"
      preventDefault()
      update(minimum)
    if k == "End"
      preventDefault()
      update(maximum)
    if k == "PageUp"
      preventDefault()
      update(value + step * 10)
    if k == "PageDown"
      preventDefault()
      update(value - step * 10)
  view
    column gap="ui.space-8" min-width="0px"
      row justify-content="space-between" align-items="center" flex-wrap="wrap" gap="ui.space-8"
        text label flex="1 1 8rem" min-width="0px" hyphens="auto" font-size="ui.text-sm" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text value.toFixed(0) flex-shrink=0 font-size="ui.text-caption" color="ui.muted-foreground" font-variant-numeric="tabular-nums" testId=(id + "-value") font-family=uiFontFamily(uiFont) data-rightui-font="body"
      view id=id testId=id role="slider" aria-label=label aria-valuemin=minimum aria-valuemax=maximum aria-valuenow=value
        aria-disabled=disabled tabindex=(disabled ? -1 : 0) key=keys pointerdown=begin pan=move
        height="ui.touch-target" width="100%" position="relative" touch-action="none" cursor="pointer" opacity=(disabled ? "ui.opacity-disabled" : 1)
        :focus-visible
          box-shadow="ui.shadow-focus"
        view id=(id + "-track") position="absolute" left="ui.space-10" right="ui.space-10" top="50%" translate="0px -50%" height="ui.space-6" border-radius="ui.radius-full" background-color="ui.muted" pointer-events="none"
          view height="100%" width=((ratio * 100).toString() + "%") border-radius="ui.radius-full" background-color="ui.primary"
          view position="absolute" left=((ratio * 100).toString() + "%") top="50%" width="ui.space-20" height="ui.space-20" translate="-50% -50%"
            border-radius="ui.radius-full" background-color="ui.surface" border-width="ui.border-strong-width" border-style="solid" border-color="ui.primary" box-sizing="border-box"
