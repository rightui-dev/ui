use uiFontFamily from "./typography-context.contract"
use Button from "./button.contract"
use Message from "./conversation.contract"
use Field from "./styles.contract"
shape ContentMessage
  id: number
  body: string
  mine: bool

component MessageScroller
  props
    id: string
    messages: ContentMessage[]
    historyLoaded: bool
    loadHistory: action
    send: action
    latest: action
  inject
    uiFont: string
  state draft = ""
  action edit(v: string)
    draft = v
  action post
    if draft.trim() != ""
      send(draft.trim())
      draft = ""
  view
    column id=(id + "-root") testId=id gap="ui.space-12" min-width="0px"
      row justify-content="center"
        Button(id=id + "-history", label=(historyLoaded ? "Start of conversation" : "Load earlier messages"), variant="outline", disabled=historyLoaded, press=loadHistory)
      list id=id testId=(id + "-viewport") appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true height="17.5rem" min-height="0px" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" background-color="ui.background"
        for message in messages key=message.id
          view padding="ui.space-8 ui.space-12"
            Message(id=id + "-message-" + message.id.toString(), author=(message.mine ? "You" : "Assistant"), initials=(message.mine ? "YO" : "AI"), time="", align=(message.mine ? "end" : "start"))
              text message.body testId=(id + "-message-" + message.id.toString() + "-body") max-width="90%" min-width="0px" padding="ui.space-8 ui.space-12" border-radius="ui.radius-panel" font-size="ui.text-sm" line-height="ui.leading-code" white-space="pre-wrap" overflow-wrap="break-word" background-color=(message.mine ? "ui.muted" : "transparent") color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

      row gap="ui.space-8" align-items="center" flex-wrap="wrap"
        input id=(id + "-draft") testId=(id + "-draft") class=Field value=draft input=edit submit=post placeholder="Your message…" aria-label="Your message" flex="1 1 10rem" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        Button(id=id + "-send", label="Send", variant="primary", disabled=(draft.trim() == ""), press=post)
      row justify-content="center"
        Button(id=id + "-latest", label="Latest message", variant="outline", disabled=false, press=latest)
