use uiFontFamily from "./typography-context.contract"
component CardFrame
  props
    id: string
  slot
  view
    column id=id testId=id gap="ui.space-24" padding="ui.space-24 0px" min-width="0px" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.panel-radius" background-color="ui.surface" color="ui.foreground" box-shadow="ui.shadow-control"
      children

component CardHeader
  props
    id: string
  slot
  view
    view id=id testId=id display="grid" grid-template-columns="minmax(0, 1fr) auto" grid-template-rows="auto auto" align-items="start" gap="ui.space-8" padding="0px ui.space-24" min-width="0px"
      children

component CardTitle
  props
    id: string
    title: string
    level: number
  inject
    uiFont: string
  view
    text title id=id testId=id grid-column="1" grid-row="1" min-width="0px" font-size="ui.text-base" line-height="ui.leading-solid" font-weight="ui.weight-semibold" role="heading" aria-level=level overflow-wrap="break-word" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component CardDescription
  props
    id: string
    description: string
  inject
    uiFont: string
  view
    text description id=id testId=id grid-column="1" grid-row="2" min-width="0px" font-size="ui.text-sm" line-height="ui.leading-normal" color="ui.muted-foreground" overflow-wrap="break-word" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component CardAction
  props
    id: string
  slot
  view
    view id=id testId=id grid-column="2" grid-row="1 / span 2" align-self="start" min-width="0px"
      children

component CardContent
  props
    id: string
  slot
  view
    column id=id testId=id padding="0px ui.space-24" min-width="0px"
      children

component CardFooter
  props
    id: string
    divided: bool
  slot
  view
    row id=id testId=id align-items="center" flex-wrap="wrap" padding=(divided ? "ui.space-24 ui.space-24 0px" : "0px ui.space-24") border-top-width=(divided ? "ui.border-width" : "0px") border-top-style=(divided ? "solid" : "solid") border-top-color=(divided ? "ui.border" : "transparent") min-width="0px"
      children

component AvatarFrame
  props
    id: string
    name: string
    src: string
    fallback: string
    size: string
  inject
    uiFont: string
  slot
  state failedSource = ""
  action markImageFailed(source: string, message: string)
    failedSource = source
  view
    view id=id testId=id position="relative" width=(size == "sm" ? "ui.space-24" : size == "lg" ? "ui.space-40" : "ui.space-32") height=(size == "sm" ? "ui.space-24" : size == "lg" ? "ui.space-40" : "ui.space-32") flex-shrink=0
      view width="100%" height="100%" overflow="hidden" border-radius="ui.radius-full" background-color="ui.muted" display="flex" align-items="center" justify-content="center" role="img" aria-label=name
        if src != "" and failedSource != src
          image src alt="" width="100%" height="100%" object-fit="cover" error=markImageFailed(src)
        else
          text fallback aria-hidden=true font-size=(size == "sm" ? "ui.text-xs" : "ui.text-sm") color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      children

component AvatarBadge
  props
    id: string
    label: string
    size: string
  slot
  view
    view id=id testId=id role="img" aria-label=label position="absolute" right="0px" bottom="0px" z-index=10 width=(size == "sm" ? "ui.space-8" : size == "lg" ? "ui.space-12" : "ui.space-10") height=(size == "sm" ? "ui.space-8" : size == "lg" ? "ui.space-12" : "ui.space-10") border-radius="ui.radius-full" background-color="ui.primary" color="ui.primary-foreground" box-shadow="ui.shadow-background-ring" display="flex" align-items="center" justify-content="center"
      if size != "sm"
        children

component AvatarGroup
  props
    id: string
    label: string
  slot
  view
    row id=id testId=id role="group" aria-label=label align-items="center" padding="ui.space-2"
      children

component AvatarGroupItem
  props
    id: string
    first: bool
  slot
  view
    view id=id testId=id margin-left=(first ? "0px" : "ui.space-negative-8") border-radius="ui.radius-full" box-shadow="ui.shadow-background-ring" flex-shrink=0
      children

component AvatarGroupCount
  props
    id: string
    label: string
    count: number
    size: string
    first: bool
  inject
    uiFont: string
  view
    view id=id testId=id role="img" aria-label=label margin-left=(first ? "0px" : "ui.space-negative-8") width=(size == "sm" ? "ui.space-24" : size == "lg" ? "ui.space-40" : "ui.space-32") height=(size == "sm" ? "ui.space-24" : size == "lg" ? "ui.space-40" : "ui.space-32") border-radius="ui.radius-full" background-color="ui.muted" box-shadow="ui.shadow-background-ring" display="flex" align-items="center" justify-content="center" flex-shrink=0
      text ("+" + max(0, floor(count)).toString()) aria-hidden=true font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component FieldSet
  props
    id: string
    legendId: string
    descriptionId: string
    disabled: bool
  slot
  view
    column id=id testId=id role="group" aria-labelledby=legendId aria-describedby=descriptionId aria-disabled=disabled gap="ui.space-24" min-width="0px"
      children

component FieldLegend
  props
    id: string
    label: string
    variant: string
  inject
    uiFont: string
  view
    text label id=id testId=id margin-bottom="ui.space-12" font-size=(variant == "label" ? "ui.text-sm" : "ui.text-base") font-weight="ui.weight-medium" line-height="ui.leading-normal" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component FieldGroup
  props
    id: string
    nested: bool
  slot
  view
    column id=id testId=id gap=(nested ? "ui.space-16" : "ui.space-28") min-width="0px"
      children

component FieldFrame
  props
    id: string
    labelId: string
    descriptionId: string
    invalid: bool
    orientation: string
  slot
  view
    view id=id testId=id role="group" aria-labelledby=labelId aria-describedby=descriptionId aria-invalid=invalid display="flex" flex-direction=(orientation == "horizontal" ? "row" : "column") align-items=(orientation == "horizontal" ? "center" : "stretch") gap="ui.space-12" min-width="0px" color=(invalid ? "ui.danger" : "ui.foreground")
      children

component FieldContent
  props
    id: string
  slot
  view
    column id=id testId=id flex=1 gap="ui.space-6" min-width="0px" line-height="ui.leading-compact"
      children

component FieldLabel
  props
    id: string
    label: string
    controlId: string
    disabled: bool
  inject
    uiFont: string
  action activate
    if not disabled
      focus(controlId)
  view
    text label id=id testId=id press=activate font-size="ui.text-sm" font-weight="ui.weight-medium" line-height="ui.leading-compact" color="ui.foreground" opacity=(disabled ? "ui.opacity-disabled" : 1) font-family=uiFontFamily(uiFont) data-rightui-font="body"

component FieldTitle
  props
    id: string
    title: string
    disabled: bool
  inject
    uiFont: string
  view
    text title id=id testId=id font-size="ui.text-sm" font-weight="ui.weight-medium" line-height="ui.leading-compact" color="ui.foreground" opacity=(disabled ? "ui.opacity-disabled" : 1) font-family=uiFontFamily(uiFont) data-rightui-font="body"

component FieldDescription
  props
    id: string
    description: string
  inject
    uiFont: string
  view
    text description id=id testId=id font-size="ui.text-sm" line-height="ui.leading-normal" color="ui.muted-foreground" overflow-wrap="break-word" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component FieldError
  props
    id: string
    messages: string[]
  inject
    uiFont: string
  derive unique = messages.filter((message, index) => message.trim() != "" and messages.indexOf(message) == index)
  view
    if unique.length > 0
      column id=id testId=id role="alert" gap="ui.space-4" font-size="ui.text-sm" font-weight="ui.weight-regular" color="ui.danger"
        if unique.length == 1
          text unique.join("") testId=(id + "-message-0") overflow-wrap="break-word" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        else
          column role="list" gap="ui.space-4" padding-left="ui.space-16"
            for message, i in unique key=message
              text ("• " + message) testId=(id + "-message-" + i.toString()) role="listitem" overflow-wrap="break-word" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component FieldSeparator
  props
    id: string
    label: string
  inject
    uiFont: string
  view
    row id=id testId=id role="separator" aria-orientation="horizontal" aria-label=label align-items="center" min-height="ui.space-20" margin="ui.space-negative-8 0px"
      view height="ui.border-width" background-color="ui.border" flex=1 aria-hidden=true
      if label != ""
        text label padding="0px ui.space-8" font-size="ui.text-sm" line-height="ui.leading-normal" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        view height="ui.border-width" background-color="ui.border" flex=1 aria-hidden=true

component ButtonGroupText
  props
    id: string
  slot
  view
    row id=id testId=id align-items="center" gap="ui.space-8" min-height="ui.space-36" padding="0px ui.space-16" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" background-color="ui.muted" font-size="ui.text-sm" font-weight="ui.weight-medium" color="ui.foreground" box-shadow="ui.shadow-control"
      children

component ButtonGroupSeparator
  props
    vertical: bool
  view
    view role="separator" aria-orientation=(vertical ? "vertical" : "horizontal") align-self="stretch" flex-shrink=0 width=(vertical ? "ui.space-1" : "100%") height=(vertical ? "auto" : "ui.space-1") background-color="ui.input"

component KbdGroup
  props
    id: string
    label: string
  slot
  view
    row id=id testId=id role="group" aria-label=label align-items="center" gap="ui.space-4"
      children
