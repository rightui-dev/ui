use uiFontFamily from "./typography-context.contract"
keyframes uiSkeletonPulse
  from opacity=1
  50% opacity=0.5
  to opacity=1

component Alert
  props
    id: string
    title: string
    description: string
    variant: string
  inject
    uiFont: string
  view
    row id=id testId=id role="status" gap="ui.space-12" padding="ui.space-12 ui.space-16" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" min-width="0px" background-color="ui.surface"
      svg width="ui.space-16" height="ui.space-16" margin-top="ui.space-2" flex-shrink=0 viewBox="0 0 24 24" fill="none" stroke=((variant == "danger" or variant == "destructive") ? "ui.danger" : "ui.foreground") stroke-width="ui.stroke-medium" aria-hidden=true
        circle cx=12 cy=12 r=9
        path d="M12 7v6m0 3v1"
      column gap="ui.space-2" min-width="0px"
        text title font-size="ui.text-sm" font-weight="ui.weight-medium" color=((variant == "danger" or variant == "destructive") ? "ui.danger" : "ui.foreground") font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text description font-size="ui.text-sm" line-height="ui.leading-normal" color=((variant == "danger" or variant == "destructive") ? "ui.danger" : "ui.muted-foreground") hyphens="auto" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component Avatar
  props
    id: string
    src: string
    name: string
    fallback: string
  inject
    uiFont: string
  state failedSource = ""
  action markFailed(source: string, message: string)
    failedSource = source
  view
    view id=id testId=id role="img" aria-label=name width="ui.space-32" height="ui.space-32" flex-shrink=0 border-radius="ui.radius-full" overflow="hidden" background-color="ui.muted" display="flex" align-items="center" justify-content="center"
      if src != "" and failedSource != src
        image src alt=name width="100%" height="100%" object-fit="cover" error=markFailed(src)
      else
        text fallback aria-hidden=true font-size="ui.text-sm" font-weight="ui.weight-regular" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component Progress
  props
    id: string
    label: string
    value: number
  inject
    uiFont: string
  derive bounded = max(0, min(100, value))
  view
    column gap="ui.space-8" min-width="0px"
      row justify-content="space-between" gap="ui.space-12" flex-wrap="wrap"
        text label font-size="ui.text-caption" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text (bounded.toFixed(0) + " %") testId=(id + "-value") font-size="ui.text-caption" font-variant-numeric="tabular-nums" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      ProgressTrack(id=id, label=label, value=bounded)

component ProgressTrack
  props
    id: string
    label: string
    value: number
  derive bounded = max(0, min(100, value))
  view
    view id=id testId=id role="progressbar" aria-label=label aria-valuemin=0 aria-valuemax=100 aria-valuenow=bounded height="ui.space-8" border-radius="ui.radius-control" background-color="ui.muted" overflow="hidden"
      view width=(bounded.toString() + "%") height="100%" background-color="ui.primary"

component Separator
  props
    vertical: bool
  view
    view role="separator" aria-orientation=(vertical ? "vertical" : "horizontal") flex-shrink=0
      width=(vertical ? "ui.border-width" : "100%") height=(vertical ? "100%" : "ui.border-width") background-color="ui.border"

component Skeleton
  props
    id: string
    label: string
    reduced: bool
  view
    column id=id testId=id role="status" aria-label=label gap="ui.space-12" animation=(reduced ? "none" : "uiSkeletonPulse ui.duration-shimmer ui.easing infinite")
      view height="ui.space-16" width="60%" border-radius="ui.radius-md" background-color="ui.muted" aria-hidden=true
      view height="ui.space-12" width="100%" border-radius="ui.radius-md" background-color="ui.muted" aria-hidden=true
      view height="ui.space-12" width="85%" border-radius="ui.radius-md" background-color="ui.muted" aria-hidden=true

component Kbd
  props
    label: string
  inject
    uiFont: string
  view
    text label display="flex" align-items="center" justify-content="center" min-width="ui.space-20" height="ui.space-20" box-sizing="border-box" font-family=uiFontFamily(uiFont) data-rightui-font="body" font-size="ui.text-xs" font-weight="ui.weight-medium" line-height="ui.leading-normal" padding="0px ui.space-4" background-color="ui.muted" color="ui.muted-foreground" border-radius="ui.radius-sm"

component Empty
  props
    id: string
    title: string
    description: string
  inject
    uiFont: string
  slot
  view
    column id=id testId=id align-items="center" justify-content="center" gap="ui.space-24" padding="ui.space-24" border-width="ui.border-width" border-style="dashed" border-color="ui.border" border-radius="ui.radius-panel" min-width="0px"
      svg width="ui.space-32" height="ui.space-32" viewBox="0 0 24 24" stroke="ui.muted-foreground" stroke-width="ui.stroke-medium" fill="none" aria-hidden=true
        path d="M3 7h7l2 2h9v11H3ZM3 7V4h7l2 3"
      text title font-size="ui.text-lg" font-weight="ui.weight-medium" text-align="center" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text description font-size="ui.text-sm" line-height="ui.leading-normal" text-align="center" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      children

component AspectRatio
  props
    ratio: number
  slot
  view
    view aspect-ratio=max(0.1, ratio) width="100%" min-width="0px" position="relative" overflow="hidden" border-radius="ui.radius-control"
      children

component Item
  props
    id: string
    title: string
    description: string
  inject
    uiFont: string
  slot
  view
    row id=id testId=id flex-wrap="wrap" align-items="center" gap="ui.space-16" padding="ui.space-16" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control"
      column flex="1 1 10rem" min-width="0px" gap="ui.space-4"
        text title font-size="ui.text-sm" font-weight="ui.weight-semibold" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text description font-size="ui.text-caption" line-height="ui.leading-normal" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      children

component ScrollArea
  props
    id: string
    label: string
    height: number
  slot
  view
    scroll id=id testId=id aria-label=label tabindex=0 height=height min-width="0px" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control"
      :focus-visible
        box-shadow="ui.shadow-focus"
      column padding="ui.space-16" gap="ui.space-12" min-width="0px"
        children

shape TableRow
  id: string
  cells: string[]

component Table
  props
    id: string
    label: string
    headers: string[]
    rows: TableRow[]
  inject
    uiFont: string
  view
    scroll id=(id + "-scroll") aria-label=(label + ": horizontal scrolling") tabindex=0 min-width="0px" max-height="30rem"
      table id=id testId=id aria-label=label width="100%" border-spacing=0 font-size="ui.text-sm" color="ui.foreground"
        thead
          tr
            for heading in headers key=heading
              th scope="col" height="ui.space-40" padding="0px ui.space-8" text-align="left" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" color="ui.foreground" font-weight="ui.weight-medium"
                text heading font-family=uiFontFamily(uiFont) data-rightui-font="body"
        tbody
          for row in rows key=row.id
            tr
              :hover
                background-color="ui.muted"
              for heading, j in headers key=heading
                td padding="ui.space-8" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" font-variant-numeric="tabular-nums"
                  match row.cells.at(j)
                    case some(cell)
                      text cell font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    case none
                      text "" font-family=uiFontFamily(uiFont) data-rightui-font="body"
