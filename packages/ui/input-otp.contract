component InputOTP
  props
    id: string
    label: string
    value: string
    length: number
    disabled: bool
    change: action
  derive size = max(1, min(8, length))
  derive digits = value.split("").filter(c => "0123456789".includes(c)).join("").slice(0, size)
  action edit(v: string)
    change(v.split("").filter(c => "0123456789".includes(c)).join("").slice(0, size))
  view
    column gap=8 min-width=0
      text label id=(id + "-label") font-size="0.875rem" font-weight=500 color="ui.foreground"
      view position="relative" align-self="flex-start" min-width=0 max-width="100%"
        row aria-hidden=true gap=0 pointer-events="none" border-radius="ui.radius-control" overflow="hidden"
          for i in [0, 1, 2, 3, 4, 5, 6, 7].slice(0, size) key=i
            view width="2.25rem" height="2.25rem" display="flex" align-items="center" justify-content="center" border="1px solid ui.border" background-color="ui.surface" color="ui.foreground" font-size="0.875rem"
              text digits.slice(i, i + 1)
        input id=id testId=id value=digits input=edit disabled=disabled inputmode="numeric" autocomplete="one-time-code" aria-labelledby=(id + "-label")
          position="absolute" inset=0 width="100%" height="100%" box-sizing="border-box" appearance="none" border="0" border-radius="ui.radius-control" background-color="transparent" color="transparent" caret-color="ui.foreground" font-size="0.875rem" letter-spacing="1.6875rem" padding="0px 0.75rem"
          :focus-visible
            box-shadow="0 0 0 3px ui.ring"
