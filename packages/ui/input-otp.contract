use FontWeights from "./typography-context.contract"
use uiFontFamily from "./typography-context.contract"
component InputOTP
  props
    id: string
    label: string
    value: string
    length: number
    disabled: bool
    change: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state cellWidth = 36
  state glyphWidth = 9
  action measureCell(w: number, h: number)
    cellWidth = w
  action measureGlyph(w: number, h: number)
    glyphWidth = w
  derive size = max(1, min(8, length))
  derive digits = value.split("").filter(c => "0123456789".includes(c)).join("").slice(0, size)
  action edit(v: string)
    change(v.split("").filter(c => "0123456789".includes(c)).join("").slice(0, size))
  view
    column gap="ui.space-8" min-width="0px"
      text label id=(id + "-label") font-size="ui.text-sm" font-weight=uiWeights.medium color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      view position="relative" align-self="flex-start" min-width="0px" max-width="100%"
        row aria-hidden=true gap="0px" pointer-events="none" border-radius="ui.radius-control" overflow="hidden"
          for i in [0, 1, 2, 3, 4, 5, 6, 7].slice(0, size) key=i
            view width="ui.space-36" height="ui.space-36" position="relative" resize=measureCell
              view position="absolute" inset=0 display="flex" align-items="center" justify-content="center" border-width="ui.border-width" border-style="solid" border-color="ui.border" background-color="ui.surface" color="ui.foreground" font-size="ui.text-sm"
                text digits.slice(i, i + 1) font-family=uiFontFamily(uiFont) data-rightui-font="body" font-variant-numeric="tabular-nums"
        text "0" position="absolute" left=0 top=0 opacity=0 aria-hidden=true pointer-events="none" font-family=uiFontFamily(uiFont) data-rightui-font="body" font-size="ui.text-sm" font-variant-numeric="tabular-nums" resize=measureGlyph
        input id=id testId=id value=digits input=edit disabled=disabled inputmode="numeric" autocomplete="one-time-code" aria-labelledby=(id + "-label") font-family=uiFontFamily(uiFont) data-rightui-font="body"
          position="absolute" inset=0 width="100%" height="100%" box-sizing="border-box" appearance="none" border="0" border-radius="ui.radius-control" background-color="transparent" color="transparent" caret-color="ui.foreground" font-size="ui.text-sm" letter-spacing=max(0, cellWidth - glyphWidth) padding-top=0 padding-bottom=0 padding-left=max(0, (cellWidth - glyphWidth) / 2) padding-right=max(0, (cellWidth - glyphWidth) / 2) font-variant-numeric="tabular-nums"
          :focus-visible
            box-shadow="ui.shadow-focus"
