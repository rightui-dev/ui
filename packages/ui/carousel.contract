use CarouselTrack, CarouselSlide from "./layout-advanced.contract"
use FontWeights from "./typography-context.contract"
use uiFontFamily from "./typography-context.contract"
use Control, CardStyle from "./styles.contract"
component Carousel
  props
    id: string
    slides: string[]
    loop: bool
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  state index = 0
  derive total = slides.length
  derive currentIndex = max(0, min(total - 1, index))
  action choose(i: number)
    index = i
  view
    column min-width=0 gap="ui.space-8"
      CarouselTrack(id=id, label="Featured slides", value=currentIndex, count=total, orientation="horizontal", height=220, loop=loop, reduced=reduced, change=choose, visible=1, rtl=false, showPosition=true, fullWidth=false, showControls=true)
        for slide, i in slides key=i
          CarouselSlide(id=id + "-slide-" + i.toString(), label=slide, index=i, value=currentIndex, count=total, orientation="horizontal", height=220, reduced=reduced, visible=1, rtl=false)
            column class=CardStyle height="100%" align-items="center" justify-content="center"
              text (i + 1).toString() font-size="ui.text-display" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text slide font-size="ui.text-base" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      row gap="ui.space-8" align-items="center" flex-wrap="wrap" justify-content="center"
        for slide, i in slides key=i
          button class=Control font-weight=uiWeights.medium id=(id + "-dot-" + i.toString()) testId=(id + "-dot-" + i.toString()) press=choose(i) aria-label=("Go to slide " + (i + 1).toString()) aria-pressed=(currentIndex == i)
            padding="0px" width="ui.space-24" height="ui.space-24" min-height="ui.space-24" border="0" background-color="transparent" display="flex" align-items="center" justify-content="center"
            view width="ui.space-8" height="ui.space-8" border-radius="ui.radius-full" background-color=(currentIndex == i ? "ui.primary" : "ui.border")
