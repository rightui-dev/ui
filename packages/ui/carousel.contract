use Control from "./styles.contract"
component Carousel
  props
    id: string
    slides: string[]
    loop: bool
    reduced: bool
  state index = 0
  state pointer = -1
  state start = 0
  state distance = 0
  state swiped = false
  derive total = slides.length
  derive currentIndex = max(0, min(total - 1, index))
  action move(delta: number)
    if total > 0
      index = loop ? (currentIndex + delta + total) % total : max(0, min(total - 1, currentIndex + delta))
  action choose(i: number)
    index = i
  action keys(k: string)
    if k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End"
      preventDefault()
      if k == "Home" or k == "End"
        index = k == "Home" ? 0 : max(0, total - 1)
      else
        move(k == "ArrowLeft" ? -1 : 1)
  action begin(e: PointerEvent)
    if e.button == 0
      pointer = e.pointerId
      start = e.clientX
      distance = 0
      swiped = false
  action drag(dx: number, dy: number)
    let next = distance + dx
    distance = next
    if not swiped and max(next, -next) > 40 and max(next, -next) > max(dy, -dy)
      swiped = true
      move(next < 0 ? 1 : -1)
  action end(e: PointerEvent)
    if e.pointerId == pointer
      pointer = -1
      if not swiped and max(e.clientX - start, start - e.clientX) > 40
        move(e.clientX < start ? 1 : -1)
  view
    column id=id testId=id role="region" aria-label="Featured slides" tabindex=0 key=keys gap=16 min-width=0
      :focus-visible
        box-shadow="0 0 0 3px ui.ring"
      view overflow="hidden" min-width=0 border="1px solid ui.border" border-radius="ui.radius-control" touch-action="pan-y" pointerdown=begin pointerup=end pan=drag user-select="none"
        if total == 0
          text "No slides." padding=48 text-align="center" color="ui.muted-foreground"
        view display="grid" grid-template-columns="minmax(0, 1fr)" width="100%" min-width=0
          for slide, i in slides key=i
            column testId=(id + "-slide-" + i.toString()) role="group" aria-label=((i + 1).toString() + " of " + total.toString()) aria-hidden=(i != currentIndex)
              grid-column="1" grid-row="1" width="100%" min-width=0 box-sizing="border-box" min-height="13.75rem" padding="2rem"
              translate=(((i - currentIndex) * 100).toString() + "% 0px") transition=(reduced ? "none" : "translate 220ms cubic-bezier(0.22, 1, 0.36, 1)") align-items="center" justify-content="center" gap=12 background-color="transparent" color="ui.foreground"
              text (i + 1).toString() font-size="3rem" font-weight=600
              text slide font-size="1rem" text-align="center"
      row justify-content="space-between" align-items="center" gap=12 flex-wrap="wrap"
        button id=(id + "-previous") testId=(id + "-previous") class=Control press=move(-1) disabled=(total == 0 or (not loop and currentIndex == 0)) aria-label="Previous slide" width=36 height=36 min-height=36 padding=0 border="1px solid ui.border" border-radius="ui.radius-full" background-color="ui.surface" color="ui.foreground"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width=2 aria-hidden=true
            path d="M19 12H5m7-7-7 7 7 7"
        row gap=8 align-items="center" flex-wrap="wrap" flex="1 1 7rem" justify-content="center"
          for slide, i in slides key=i
            button class=Control id=(id + "-dot-" + i.toString()) testId=(id + "-dot-" + i.toString()) press=choose(i) aria-label=("Go to slide " + (i + 1).toString()) aria-pressed=(currentIndex == i)
              padding=0 width=24 height=24 min-height=24 border="0" background-color="transparent" display="flex" align-items="center" justify-content="center"
              view width=8 height=8 border-radius="ui.radius-full" background-color=(currentIndex == i ? "ui.primary" : "ui.border")
        button id=(id + "-next") testId=(id + "-next") class=Control press=move(1) disabled=(total == 0 or (not loop and currentIndex >= total - 1)) aria-label="Next slide" width=36 height=36 min-height=36 padding=0 border="1px solid ui.border" border-radius="ui.radius-full" background-color="ui.surface" color="ui.foreground"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width=2 aria-hidden=true
            path d="M5 12h14m-7-7 7 7-7 7"
      text (total == 0 ? "0 slides" : "Slide " + (currentIndex + 1).toString() + " of " + total.toString()) testId=(id + "-position") aria-live="polite" font-size="0.75rem" color="ui.muted-foreground" text-align="center"
