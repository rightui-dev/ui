use Control from "./styles.contract"
use uiPopupIn, uiPopupOut from "./popup-motion.contract"

shape MenuEntry
  id: string
  label: string
  shortcut: string
  disabled: bool
  destructive: bool

component ActionMenu
  props
    id: string
    label: string
    entries: MenuEntry[]
    contextual: bool
    reduced: bool
    choose: action
  state expanded = false
  state openEpoch = 0
  state contextFocus = false
  derive enabled = entries.filter(item => not item.disabled)
  action open
    contextFocus = false
    openEpoch = openEpoch + 1
    expanded = true
    showPopover(id + "-menu", source=id)
    match first(enabled)
      case some(item)
        focus(id + "-item-" + item.id)
      case none
        focus(id + "-menu")
  action closeMenu
    expanded = false
    focus(id)
  action toggle
    if expanded
      closeMenu()
    else
      open()
  action context
    if contextual
      openEpoch = openEpoch + 1
      expanded = true
      contextFocus = true
  action changed(epoch: number, e: ToggleEvent)
    if epoch == openEpoch
      expanded = e.newState == "open"
      if e.newState == "open" and contextFocus
        match first(enabled)
          case some(item)
            focus(id + "-item-" + item.id)
          case none
            focus(id + "-menu")
      contextFocus = false

  action pick(item: MenuEntry)
    if not item.disabled
      closeMenu()
      choose(item.id)
  action triggerKeys(k: string, e: KeyboardEvent)
    if k == "ArrowDown" or k == "ArrowUp" or k == "ContextMenu" or (k == "F10" and e.shiftKey)
      preventDefault()
      open()
      if k == "ArrowUp"
        match enabled.at(enabled.length - 1)
          case some(item)
            focus(id + "-item-" + item.id)
          case none
            focus(id + "-menu")
  action menuKeys(k: string)
    if k == "Escape"
      preventDefault()
      stopPropagation()
      closeMenu()
    else if k == "Tab"
      closeMenu()
  action itemKeys(itemId: string, k: string, e: KeyboardEvent)
    if not e.isComposing
      let index = enabled.map(item => item.id).indexOf(itemId)
      if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
        preventDefault()
        let next = (k == "Home" ? 0 : k == "End" ? enabled.length - 1 : (index + (k == "ArrowDown" ? 1 : enabled.length - 1)) % max(1, enabled.length))
        match enabled.at(next)
          case some(item)
            focus(id + "-item-" + item.id)
          case none
            focus(id + "-menu")
      else if k == "Enter" or k == " "
        preventDefault()
        match enabled.at(index)
          case some(item)
            pick(item)
          case none
            closeMenu()
      else if k.length == 1 and not e.metaKey and not e.ctrlKey and not e.altKey
        match first(enabled.filter(item => item.label.toLowerCase().startsWith(k.toLowerCase())))
          case some(item)
            preventDefault()
            focus(id + "-item-" + item.id)
          case none
            stopPropagation()
  view
    column min-width=0 align-items="flex-start"
      button id=id testId=id class=Control press=toggle contextmenu=context key=triggerKeys
        contextPopover=(contextual ? id + "-menu" : "")
        aria-haspopup="menu" aria-expanded=expanded aria-controls=(id + "-menu")
        padding=(contextual ? "24px 16px" : "8px 16px") border=(contextual ? "1px dashed ui.border" : "1px solid ui.border")
        background-color="ui.surface" color="ui.foreground"
        text label text-align="left"
      if expanded
        for epoch in [openEpoch] key=epoch
          column id=(id + "-menu") testId=(id + "-menu") popover="auto" toggle=changed(epoch) keycapture=menuKeys
            role="menu" aria-label=label tabindex=-1
            left="auto" top="auto" position-area="bottom" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline"
            width="14rem" min-width=0 max-width="calc(100vw - 32px)" max-height="min(28rem, 70vh)" overflow="auto" box-sizing="border-box"
            margin=4 padding=4 gap=0 border="1px solid ui.border" border-radius="ui.radius-menu" background-color="ui.surface" box-shadow="0 4px 6px -1px #0000001a, 0 2px 4px -2px #0000001a"
            animation=(reduced ? "none" : "uiPopupIn 150ms ease-out both")
            -exact-exit-animation=(reduced ? "none" : "uiPopupOut 100ms ease-in both")
            column role="none" align-items="stretch" gap=0 min-width=0
              for item in entries key=item.id
                button id=(id + "-item-" + item.id) testId=(id + "-item-" + item.id) class=Control
                  role="menuitem" tabindex=-1 disabled=item.disabled press=pick(item) key=itemKeys(item.id)
                  display="flex" width="100%" box-sizing="border-box" align-items="center" flex-wrap="wrap" gap=8 min-height=32 padding="6px 8px" border="0" border-radius="ui.radius-item" font-weight=400 background-color="transparent"
                  color=(item.destructive ? "ui.danger" : "ui.foreground")
                  :hover
                    background-color="ui.muted"
                  :focus-visible
                    background-color="ui.muted"
                  text item.label flex="1 1 6rem" min-width=0 text-align="left"
                  if item.shortcut != ""
                    text item.shortcut min-width=0 hyphens="auto" font-size="0.75rem" letter-spacing="0.1em" color="ui.muted-foreground" aria-hidden=true

component DropdownMenu
  props
    id: string
    label: string
    entries: MenuEntry[]
    reduced: bool
    choose: action
  view
    ActionMenu(id=id, label=label, entries=entries, contextual=false, reduced=reduced, choose=choose)

component ContextMenu
  props
    id: string
    label: string
    entries: MenuEntry[]
    reduced: bool
    choose: action
  view
    ActionMenu(id=id, label=label, entries=entries, contextual=true, reduced=reduced, choose=choose)
