use uiFontFamily from "./typography-context.contract"
component Tabs
  props
    id: string
    labels: string[]
    selected: number
    reduced: bool
    choose: action
  view
    TabStrip(id=id, labels=labels, counts=[], selected=selected, reduced=reduced, choose=choose, variant="default", vertical=false, compact=true, disabledIndices=[], direction="ltr", label="Sections")

component CountedTabs
  props
    id: string
    labels: string[]
    counts: string[]
    selected: number
    reduced: bool
    choose: action
  view
    TabStrip(id=id, labels=labels, counts=counts, selected=selected, reduced=reduced, choose=choose, variant="default", vertical=false, compact=false, disabledIndices=[], direction="ltr", label="Sections")

component TabsAdvanced
  props
    id: string
    label: string
    labels: string[]
    counts: string[]
    selected: number
    variant: string
    vertical: bool
    compact: bool
    disabledIndices: number[]
    direction: string
    reduced: bool
    choose: action
  view
    TabStrip(id=id, labels=labels, counts=counts, selected=selected, reduced=reduced, choose=choose, variant=variant, vertical=vertical, compact=compact, disabledIndices=disabledIndices, direction=direction, label=label)

component TabStrip
  props
    id: string
    label: string
    labels: string[]
    counts: string[]
    selected: number
    reduced: bool
    choose: action
    variant: string
    vertical: bool
    compact: bool
    disabledIndices: number[]
    direction: string
  inject
    uiFont: string
  state markerX = 0
  state markerY = 0
  state markerWidth = 0
  state markerHeight = 0
  state ready = false
  state hairline = 1
  state lineThickness = 2
  action measureStroke(w: number, h: number)
    hairline = w
    lineThickness = h
  derive valid = selected >= 0 and selected < labels.length
  derive enabled = range(labels.length).filter(i => not disabledIndices.includes(i))
  derive measurementKey = selected.toString() + "|" + labels.map(v => v.length.toString() + ":" + v).join("") + "|" + counts.map(v => v.length.toString() + ":" + v).join("") + "|" + variant + "|" + vertical.toString() + "|" + compact.toString() + "|" + direction
  action measure(w: number, h: number)
    if valid
      let container = frame(id)
      let target = frame(id + "-" + selected.toString())
      if container.width > 0 and target.width > 0 and target.height > 0
        markerX = target.x - container.x
        markerY = target.y - container.y
        markerWidth = target.width
        markerHeight = target.height
        ready = true
      else
        ready = false
    else
      ready = false
  action pick(i: number)
    if not disabledIndices.includes(i)
      choose(i)
  action keys(k: string)
    let forward = vertical ? k == "ArrowDown" : direction == "rtl" ? k == "ArrowLeft" : k == "ArrowRight"
    let backward = vertical ? k == "ArrowUp" : direction == "rtl" ? k == "ArrowRight" : k == "ArrowLeft"
    if enabled.length > 0 and (forward or backward or k == "Home" or k == "End")
      preventDefault()
      let current = enabled.indexOf(selected)
      let position = k == "Home" ? 0 : k == "End" ? enabled.length - 1 : forward ? (current + 1) % enabled.length : (max(0, current) + enabled.length - 1) % enabled.length
      match enabled.at(position)
        case some(next)
          choose(next)
          focus(id + "-" + next.toString())
        case none
          ready = false
  view
    scroll id=(id + "-viewport") testId=(id + "-viewport") max-width="calc(100% + ui.space-8)" min-width="0px" align-self="flex-start" overflow-x="auto" overflow-y="hidden" padding="ui.space-4" margin="ui.space-negative-4" box-sizing="border-box" -webkit-font-smoothing="antialiased"
      view id=id testId=id resize=measure position="relative" display="flex" flex-direction=(vertical ? "column" : "row") flex-wrap="nowrap" role="tablist" aria-label=label aria-orientation=(vertical ? "vertical" : "horizontal") direction=direction appearance="none" padding="ui.space-3" gap=(variant == "line" ? "ui.space-4" : "0px")
        background-color=(variant == "line" ? "transparent" : "ui.muted") border="0" border-radius=(variant == "line" ? "0px" : "ui.radius-control") width="auto" min-width="0px" align-items=(vertical ? "stretch" : "center") height=(vertical ? "auto" : compact ? "ui.space-32" : "ui.space-36") box-sizing="border-box"
        view position="absolute" width="ui.border-width" height="ui.border-strong-width" opacity=0 aria-hidden=true pointer-events="none" resize=measureStroke
        if ready and valid
          view id=(id + "-indicator") testId=(id + "-indicator") aria-hidden=true pointer-events="none"
            position="absolute" left=(variant == "line" ? vertical ? markerX + markerWidth + hairline : markerX + hairline : markerX) top=(variant == "line" ? vertical ? markerY + hairline : markerY + markerHeight + lineThickness : markerY)
            width=(variant == "line" ? vertical ? "ui.border-strong-width" : max(0, markerWidth - 2 * hairline) : markerWidth) height=(variant == "line" ? vertical ? max(0, markerHeight - 2 * hairline) : "ui.border-strong-width" : markerHeight)
            border-radius=(variant == "line" ? "0px" : "ui.radius-item") background-color=(variant == "line" ? "ui.foreground" : "ui.tab-active") border-width=(variant == "line" ? "0px" : "ui.border-width") border-style="solid" border-color="ui.tab-active-border" box-sizing="border-box"
            box-shadow=(variant == "line" ? "none" : "ui.shadow-control")
            -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing")
        for caption, i in labels key=caption
          button id=(id + "-" + i.toString()) testId=(id + "-" + i.toString()) appearance="none" disabled=disabledIndices.includes(i)
            role="tab" aria-selected=(selected == i) aria-controls=(id + "-panel")
            tabindex=(not disabledIndices.includes(i) and (selected == i or not valid and enabled.indexOf(i) == 0) ? 0 : -1) key=keys press=pick(i)
            position="relative" flex="0 0 auto" box-sizing="border-box" display="flex" align-items="center" justify-content=(vertical ? "flex-start" : "center") gap="ui.space-6"
            min-width="auto" width="auto" height=(vertical ? compact ? "ui.tabs-height-vertical-compact" : "ui.tabs-height-vertical-default" : compact ? "ui.tabs-height-horizontal-compact" : "ui.tabs-height-horizontal-default") min-height="0px"
            border-width="ui.border-width" border-style="solid" border-color="transparent" border-radius="ui.radius-item" padding=(compact ? "ui.space-2 ui.space-6" : "ui.space-4 ui.space-8") white-space="nowrap"
            background-color=(not ready and selected == i and variant != "line" ? "ui.tab-active" : "transparent") cursor="pointer" pointer-events=(disabledIndices.includes(i) ? "none" : "auto")
            color=(selected == i ? "ui.foreground" : "ui.tab-inactive") font-size="ui.text-sm" line-height="ui.leading-control" font-weight="ui.weight-medium"
            transition=(reduced ? "none" : "color ui.duration-fast ui.easing, border-color ui.duration-fast ui.easing, box-shadow ui.duration-fast ui.easing")
            :focus-visible
              border-color="ui.focus"
              box-shadow="ui.shadow-focus"
            :hover
              color="ui.foreground"
            :disabled
              opacity="ui.opacity-disabled"
            text caption white-space="nowrap" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            match counts.at(i)
              case some(count)
                if count != ""
                  text count display="flex" align-items="center" justify-content="center" width="ui.space-20" min-width="ui.space-20" height="ui.space-20" box-sizing="border-box" padding="0px ui.space-4" border-width="ui.border-width" border-style="solid" border-color="transparent" border-radius="ui.radius-full" background-color="ui.tab-count" color="ui.foreground" font-size="ui.text-xs" line-height="ui.leading-heading" font-weight="ui.weight-medium" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              case none
                view display="none"
        for revision in [measurementKey] key=revision
          view resize=measure position="absolute" inset=0 pointer-events="none" aria-hidden=true
