use FontWeights from "./typography-context.contract"
use uiFontFamily from "./typography-context.contract"
use uiPopupIn, uiPopupOut from "./popup-motion.contract"
use Control from "./styles.contract"
shape NavigationMenuEntry
  id: string
  title: string
  description: string
  href: string
component NavigationMenu
  props
    id: string
    label: string
    entries: NavigationMenuEntry[]
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  state expanded = false
  state openEpoch = 0
  action show
    if not expanded
      openEpoch = openEpoch + 1
    expanded = true
    showPopover(id + "-content", source=id)
  action toggle
    if expanded
      expanded = false
    else
      show()
  action changed(epoch: number, e: ToggleEvent)
    if epoch == openEpoch
      expanded = e.newState == "open"

  action keys(k: string)
    if k == "Enter" or k == " "
      preventDefault()
      toggle()
    else if k == "Escape"
      preventDefault()
      expanded = false
      focus(id)
    else if k == "ArrowDown"
      preventDefault()
      show()
      match first(entries)
        case some(entry)
          focus(id + "-" + entry.id)
        case none
          focus(id)
  action linkKeys(index: number, k: string)
    stopPropagation()
    if k == "ArrowDown" or k == "ArrowUp" or k == "ArrowLeft" or k == "ArrowRight" or k == "Home" or k == "End"
      preventDefault()
      let next = (k == "Home" ? 0 : k == "End" ? entries.length - 1 : (index + (k == "ArrowDown" or k == "ArrowRight" ? 1 : entries.length - 1)) % max(1, entries.length))
      match entries.at(next)
        case some(entry)
          focus(id + "-" + entry.id)
        case none
          focus(id)
    else if k == "Escape"
      keys(k)
  view
    column role="navigation" aria-label=label align-items="flex-start"
      button id=id testId=id class=Control font-weight=uiWeights.medium press=toggle key=keys aria-expanded=expanded aria-controls=(id + "-content")
        display="flex" align-items="center" gap="ui.space-6" padding="ui.space-8 ui.space-16" border="0" background-color=(expanded ? "ui.muted" : "ui.surface") color="ui.foreground"
        text label font-family=uiFontFamily(uiFont) data-rightui-font="body"
        svg width="ui.space-12" height="ui.space-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.stroke-standard" aria-hidden=true
          path d="m6 9 6 6 6-6"
      if expanded
        for epoch in [openEpoch] key=epoch
          column id=(id + "-content") testId=(id + "-content") popover="auto" toggle=changed(epoch) key=keys
            position-area="bottom" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" margin="ui.space-4" width="25rem" max-width="calc(100vw - ui.space-32)" padding="ui.space-4" gap="ui.space-4" box-sizing="border-box"
            border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-menu" background-color="ui.surface" color="ui.foreground" box-shadow="ui.shadow-menu"
            animation=(reduced ? "none" : "uiPopupIn ui.duration-fast ui.easing both")
            -exact-exit-animation=(reduced ? "none" : "uiPopupOut ui.duration-fast ui.easing both")
            for entry, i in entries key=entry.id
              link id=(id + "-" + entry.id) testId=(id + "-" + entry.id) href=entry.href key=linkKeys(i)
                display="flex" flex-direction="column" gap="ui.space-4" padding="ui.space-12" border-radius="ui.radius-item" color="ui.foreground" text-decoration="none"
                :hover
                  background-color="ui.muted"
                :focus-visible
                  background-color="ui.muted"
                  box-shadow="ui.shadow-focus"
                text entry.title font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
                text entry.description font-size="ui.text-sm" line-height="ui.leading-snug" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

shape NavigationMenuSection
  id: string
  label: string
  href: string
  entries: NavigationMenuEntry[]
  layout: string

component NavigationMenuSections
  props
    id: string
    label: string
    sections: NavigationMenuSection[]
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  state active = -1
  state openEpoch = 0
  state hoverOpened = false
  action open(index: number)
    match sections.at(index)
      case some(section)
        if section.entries.length > 0
          if active < 0
            openEpoch = openEpoch + 1
          active = index
          showPopover(id + "-content", source=id + "-" + section.id)
      case none
        active = -1
  action dismissMenu
    active = -1
    hoverOpened = false
  action toggleSection(index: number)
    if active == index
      if hoverOpened
        hoverOpened = false
      else
        dismissMenu()
    else
      hoverOpened = false
      open(index)
  action triggerHover(index: number, inside: bool)
    if inside and active != index
      open(index)
      hoverOpened = true
  action changed(epoch: number, e: ToggleEvent)
    if epoch == openEpoch and e.newState == "closed"
      active = -1
  action triggerKeys(index: number, k: string)
    if k == "Enter" or k == " " or k == "ArrowDown"
      preventDefault()
      open(index)
      match sections.at(index)
        case some(section)
          match first(section.entries)
            case some(entry)
              focus(id + "-" + section.id + "-" + entry.id)
            case none
              focus(id + "-" + section.id)
        case none
          focus(id)
    else if k == "ArrowRight" or k == "ArrowLeft" or k == "Home" or k == "End"
      preventDefault()
      let next = (k == "Home" ? 0 : k == "End" ? sections.length - 1 : (index + (k == "ArrowRight" ? 1 : sections.length - 1)) % max(1, sections.length))
      match sections.at(next)
        case some(section)
          focus(id + "-" + section.id)
          if active >= 0
            open(next)
        case none
          focus(id)
    else if k == "Escape"
      preventDefault()
      dismissMenu()
      match sections.at(index)
        case some(section)
          focus(id + "-" + section.id)
        case none
          focus(id)
  action linkKeys(sectionIndex: number, index: number, k: string)
    stopPropagation()
    if k == "Escape"
      triggerKeys(sectionIndex, k)
    else if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
      preventDefault()
      match sections.at(sectionIndex)
        case some(section)
          let next = (k == "Home" ? 0 : k == "End" ? section.entries.length - 1 : (index + (k == "ArrowDown" ? 1 : section.entries.length - 1)) % max(1, section.entries.length))
          match section.entries.at(next)
            case some(entry)
              focus(id + "-" + section.id + "-" + entry.id)
            case none
              focus(id + "-" + section.id)
        case none
          focus(id)
    else if k == "ArrowRight" or k == "ArrowLeft"
      triggerKeys(sectionIndex, k)
  view
    row id=id testId=id role="navigation" aria-label=label align-items="center" flex-wrap="wrap" gap="ui.space-2" position="relative" max-width="100%"
      for section, i in sections key=section.id
        if section.entries.length > 0
          button id=(id + "-" + section.id) testId=(id + "-" + section.id) class=Control press=toggleSection(i) hover=triggerHover(i) key=triggerKeys(i) aria-expanded=(active == i) aria-controls=(id + "-content") aria-haspopup="true" popovertarget=(active >= 0 ? id + "-content" : "") popovertargetaction="show"
            display="flex" align-items="center" gap="ui.space-6" padding="ui.space-8 ui.space-12" border="0" border-radius="ui.radius-item" background-color=(active == i ? "ui.muted" : "transparent") color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.medium transition=(reduced ? "none" : "background-color ui.duration-fast ui.easing")
            :hover
              background-color="ui.muted"
            :focus-visible
              box-shadow="ui.shadow-focus"
            text section.label font-family=uiFontFamily(uiFont) data-rightui-font="body"
            svg width="ui.space-12" height="ui.space-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.stroke-standard" rotate=(active == i ? "180deg" : "0deg") transition=(reduced ? "none" : "rotate ui.duration-normal ui.easing") aria-hidden=true
              path d="m6 9 6 6 6-6"
        else
          link id=(id + "-" + section.id) testId=(id + "-" + section.id) href=section.href class=Control
            display="flex" align-items="center" padding="ui.space-8 ui.space-12" border-radius="ui.radius-item" color="ui.foreground" text-decoration="none" font-size="ui.text-sm" font-weight=uiWeights.medium
            :hover
              background-color="ui.muted"
            :focus-visible
              box-shadow="ui.shadow-focus"
            text section.label font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if active >= 0
        for epoch in [openEpoch] key=epoch
          column id=(id + "-content") testId=(id + "-content") role="region" aria-label=label popover="auto" toggle=changed(epoch) key=triggerKeys(active)
            position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" margin="ui.space-8 0px" width="calc(100% - ui.space-16)" max-width="min(36rem, calc(100vw - ui.space-32))" padding="ui.space-8" box-sizing="border-box" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-menu" background-color="ui.surface" color="ui.foreground" box-shadow="ui.shadow-menu" overflow="hidden"
            animation=(reduced ? "none" : "uiPopupIn ui.duration-fast ui.easing both")
            -exact-exit-animation=(reduced ? "none" : "uiPopupOut ui.duration-fast ui.easing both")
            -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing")
            for section, sectionIndex in sections key=section.id
              if active == sectionIndex
                row flex-wrap="wrap" gap="ui.space-4" min-width="0px" width="100%" -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing")
                  for entry, entryIndex in section.entries key=entry.id
                    link id=(id + "-" + section.id + "-" + entry.id) testId=(id + "-" + section.id + "-" + entry.id) href=entry.href key=linkKeys(sectionIndex, entryIndex)
                      display="flex" flex-direction="column" flex=(section.layout == "grid" ? "1 1 15rem" : "1 1 100%") box-sizing="border-box" gap="ui.space-4" padding="ui.space-12" border-radius="ui.radius-item" color="ui.foreground" text-decoration="none" min-width="0px"
                      :hover
                        background-color="ui.muted"
                      :focus-visible
                        background-color="ui.muted"
                        box-shadow="ui.shadow-focus"
                      text entry.title font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
                      text entry.description font-size="ui.text-sm" line-height="ui.leading-snug" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
