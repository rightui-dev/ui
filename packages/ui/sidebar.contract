use Control from "./styles.contract"
use DisclosureButton from "./button.contract"

shape SidebarEntry
  id: string
  label: string
  symbol: string

component Sidebar
  props
    id: string
    label: string
    entries: SidebarEntry[]
    selected: string
    collapsed: bool
    reduced: bool
    choose: action
    toggle: action
  view
    nav id=id testId=id aria-label=label display="flex" flex-direction="column" gap=8 padding=8 box-sizing="border-box"
      width=(collapsed ? "3rem" : "16rem") max-width="100%" flex-shrink=0 min-width=0
      -exact-layout-transition=(reduced ? "none" : "200ms linear")
      background-color="ui.muted" border="1px solid ui.border" border-radius="ui.panel-radius"
      SidebarTrigger(id=id + "-toggle", expanded=(not collapsed), controls=id + "-items", press=toggle)
      column id=(id + "-items") gap=4 min-width=0
        for item in entries key=item.id
          button id=(id + "-item-" + item.id) testId=(id + "-item-" + item.id) class=Control press=choose(item.id)
            aria-current=(selected == item.id ? "page" : "false") aria-label=item.label title=item.label
            display="flex" align-items="center" gap=8 min-height=32 padding="8px" border="0"
            background-color=(selected == item.id ? "ui.surface" : "transparent") color="ui.foreground"
            transition=(reduced ? "none" : "background-color 140ms ease-out")
            text item.symbol aria-hidden=true flex-shrink=0
            if not collapsed
              text item.label min-width=0 text-align="left"

component SidebarTrigger
  props
    id: string
    expanded: bool
    controls: string
    press: action
  view
    DisclosureButton(id=id, label="Toggle sidebar", variant="ghost", controls=controls, expanded=expanded, icon=true, press=press)
      svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
        rect x=3 y=3 width=18 height=18 rx=2
        path d="M9 3v18"
