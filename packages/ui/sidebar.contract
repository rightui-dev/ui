use FontWeights from "./typography-context.contract"
use uiFontFamily from "./typography-context.contract"
use Control from "./styles.contract"
use DisclosureButton from "./button.contract"

shape SidebarEntry
  id: string
  label: string
  symbol: string

component Sidebar
  props
    id: string
    label: string
    entries: SidebarEntry[]
    selected: string
    collapsed: bool
    reduced: bool
    choose: action
    toggle: action
  inject
    uiWeights: FontWeights
    uiFont: string
  view
    nav id=id testId=id aria-label=label display="flex" flex-direction="column" gap="ui.space-8" padding="ui.space-8" box-sizing="border-box"
      width=(collapsed ? "ui.space-48" : "ui.sidebar-width") max-width="100%" flex-shrink=0 min-width="0px"
      -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing-linear")
      background-color="ui.muted" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.panel-radius"
      SidebarTrigger(id=id + "-toggle", expanded=(not collapsed), controls=id + "-items", press=toggle)
      column id=(id + "-items") gap="ui.space-4" min-width="0px"
        for item in entries key=item.id
          button id=(id + "-item-" + item.id) testId=(id + "-item-" + item.id) class=Control font-weight=uiWeights.medium press=choose(item.id)
            aria-current=(selected == item.id ? "page" : "false") aria-label=item.label title=item.label
            display="flex" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-8" border="0"
            background-color=(selected == item.id ? "ui.surface" : "transparent") color="ui.foreground"
            transition=(reduced ? "none" : "background-color ui.duration-fast ui.easing")
            text item.symbol aria-hidden=true flex-shrink=0 font-family=uiFontFamily(uiFont) data-rightui-font="body"
            if not collapsed
              text item.label min-width="0px" text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component SidebarTrigger
  props
    id: string
    expanded: bool
    controls: string
    press: action
  view
    DisclosureButton(id=id, label="Toggle sidebar", variant="ghost", controls=controls, expanded=expanded, icon=true, press=press)
      svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.stroke-standard" aria-hidden=true
        rect x=3 y=3 width=18 height=18 rx=2
        path d="M9 3v18"
