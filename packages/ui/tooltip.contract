use uiFontFamily from "./typography-context.contract"
use Control from "./styles.contract"
keyframes uiTooltipDelay
  from opacity=0
  to opacity=1

component Tooltip
  props
    id: string
    label: string
    description: string
  inject
    uiFont: string
  state focused = false
  state delayed = false
  state expanded = false
  action show
    delayed = false
    expanded = true
    showPopover(id + "-tip", source=id)
  action enter
    focused = true
    show()
  action leave
    focused = false
    hidePopover(id + "-tip")
  action hover(inside: bool)
    if inside
      expanded = true
      delayed = true
      showPopover(id + "-tip", source=id)
    else if not focused
      hidePopover(id + "-tip")
  action changed(e: ToggleEvent)
    expanded = e.newState == "open"
  action keys(k: string)
    if k == "Escape"
      preventDefault()
      hidePopover(id + "-tip")
  view
    column align-items="flex-start" hover=hover
      button id=id testId=id class=Control aria-describedby=(id + "-tip") focus=enter blur=leave press=show key=keys
        padding="ui.space-8 ui.space-12" border-width="ui.border-width" border-style="solid" border-color="ui.border" background-color="ui.surface" color="ui.foreground"
        text label font-family=uiFontFamily(uiFont) data-rightui-font="body"
      view id=(id + "-tip") testId=(id + "-tip") role="tooltip" popover="auto" toggle=changed hover=hover
        position-area="top" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline"
        width="auto" max-width="calc(100vw - ui.space-32)" box-sizing="border-box" margin="ui.space-4" padding="ui.space-6 ui.space-12"
        background-color="ui.foreground" color="ui.background" border="0" border-radius="ui.radius-item" overflow="visible"
        animation=(delayed ? "uiTooltipDelay ui.duration-instant ui.easing-linear ui.duration-tooltip-delay both" : "none")
        text description font-size="ui.text-xs" line-height="ui.leading-normal" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        view position="absolute" left="50%" bottom="ui.space-negative-5" width="ui.space-10" height="ui.space-10" rotate="45deg" border-radius="ui.radius-detail" background-color="ui.foreground" aria-hidden=true
