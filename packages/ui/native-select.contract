use uiFontFamily from "./typography-context.contract"
component NativeSelect
  props
    id: string
    label: string
    options: string[]
    value: string
    disabled: bool
    change: action
  inject
    uiFont: string
  view
    column gap="ui.space-8" min-width="0px"
      text label id=(id + "-label") font-size="ui.text-sm" font-weight="ui.weight-medium" color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      select id=id testId=id value=value change=change disabled=disabled aria-labelledby=(id + "-label")
        min-height="ui.space-36" padding="ui.space-8 ui.space-12" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" background-color="ui.surface" color="ui.foreground" font-size="ui.text-sm"
        for item in options key=item
          option value=item
            text item font-family=uiFontFamily(uiFont) data-rightui-font="body"
