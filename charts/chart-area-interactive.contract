use FontWeights from "@rightui/ui"
use uiFontFamily, ChartPoint, Button from "@rightui/ui"
use AreaGalleryChart from "@rightui/ui"
component Demo
  props
    width: number
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  state period = 90
  action choose(days: number)
    period = days
  view
