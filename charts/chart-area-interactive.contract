      text "Area Chart - Interactive" font-size="ui.text-base" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "Showing total visitors for the last 3 months" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      row gap="ui.space-8" flex-wrap="wrap"
        for days in [90, 30, 7] key=days
          Button(id=("area-period-" + days.toString()), label=(days == 90 ? "Last 3 months" : days == 30 ? "Last 30 days" : "Last 7 days"), variant=(period == days ? "default" : "outline"), disabled=false, press=choose(days))
