use ButtonAI as ButtonContent from "@rightui/ui"
use Composer from "../../packages/ui/ai-controls.contract"
use BubbleFrame from "../../packages/ui/conversation-parts.contract"

component Demo
  props
    width: number
    reduced: bool
  state prompt = ""
  state reply = ""
  state turnSequence = 0
  action send(value: string)
    turnSequence = turnSequence + 1
    prompt = value
    reply = value == "Add a dark mode toggle" ? "Added a ModeToggle to the site header. It calls setTheme from next-themes." : value == "Fix the failing build" ? "The build failed on a missing import in app/page.tsx. I added it and the build passes." : value == "Write tests for the form" ? "Added four tests in signup-form.test.tsx. They cover the empty, invalid and valid states." : value == "Upgrade to Next.js 16" ? "Ran the codemod and bumped next to 16. Two routes needed async params, so I updated them." : value == "Add a loading state" ? "Added a loading.tsx to the dashboard route. It shows skeletons while the data loads." : value == "Find unused dependencies" ? "Three packages are not imported anywhere: lodash, moment and classnames. Should I remove them?" : "This demo only knows the suggestions. Pick one."
  view
    column width="100%" max-width="32rem" gap=24 padding="24px 0" font-size="0.875rem"
      if prompt != ""
        column gap=16
          BubbleFrame(id="ai-suggestion-user", align="end", variant="muted")
            text prompt
          text reply role="status"
      column gap=8
        row gap=8 overflow-x="auto"
          for suggestion, i in ["Add a dark mode toggle", "Fix the failing build", "Write tests for the form", "Upgrade to Next.js 16", "Add a loading state", "Find unused dependencies"] key=suggestion
            ButtonContent(id="ai-suggestion-prompt-" + i.toString(), label=suggestion, variant="outline", size="sm", disabled=false, press=send(suggestion))
              text suggestion white-space="nowrap"
        for epoch in [turnSequence] key=epoch
          Composer(id="ai-suggestion", menus=false, reduced=reduced, sent=send)
