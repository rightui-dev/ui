use BubbleFrame from "../../packages/ui/conversation-parts.contract"
use ButtonAI as ButtonContent from "../../packages/ui/button.contract"
use TraceFrame, TraceLine, TraceCollapsible, TraceDisclosure, TraceSource, CodeBlockContent from "../../packages/ui/trace-parts.contract"

component Demo
  props
    width: number
    reduced: bool
  inject
    rightuiDemoTime: number
    rightuiRunDemo: action
  state started = -1
  derive elapsed = started < 0 ? 12700 : max(0, rightuiDemoTime - started)
  derive busy = elapsed < 2700
  state researchOpen = false
  action toggleResearch
    researchOpen = not researchOpen
  action replay
    started = rightuiDemoTime
    rightuiRunDemo(6700)
  view
    column gap=16 min-width=0 min-height=288 max-width="24rem" width="100%" padding="24px 0px"
      BubbleFrame(id="ai-chain-of-thought-question", align="end", variant="muted")
        text "Why is the checkout deploy so slow?"
      TraceFrame()
        TraceDisclosure(id="ai-chain-of-thought-0", title=(busy ? "Researching" : "Researched in 3 steps"), icon="check", status=(busy ? "running" : ""), open=(researchOpen or busy), reduced=reduced, toggle=toggleResearch)
          TraceCollapsible(id="ai-chain-log", title=(elapsed < 900 ? "Reading the build log for dpl_8Kx2" : "Read the build log for dpl_8Kx2"), icon="check", status=(elapsed < 900 ? "running" : ""), initiallyOpen=true, reduced=reduced)
            if elapsed >= 900
              CodeBlockContent(id="ai-chain-log-output", code="install    41s\ncompile    38s\nimages   3m 52s")
          if elapsed >= 900
            TraceCollapsible(id="ai-chain-web", title=(elapsed < 1800 ? "Searching the web for next.js image cache key" : "Searched the web for next.js image cache key"), icon="check", status=(elapsed < 1800 ? "running" : ""), initiallyOpen=false, reduced=reduced)
              TraceSource(title="Image component | nextjs.org", href="https://nextjs.org/docs/app/api-reference/components/image", reduced=reduced)
              TraceSource(title="Build cache | vercel.com", href="https://vercel.com/docs/deployments/troubleshoot-a-build", reduced=reduced)
          if elapsed >= 1800
            TraceCollapsible(id="ai-chain-code", title=(elapsed < 2700 ? "Searching the code for cacheKey" : "Searched the code for cacheKey"), icon="check", status=(elapsed < 2700 ? "running" : ""), initiallyOpen=false, reduced=reduced)
              row gap=6 flex-wrap="wrap"
                text "next.config.ts" padding="2px 8px" border-radius=4 background-color="ui.muted" font-family="monospace" font-size="0.75rem"
                text "scripts/optimize-images.ts" padding="2px 8px" border-radius=4 background-color="ui.muted" font-family="monospace" font-size="0.75rem"
      if elapsed >= 2700
        text "Image optimization takes almost four minutes because its cache key includes the commit hash. Key it on the image directory instead.".slice(0, started < 0 or reduced ? 131 : floor((elapsed - 2700) / 20)) font-size="0.875rem" line-height=1.625
      if not busy
        row margin-top="auto" align-items="flex-start"
          ButtonContent(id="ai-chain-of-thought-replay", label="Replay", variant="outline", size="sm", disabled=false, press=replay)
            text "Replay"
