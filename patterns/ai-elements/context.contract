use HoverCardStyled from "../../packages/ui/hover-card.contract"

component Demo
  props
    width: number
    reduced: bool
  view
    row justify-content="center" padding="48px 0"
      HoverCardStyled(id="ai-context-budget", label="8% context", variant="outline", size="sm")
        column min-width=0 max-width="100%" gap=12 font-size="0.875rem"
          row justify-content="space-between" align-items="center" gap=12 min-width=0 flex-wrap="wrap"
            text "Context" font-weight=500 min-width=0
            text "10.7k / 128k" color="ui.muted-foreground" flex-shrink=0 white-space="nowrap"
          view role="progressbar" aria-label="Context used" aria-valuenow=8 aria-valuemin=0 aria-valuemax=100 height=6 border-radius=999 background-color="ui.muted"
            view width="8%" height=6 border-radius=999 background-color="ui.primary"
          column gap=4 min-width=0
            for entry in ["Input|8.4k", "Output|1.3k", "Reasoning|980"] key=entry
              row justify-content="space-between" align-items="center" gap=12 min-width=0 flex-wrap="wrap" font-size="0.875rem"
                text entry.slice(0, entry.indexOf("|")) color="ui.muted-foreground" min-width=0
                text entry.slice(entry.indexOf("|") + 1) flex-shrink=0 white-space="nowrap"
