use BubbleFrame from "../../packages/ui/conversation-parts.contract"
use ButtonAI as ButtonContent from "../../packages/ui/button.contract"
use TraceFrame, TraceLine, TraceCollapsible, TraceDisclosure, TraceSource, CodeBlockContent from "../../packages/ui/trace-parts.contract"

component Demo
  props
    width: number
    reduced: bool
  inject
    rightuiDemoTime: number
    rightuiRunDemo: action
  state started = -1
  derive elapsed = started < 0 ? 16300 : max(0, rightuiDemoTime - started)
  derive busy = elapsed < 6300
  state taskOpen = -1
  action toggleTask(index: number)
    taskOpen = taskOpen == index ? -1 : index
  action replay
    started = rightuiDemoTime
    rightuiRunDemo(10300)
  view
    column gap=16 min-width=0 min-height=288 max-width="24rem" width="100%" padding="24px 0px"
      BubbleFrame(id="ai-task-question", align="end", variant="muted")
        text "Add Open Graph metadata to the home page."
      TraceFrame()
        if elapsed >= 0
          TraceDisclosure(id="ai-task-0", title=(elapsed < 2700 ? "Finding the project files" : "Found the project files"), icon="check", status=(elapsed < 2700 ? "running" : ""), open=(taskOpen == 0 or (elapsed >= 0 and elapsed < 2700)), reduced=reduced, toggle=toggleTask(0))
            if elapsed >= 0
              TraceLine(title=(elapsed < 900 ? "Searching for generateMetadata" : "Searched for generateMetadata"), icon="check", status=(elapsed < 900 ? "running" : ""), reduced=reduced)
            if elapsed >= 900
              TraceLine(title=(elapsed < 1800 ? "Reading app/layout.tsx" : "Read app/layout.tsx"), icon="check", status=(elapsed < 1800 ? "running" : ""), reduced=reduced)
            if elapsed >= 1800
              TraceLine(title=(elapsed < 2700 ? "Reading app/page.tsx" : "Read app/page.tsx"), icon="check", status=(elapsed < 2700 ? "running" : ""), reduced=reduced)
        if elapsed >= 3600
          TraceDisclosure(id="ai-task-1", title=(elapsed < 5400 ? "Updating the page metadata" : "Updated the page metadata"), icon="check", status=(elapsed < 5400 ? "running" : ""), open=(taskOpen == 1 or (elapsed >= 3600 and elapsed < 5400)), reduced=reduced, toggle=toggleTask(1))
            if elapsed >= 3600
              TraceLine(title=(elapsed < 4500 ? "Editing app/layout.tsx" : "Edited app/layout.tsx"), icon="check", status=(elapsed < 4500 ? "running" : ""), reduced=reduced)
            if elapsed >= 4500
              TraceLine(title=(elapsed < 5400 ? "Editing app/page.tsx" : "Edited app/page.tsx"), icon="check", status=(elapsed < 5400 ? "running" : ""), reduced=reduced)
      if elapsed >= 6300
        text "Added Open Graph defaults to app/layout.tsx and a title, description and image for the home page in app/page.tsx.".slice(0, started < 0 or reduced ? 113 : floor((elapsed - 6300) / 20)) font-size="0.875rem" line-height=1.625
      if not busy
        row margin-top="auto" align-items="flex-start"
          ButtonContent(id="ai-task-replay", label="Replay", variant="outline", size="sm", disabled=false, press=replay)
            text "Replay"
