use uiFontFamily, BubbleFrame from "@rightui/ui"
use ButtonAI as ButtonContent from "@rightui/ui"
use TraceFrame, TraceLine, TraceCollapsible, TraceDisclosure, TraceSource, CodeBlockContent from "@rightui/ui"

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
    rightuiDemoTime: number
    rightuiRunDemo: action
  state started = -1
  derive elapsed = started < 0 ? 14200 : max(0, rightuiDemoTime - started)
  derive busy = elapsed < 4200
  state terminalOpen = "build"
  action toggleTerminal(id: string)
    terminalOpen = terminalOpen == id ? "" : id
  action replay
    started = rightuiDemoTime
    rightuiRunDemo(8200)
  view
    column gap="ui.space-16" min-width=0 min-height=288 max-width="24rem" width="100%" padding="ui.space-24 ui.space-0"
      BubbleFrame(id="ai-terminal-question", align="end", variant="muted")
        text "Run the checks, then build the app." font-family=uiFontFamily(uiFont) data-rightui-font="body"
      TraceFrame()
        if elapsed >= 0
          TraceDisclosure(id="ai-terminal-lint", title=((elapsed < 400 ? "Running " : "Ran ") + "pnpm lint"), icon="terminal", status=(elapsed < 400 ? "running" : ""), open=(terminalOpen == "lint" or (busy and elapsed < 400)), reduced=reduced, toggle=toggleTerminal("lint"))
            CodeBlockContent(id="ai-terminal-lint-output", code="> acme-chat@0.1.0 lint\n> eslint .".split("\n").slice(0, min(2, max(1, floor((elapsed - 0) / 200) + 1))).join("\n"))
        if elapsed >= 400
          TraceDisclosure(id="ai-terminal-test", title=((elapsed < 2000 ? "Running " : "Ran ") + "pnpm test"), icon="terminal", status=(elapsed < 2000 ? "running" : ""), open=(terminalOpen == "test" or (busy and elapsed < 2000)), reduced=reduced, toggle=toggleTerminal("test"))
            CodeBlockContent(id="ai-terminal-test-output", code="> acme-chat@0.1.0 test\n> vitest run\n\n \u2713 lib/ai.test.ts (6 tests) 41ms\n \u2713 components/chat.test.tsx (9 tests) 212ms\n\n Test Files  2 passed (2)\n      Tests  15 passed (15)".split("\n").slice(0, min(8, max(1, floor((elapsed - 400) / 200) + 1))).join("\n"))
        if elapsed >= 2000
          TraceDisclosure(id="ai-terminal-build", title=((elapsed < 4200 ? "Running " : "Ran ") + "pnpm build"), icon="terminal", status=(elapsed < 4200 ? "running" : ""), open=(terminalOpen == "build" or (busy and elapsed < 4200)), reduced=reduced, toggle=toggleTerminal("build"))
            CodeBlockContent(id="ai-terminal-build-output", code="> acme-chat@0.1.0 build\n> next build\n\n   \u25b2 Next.js 16.3.0\n   Creating an optimized production build ...\n \u2713 Compiled successfully in 4.2s\n \u2713 Generating static pages (12/12)\n\nRoute (app)                Size  First Load JS\n\u250c \u25cb /                     1.9 kB       112 kB\n\u2514 \u0192 /api/chat              141 B       102 kB".split("\n").slice(0, min(11, max(1, floor((elapsed - 2000) / 200) + 1))).join("\n"))
      if elapsed >= 4200
        text "Lint and tests pass, and the build compiled both routes.".slice(0, started < 0 or reduced ? 56 : floor((elapsed - 4200) / 20)) font-size="ui.text-sm" line-height="ui.leading-relaxed" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if not busy
        row margin-top="auto" align-items="flex-start"
          ButtonContent(id="ai-terminal-replay", label="Replay", variant="outline", size="sm", disabled=false, press=replay)
            text "Replay" font-family=uiFontFamily(uiFont) data-rightui-font="body"
