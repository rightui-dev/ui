use uiFontFamily from "@rightui/ui"
shape CitationSource
  id: string
  host: string
  url: string
  title: string
  description: string

component Demo
  props
    width: number
    reduced: bool
  inject
    uiFont: string
    rightuiDemoTime: number
    rightuiRunDemo: action
  state active = 0
  state hideAt = 0
  state popupFocused = false
  derive sources = [CitationSource(id="ai-inline-citation-0", host="nextjs.org", url="https://nextjs.org/docs/app/getting-started/linking-and-navigating#streaming", title="Linking and Navigating", description="How the App Router streams a route to the browser."), CitationSource(id="ai-inline-citation-1", host="react.dev", url="https://react.dev/reference/react/Suspense", title="<Suspense>", description="Display a fallback until its children have finished loading."), CitationSource(id="ai-inline-citation-2", host="react.dev", url="https://react.dev/reference/rsc/server-components", title="Server Components", description="Components that render ahead of time, on the server."), CitationSource(id="ai-inline-citation-3", host="nextjs.org", url="https://nextjs.org/docs/app/api-reference/file-conventions/loading", title="loading.js", description="Show an instant loading state for a route segment."), CitationSource(id="ai-inline-citation-4", host="developer.mozilla.org", url="https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Transfer-Encoding", title="Transfer-Encoding", description="Send a response as a series of chunks.")]
  derive source = match sources.at(active) { case some(item) => item, case none => CitationSource(id="ai-inline-citation-0", host="nextjs.org", url="https://nextjs.org/docs/app/getting-started/linking-and-navigating#streaming", title="Linking and Navigating", description="How the App Router streams a route to the browser.") }
  action show(index: number)
    active = index
    hideAt = 0
    showPopover("ai-inline-citation-content", source="ai-inline-citation-" + index.toString())
  action hover(index: number, inside: bool)
    if inside
      show(index)
    else
      hideAt = rightuiDemoTime + 100
      rightuiRunDemo(100)
  action popupHover(inside: bool)
    if inside
      hideAt = 0
    else if not popupFocused
      hideAt = rightuiDemoTime + 100
      rightuiRunDemo(100)
  action enter
    popupFocused = true
    hideAt = 0
  action leave
    popupFocused = false
    hideAt = rightuiDemoTime + 100
    rightuiRunDemo(100)
  action triggerKeys(index: number, k: string)
    if k == "Enter" or k == " "
      preventDefault()
      show(index)
    else
      closeTip(k)
  action closeTip(k: string)
    if k == "Escape"
      hidePopover("ai-inline-citation-content")
      focus(source.id)
  view
    column max-width="24rem" gap="ui.space-12" padding="ui.space-24 ui.space-0" font-size="ui.text-sm" line-height="ui.leading-relaxed"
      text "" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text "Next.js streams a route in chunks, so the page shows up before every request finishes." font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " nextjs.org " id="ai-inline-citation-0" testId="ai-inline-citation-0" role="button" tabindex=0 aria-haspopup="dialog" press=show(0) hover=hover(0) focusin=show(0) focusout=leave key=triggerKeys(0) background-color="ui.muted" color="ui.foreground" font-size="ui.text-xs" font-weight="ui.weight-medium" border-radius="ui.ai-radius-control" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text "Wrap a slow part of the page in a Suspense boundary and React sends the fallback first. When the data resolves, the finished HTML streams into the same response and replaces the fallback, with no extra request from the browser." font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " react.dev " id="ai-inline-citation-1" testId="ai-inline-citation-1" role="button" tabindex=0 aria-haspopup="dialog" press=show(1) hover=hover(1) focusin=show(1) focusout=leave key=triggerKeys(1) background-color="ui.muted" color="ui.foreground" font-size="ui.text-xs" font-weight="ui.weight-medium" border-radius="ui.ai-radius-control" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " Server Components help here, because their code never ships to the browser." font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " react.dev " id="ai-inline-citation-2" testId="ai-inline-citation-2" role="button" tabindex=0 aria-haspopup="dialog" press=show(2) hover=hover(2) focusin=show(2) focusout=leave key=triggerKeys(2) background-color="ui.muted" color="ui.foreground" font-size="ui.text-xs" font-weight="ui.weight-medium" border-radius="ui.ai-radius-control" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text "" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text "A loading.tsx file does the same for a whole route segment." font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " nextjs.org " id="ai-inline-citation-3" testId="ai-inline-citation-3" role="button" tabindex=0 aria-haspopup="dialog" press=show(3) hover=hover(3) focusin=show(3) focusout=leave key=triggerKeys(3) background-color="ui.muted" color="ui.foreground" font-size="ui.text-xs" font-weight="ui.weight-medium" border-radius="ui.ai-radius-control" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " It all runs over chunked transfer encoding, so there is nothing extra to set up." font-family=uiFontFamily(uiFont) data-rightui-font="body"
        text " developer.mozilla.org " id="ai-inline-citation-4" testId="ai-inline-citation-4" role="button" tabindex=0 aria-haspopup="dialog" press=show(4) hover=hover(4) focusin=show(4) focusout=leave key=triggerKeys(4) background-color="ui.muted" color="ui.foreground" font-size="ui.text-xs" font-weight="ui.weight-medium" border-radius="ui.ai-radius-control" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if hideAt == 0 or rightuiDemoTime < hideAt or popupFocused
        column id="ai-inline-citation-content" testId="ai-inline-citation-content" popover="auto" role="dialog" aria-label=source.title position-area="bottom" position-try-fallbacks="flip-block, flip-inline" margin="ui.space-8" width="16rem" padding="ui.space-16" gap="ui.space-4" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.ai-radius-popover" background-color="ui.surface" color="ui.foreground" box-shadow="ui.shadow-menu" hover=popupHover focusin=enter focusout=leave key=closeTip
          text source.title font-weight="ui.weight-medium" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          text source.description color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          link id="ai-inline-citation-source-link" href=source.url target="_blank" rel="noreferrer" aria-label=(source.host + " (opens in a new tab)")
            text source.host font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
