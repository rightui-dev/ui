use Control from "../../packages/ui/styles.contract"

component TreeFile
  props
    path: string
    name: string
    selected: string
    choose: action
  state hovered = false
  action hover(inside: bool)
    hovered = inside
  view
    button class=Control hover=hover testId=("ai-file-tree-" + path) press=choose(path) aria-current=(selected == path ? "true" : "false") display="flex" align-items="center" gap=8 width="100%" height=32 min-height=32 padding="4px 12px" border="0" border-radius=6 background-color=(selected == path or hovered ? "ui.muted" : "transparent") color="ui.foreground" font-size="0.875rem" text-align="left"
      svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2
        path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"
      text name

component Demo
  props
    width: number
    reduced: bool
  state appOpen = true
  state componentsOpen = true
  state uiOpen = true
  state selected = "components/ui/button.tsx"
  action appToggle
    appOpen = not appOpen
  action componentsToggle
    componentsOpen = not componentsOpen
  action uiToggle
    uiOpen = not uiOpen
  action choose(path: string)
    selected = path
  view
    column width="100%" max-width="20rem" padding="24px 0" font-size="0.875rem"
      button id="ai-file-tree-app" testId="ai-file-tree-app" class=Control aria-label="app" aria-controls="ai-file-tree-app-files" aria-expanded=appOpen press=appToggle display="flex" align-items="center" width="100%" height=32 min-height=32 padding="4px 12px" border="0" background-color="transparent" color="ui.foreground" font-size="0.875rem" font-weight=400 text-align="left"
        :hover
          background-color="ui.muted"
        row gap=8 align-items="center"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 rotate=(appOpen ? "90deg" : "0deg") aria-hidden=true
            path d="m9 6 6 6-6 6"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
            path d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2Z"
          text "app"
      if appOpen
        column id="ai-file-tree-app-files" padding-left=16
          TreeFile(path="app/layout.tsx", name="layout.tsx", selected=selected, choose=choose)
          TreeFile(path="app/page.tsx", name="page.tsx", selected=selected, choose=choose)
      button id="ai-file-tree-components" testId="ai-file-tree-components" class=Control aria-label="components" aria-controls="ai-file-tree-component-files" aria-expanded=componentsOpen press=componentsToggle display="flex" align-items="center" width="100%" height=32 min-height=32 padding="4px 12px" border="0" background-color="transparent" color="ui.foreground" font-size="0.875rem" font-weight=400 text-align="left"
        :hover
          background-color="ui.muted"
        row gap=8 align-items="center"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 rotate=(componentsOpen ? "90deg" : "0deg") aria-hidden=true
            path d="m9 6 6 6-6 6"
          svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
            path d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2Z"
          text "components"
      if componentsOpen
        column id="ai-file-tree-component-files" padding-left=16
          button id="ai-file-tree-ui" testId="ai-file-tree-ui" class=Control aria-label="ui" aria-controls="ai-file-tree-ui-files" aria-expanded=uiOpen press=uiToggle display="flex" align-items="center" width="100%" height=32 min-height=32 padding="4px 12px" border="0" background-color="transparent" color="ui.foreground" font-size="0.875rem" font-weight=400 text-align="left"
            :hover
              background-color="ui.muted"
            row gap=8 align-items="center"
              svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 rotate=(uiOpen ? "90deg" : "0deg") aria-hidden=true
                path d="m9 6 6 6-6 6"
              svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 aria-hidden=true
                path d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2Z"
              text "ui"
          if uiOpen
            column id="ai-file-tree-ui-files" padding-left=16
              TreeFile(path="components/ui/button.tsx", name="button.tsx", selected=selected, choose=choose)
          TreeFile(path="components/login-form.tsx", name="login-form.tsx", selected=selected, choose=choose)
