        rect x=3 y=3 width=18 height=18 rx=2
        path d="m7 8 4 4-4 4m6 0h4"
      else if name == "Bot"
        rect x=3 y=8 width=18 height=12 rx=2
        path d="M12 8V4H8m0 9h.01M16 13h.01M8 17h8M1 12h2m18 0h2"
      else if name == "BookOpen"
