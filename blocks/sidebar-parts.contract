      else if name == "Menu"
        path d="M4 6h16M4 12h16M4 18h16"
      else if name == "Paintbrush"
        path d="m14 6 4-4 4 4-4 4-4 2-2 2-2-2 2-2ZM10 14c-2-2-6-1-6 3 0 2-2 3-2 3s8 3 9-3Z"
      else if name == "Globe"
        circle cx=12 cy=12 r=10
        ellipse cx=12 cy=12 rx=4 ry=10
        path d="M2 12h20"
      else if name == "Keyboard"
        rect x=2 y=5 width=20 height=14 rx=2
        path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M7 16h10"
      else if name == "Check"
        path d="m5 12 4 4L19 6"
      else if name == "Video"
        rect x=2 y=5 width=14 height=14 rx=2
        path d="m16 10 6-4v12l-6-4"
      else if name == "Link"
        path d="M10 13a5 5 0 0 0 7 .5l3-3a5 5 0 0 0-7-7l-2 2m3 5a5 5 0 0 0-7-.5l-3 3a5 5 0 0 0 7 7l2-2"
      else if name == "Lock"
        rect x=3 y=11 width=18 height=11 rx=2
        path d="M7 11V7a5 5 0 0 1 10 0v4"
      else
        path d="M3 7h18M3 12h18M3 17h18"

component SidebarLink
  props
    id: string
    label: string
    icon: string
    selected: bool
    compact: bool
    badge: string
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  view
    button id=id testId=id class=Control press=choose(label) aria-label=label aria-current=(selected ? "page" : "false")
      display="flex" align-items="center" gap="ui.space-8" min-height="ui.space-32" width="100%" padding="ui.space-6 ui.space-8" border="0" border-radius="ui.radius-sm"
      background-color=(selected ? "ui.muted" : "transparent") color="ui.foreground" font-size="ui.text-sm" font-weight=(selected ? uiWeights.medium : uiWeights.regular)
      :hover
        background-color="ui.muted"
      if icon != ""
        SidebarIcon(name=icon)
      if not compact
        text label flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if badge != ""
          text badge font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component SidebarRichMenu
  props
    id: string
    title: string
    subtitle: string
    icon: string
    avatar: bool
    compact: bool
    entries: MenuEntry[]
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state expanded = false
  state width = 224
  action openMenu(lastItem: bool)
    let bounds = frame(id)
    width = max(224, bounds.width)
    expanded = true
    showPopover(id + "-menu", source=id)
    match entries.at(lastItem ? entries.length - 1 : 0)
      case some(entry)
        focus(id + "-item-" + entry.id)
      case none
        focus(id + "-menu")
  action closeMenu
    if expanded
      hidePopover(id + "-menu")
      focus(id)
  action toggle
    if expanded
      closeMenu()
    else
      openMenu(false)
  action changed(e: ToggleEvent)
    expanded = e.newState == "open"
  action triggerKeys(k: string)
    if k == "Enter" or k == " "
      preventDefault()
      toggle()
    else if k == "ArrowDown" or k == "ArrowUp"
      preventDefault()
      openMenu(k == "ArrowUp")
    else if k == "Escape"
      preventDefault()
      closeMenu()
  action pick(entry: MenuEntry)
    closeMenu()
    choose(entry.id)
  action itemKeys(index: number, k: string, e: KeyboardEvent)
    if k == "Enter" or k == " "
      preventDefault()
      match entries.at(index)
        case some(entry)
          pick(entry)
        case none
          stopPropagation()
    else if k == "Escape" or k == "Tab"
      if k == "Escape"
        preventDefault()
      closeMenu()
    else if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
      preventDefault()
      let next = (k == "Home" ? 0 : k == "End" ? entries.length - 1 : (index + (k == "ArrowDown" ? 1 : entries.length - 1)) % max(1, entries.length))
      match entries.at(next)
        case some(entry)
          focus(id + "-item-" + entry.id)
        case none
          closeMenu()
    else if k.length == 1 and k != " " and not e.ctrlKey and not e.metaKey and not e.altKey
      let ordered = entries.slice(index + 1).concat(entries.slice(0, index + 1))
      match first(ordered.filter(entry => entry.label.toLowerCase().startsWith(k.toLowerCase())))
        case some(entry)
          preventDefault()
          focus(id + "-item-" + entry.id)
        case none
          stopPropagation()
  view
    column padding="ui.space-8" min-width=0 box-sizing="border-box"
      button id=id testId=id class=Control press=toggle key=triggerKeys aria-haspopup="menu" aria-expanded=expanded aria-controls=(id + "-menu") aria-label=title
        display="flex" align-items="center" gap="ui.space-8" width="100%" min-height=(compact ? "ui.space-32" : "ui.space-48") padding=(compact ? "ui.space-0" : "ui.space-8")
        border="0" border-radius="ui.radius-sm" background-color=(expanded ? "ui.muted" : "transparent") color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.regular
        :hover
          background-color="ui.muted"
        view width="ui.space-32" height="ui.space-32" flex-shrink=0 border-radius="ui.radius-md" display="flex" align-items="center" justify-content="center"
          background-color=(avatar ? "ui.muted" : "ui.primary") color=(avatar ? "ui.foreground" : "ui.primary-foreground")
          if avatar
            ExpoMark()
          else
            SidebarIcon(name=icon)
        if not compact
          column gap="ui.space-2" flex=1 min-width=0 align-items="flex-start"
            text title testId=(id + "-title") font-size="ui.text-sm" font-weight=uiWeights.medium white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            text subtitle testId=(id + "-subtitle") font-size="ui.text-xs" font-weight=uiWeights.regular white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          SidebarIcon(name="ChevronsUpDown")
      column id=(id + "-menu") testId=(id + "-menu") role="menu" aria-label=(avatar ? "Account" : "Teams") popover="auto" toggle=changed
        position-area="right" position-try-fallbacks="flip-inline, flip-block, flip-block flip-inline" margin="ui.space-4" width=width max-width="calc(100vw - ui.space-32)" max-height="80vh" overflow="auto" box-sizing="border-box"
        padding="ui.space-4" gap="ui.space-2" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-md" background-color="ui.surface" color="ui.foreground" box-shadow="ui.shadow-menu"
        if avatar
          row gap="ui.space-8" padding="ui.space-6 ui.space-4" align-items="center"
            view width="ui.space-32" height="ui.space-32" flex-shrink=0 border-radius="ui.radius-md" background-color="ui.muted" display="flex" align-items="center" justify-content="center"
              ExpoMark()
            column gap="ui.space-2" flex=1 min-width=0
              text title font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text subtitle font-size="ui.text-xs" font-weight=uiWeights.regular font-family=uiFontFamily(uiFont) data-rightui-font="body"
          view height="ui.border-width" margin="ui.space-4 ui.space-negative-4" background-color="ui.border"
        else
          text "Teams" padding="ui.space-6 ui.space-8" font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        for entry, i in entries key=entry.id
          if (avatar and (i == 1 or i == 4)) or (not avatar and i == 3)
            view height="ui.border-width" margin="ui.space-4 ui.space-negative-4" background-color="ui.border"
          button id=(id + "-item-" + entry.id) testId=(id + "-item-" + entry.id) class=Control role="menuitem" tabindex=-1 press=pick(entry) key=itemKeys(i)
            display="flex" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius="ui.radius-inline" background-color="transparent" color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.regular
            :hover
              background-color="ui.muted"
            :focus-visible
              background-color="ui.muted"
            if avatar
              SidebarIcon(name=(i == 0 ? "Sparkles" : i == 1 ? "BadgeCheck" : i == 2 ? "CreditCard" : i == 3 ? "Bell" : "LogOut"))
            else
              view width="ui.space-24" height="ui.space-24" flex-shrink=0 display="flex" align-items="center" justify-content="center" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-sm"
                SidebarIcon(name=(i == 0 ? "GalleryVerticalEnd" : i == 1 ? "AudioWaveform" : i == 2 ? "Command" : "Plus"))
            text entry.label flex=1 min-width=0 text-align="left" color=(not avatar and i == 3 ? "ui.muted-foreground" : "ui.foreground") font-family=uiFontFamily(uiFont) data-rightui-font="body"
            if entry.shortcut != ""
              text entry.shortcut font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component SidebarUser
  props
    id: string
    compact: bool
    reduced: bool
    choose: action
  view
    SidebarRichMenu(id=id + "-menu", title="@ccheever", subtitle="m@example.com", icon="", avatar=true, compact=compact, choose=choose, entries=[MenuEntry(id="upgrade", label="Upgrade to Pro", shortcut="", disabled=false, destructive=false), MenuEntry(id="account", label="Account", shortcut="", disabled=false, destructive=false), MenuEntry(id="billing", label="Billing", shortcut="", disabled=false, destructive=false), MenuEntry(id="notifications", label="Notifications", shortcut="", disabled=false, destructive=false), MenuEntry(id="logout", label="Log out", shortcut="", disabled=false, destructive=false)])

component SidebarBrand
  props
    id: string
    docs: bool
    compact: bool
    switcher: bool
    reduced: bool
  inject
    uiWeights: FontWeights
    uiFont: string
  state team = "Acme Inc"
  derive plan = team == "Acme Inc" ? "Enterprise" : team == "Acme Corp." ? "Startup" : "Free"
  derive teamIcon = team == "Acme Inc" ? "GalleryVerticalEnd" : team == "Acme Corp." ? "AudioWaveform" : "Command"
  action changeTeam(value: string)
    if value != "add"
      team = value
  view
    if switcher
      SidebarRichMenu(id=id + "-team", title=team, subtitle=plan, icon=teamIcon, avatar=false, compact=compact, choose=changeTeam, entries=[MenuEntry(id="Acme Inc", label="Acme Inc", shortcut="⌘1", disabled=false, destructive=false), MenuEntry(id="Acme Corp.", label="Acme Corp.", shortcut="⌘2", disabled=false, destructive=false), MenuEntry(id="Evil Corp.", label="Evil Corp.", shortcut="⌘3", disabled=false, destructive=false), MenuEntry(id="add", label="Add team", shortcut="", disabled=false, destructive=false)])
    else
      row gap="ui.space-8" padding="ui.space-8" margin="ui.space-8" align-items="center" min-height="ui.space-48" box-sizing="border-box"
        view width="ui.space-32" height="ui.space-32" flex-shrink=0 border-radius="ui.radius-md" background-color="ui.primary" color="ui.primary-foreground" display="flex" align-items="center" justify-content="center"
          SidebarIcon(name=(docs ? "GalleryVerticalEnd" : "Command"))
        if not compact
          column gap="ui.space-2" flex=1 min-width=0
            text (docs ? "Documentation" : "Acme Inc") font-size="ui.text-sm" font-weight=uiWeights.medium color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            text (docs ? "v1.0.0" : "Enterprise") font-size="ui.text-xs" font-weight=uiWeights.regular color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
