use FontWeights from "@rightui/ui"
use uiFontFamily, Button, IconButton, SidebarTrigger from "@rightui/ui"
use ControlStyle as Control, InputStyle as Field from "@rightui/ui"
use DropdownMenu, MenuEntry from "@rightui/ui"
use SidebarIcon, SidebarLink from "./sidebar-parts.contract"
use SidebarDocs, SidebarPlatform, SidebarNotion from "./sidebar-navigation.contract"
use SidebarMail, SidebarFiles, SidebarCalendar from "./sidebar-special.contract"
use sidebarSettings from "./sidebar-data.contract"

component SidebarSettings
  props
    id: string
    narrow: bool
    dismiss: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state selected = "Messages & media"
  state focused = ""
  action choose(value: string)
    selected = value
  action closeSettings
    dismiss()
    focus(id + "-open")
  action remember(e: FocusEvent)
    focused = e.target
  action keys(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      closeSettings()
    else if k == "Tab"
      preventDefault()
      let targets = querySelectorAll("#" + id + "-dialog button")
      let index = targets.indexOf(focused)
      let next = (index + (e.shiftKey ? targets.length - 1 : 1)) % max(1, targets.length)
      match targets.at(next)
        case some(target)
          focus(target)
        case none
          focus(id + "-close")
  view
    column position="absolute" inset=0 z-index=110 padding="ui.space-16" background-color="ui.overlay" align-items="center" justify-content="center" box-sizing="border-box"
      button id=(id + "-backdrop") testId=(id + "-backdrop") press=closeSettings tabindex=-1 aria-label="Close settings" position="absolute" inset=0 appearance="none" border="0" background-color="transparent"
      row id=(id + "-dialog") testId=(id + "-dialog") role="dialog" aria-modal=true aria-label="Settings" keycapture=keys focusin=remember
        position="relative" width="100%" box-sizing="border-box" max-width="50rem" height=480 min-height=0 overflow="hidden" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-card" background-color="ui.surface" box-shadow="ui.shadow-preview"
        if not narrow
          scroll width="ui.sidebar-width" flex-shrink=0 background-color="ui.muted" padding="ui.space-8" box-sizing="border-box"
            column gap="ui.space-2"
              for item, i in sidebarSettings() key=item.title
                SidebarLink(id=id + "-setting-" + i.toString(), label=item.title, icon=item.icon, selected=(selected == item.title), compact=false, badge="", choose=choose)
        column flex=1 min-width=0 min-height=0
          row padding="ui.space-16" gap="ui.space-8" align-items="center" min-height="ui.space-64" box-sizing="border-box"
            if not narrow
              text "Settings" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              SidebarIcon(name="ChevronRight")
            text selected testId=(id + "-selected") font-size="ui.text-sm" color="ui.foreground" flex=1 font-family=uiFontFamily(uiFont) data-rightui-font="body"
            button id=(id + "-close") testId=(id + "-close") class=Control font-weight=uiWeights.medium autofocus=true press=closeSettings aria-label="Close dialog" padding="ui.space-4" min-height="ui.space-28" border="0" background-color="transparent" color="ui.muted-foreground"
              svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
                path d="m6 6 12 12M6 18 18 6"
          scroll flex=1 min-height=0 padding="ui.space-0 ui.space-16 ui.space-16"
            column gap="ui.space-16"
              for i in range(10) key=i
                view height=140 border-radius="ui.radius-card" background-color="ui.muted"


component SidebarBlock
  props
    variant: number
    narrow: bool
    reduced: bool
    openSettings: action
  action ignoreScroll(x: number, y: number)
    let ignored = x + y
  view
    SidebarBlockWithScroll(variant=variant, narrow=narrow, reduced=reduced, openSettings=openSettings, scrolled=ignoreScroll)

component SidebarBlockWithScroll
  props
    variant: number
    narrow: bool
    reduced: bool
    openSettings: action
    scrolled: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state expanded = true
  state mobileOpen = false
  state mobileFocused = ""
  state selected = ""
  state query = ""
  state starred = false
  derive id = "block-sidebar-" + (variant < 10 ? "0" : "") + variant.toString()
  derive compact = not narrow and not expanded and (variant == 7 or variant == 9)
  derive visible = narrow ? mobileOpen : expanded or compact
  derive desktopWidth = compact ? "ui.sidebar-width-compact" : variant == 9 ? "ui.sidebar-width-mail" : variant == 4 ? "ui.sidebar-width-floating" : variant == 12 ? "ui.sidebar-width-wide" : "ui.sidebar-width"
  derive current = selected == "" ? (variant == 9 ? "Inbox" : variant == 10 or variant == 15 ? "Project Management & Task Tracking" : variant == 11 ? "button.tsx" : variant == 12 ? "October 2024" : "Data Fetching") : selected
  action toggle
    if narrow
      let next = not mobileOpen
      mobileOpen = next
      if next
        focus(id + "-mobile-close")
      else
        focus(id + "-trigger")
    else
      expanded = not expanded
  action dismiss
    mobileOpen = false
    focus(id + "-trigger")
  action choose(value: string)
    selected = value
  action rememberMobile(e: FocusEvent)
    mobileFocused = e.target
  action mobileKeys(k: string, e: KeyboardEvent)
    if narrow and mobileOpen and k == "Tab"
      preventDefault()
      let targets = querySelectorAll("#" + id + "-sidebar button, #" + id + "-sidebar input, #" + id + "-sidebar a")
      let index = targets.indexOf(mobileFocused)
      let next = (index < 0 ? (e.shiftKey ? targets.length - 1 : 0) : (index + (e.shiftKey ? targets.length - 1 : 1)) % max(1, targets.length))
      match targets.at(next)
        case some(target)
          focus(target)
        case none
          focus(id + "-mobile-close")
  action editQuery(value: string)
    query = value
  action toggleStar
    starred = not starred
  action keys(k: string, e: KeyboardEvent)
    if k.toLowerCase() == "b" and (e.metaKey or e.ctrlKey)
      preventDefault()
      toggle()
    else if k == "Escape" and narrow and mobileOpen
      preventDefault()
      dismiss()
  view
    if variant == 13
      column min-height=560 align-items="center" justify-content="center"
        Button(id=id + "-open", label="Open Dialog", variant="outline", disabled=false, press=openSettings)
    else
      column id=id testId=id key=keys position="relative" height="100%" min-height=700 min-width=0 overflow="hidden" background-color=(variant == 8 ? "ui.sidebar" : "ui.background") color="ui.foreground"
        if variant == 16
          row inert=(narrow and mobileOpen) height="ui.space-56" flex-shrink=0 gap="ui.space-12" align-items="center" padding="ui.space-0 ui.space-16" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" background-color="ui.background"
            view order=(variant == 14 ? 4 : 0)
              SidebarTrigger(id=id + "-trigger", expanded=(narrow ? mobileOpen : expanded), controls=id + "-sidebar", press=toggle)
            if not narrow
              text "Build Your Application" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              SidebarIcon(name="ChevronRight")
              text current font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            view flex=1
            input id=(id + "-global-search") testId=(id + "-global-search") class=Field font-weight=uiWeights.regular value=query input=editQuery placeholder="Search..." aria-label="Search" width=(narrow ? "10rem" : "15rem") min-height="ui.space-32" padding="ui.space-4 ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        row position="relative" flex=1 min-height=0 min-width=0 flex-direction=(variant == 14 ? "row-reverse" : "row")
          if not narrow
            view id=(id + "-gap") width=(expanded or compact ? desktopWidth : "0rem") flex-shrink=0 min-width=0
              -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing-linear")
          column id=(id + "-sidebar") testId=(visible ? id + "-sidebar" : "") role="navigation" aria-label="Sidebar" inert=(not visible) aria-hidden=(not visible) keycapture=mobileKeys focusin=rememberMobile
            position="absolute" z-index=(narrow ? 40 : 10) top=0 bottom=0 left=(variant == 14 ? "auto" : "0px") right=(variant == 14 ? "0px" : "auto")
            width=(narrow ? "ui.sidebar-width-wide" : desktopWidth) max-width="calc(100% - ui.space-48)"
            flex-shrink=0 min-height=0 box-sizing="border-box" padding=(not narrow and (variant == 4 or variant == 8) ? "ui.space-8" : "ui.space-0")
            translate=(visible ? "0% 0px" : variant == 14 ? "100% 0px" : "-100% 0px") pointer-events=(visible ? "auto" : "none")
            transition=(reduced ? "none" : "translate ui.duration-normal ui.easing-linear")
            border="0" border-right-width=(narrow or variant == 4 or variant == 14 or variant == 8 or variant == 10 or variant == 15 ? "0px" : "ui.border-width") border-right-style="solid" border-right-color="ui.border"
            border-left-width=(not narrow and variant == 14 ? "ui.border-width" : "0px") border-left-style="solid" border-left-color="ui.border" background-color=(not narrow and variant == 4 ? "transparent" : "ui.sidebar") overflow="hidden"
            column flex=1 min-height=0 min-width=0 -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing-linear") border-width=(not narrow and variant == 4 ? "ui.border-width" : "0px") border-style="solid" border-color="ui.border" border-radius=(not narrow and variant == 4 ? "ui.radius-lg" : "ui.radius-flat") background-color="ui.sidebar" box-shadow=(not narrow and variant == 4 ? "ui.shadow-panel" : "none") overflow="hidden"
              for contentVariant in [variant] key=contentVariant
                if narrow
                  view align-self="flex-end" margin="ui.space-8"
                    IconButton(id=id + "-mobile-close", label="Close sidebar", variant="ghost", disabled=false, press=dismiss)
                      svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
                        path d="m6 6 12 12M6 18 18 6"
                if variant <= 6 or variant == 14
                  SidebarDocs(id=id, variant=variant, selected=current, reduced=reduced, choose=choose)
                else if variant == 7 or variant == 8 or variant == 16
                  SidebarPlatform(id=id, variant=variant, compact=compact, selected=current, reduced=reduced, choose=choose)
                else if variant == 9
                  SidebarMail(id=id, compact=compact, selected=current, reduced=reduced, choose=choose)
                else if variant == 10 or variant == 15
                  SidebarNotion(id=id, selected=current, reduced=reduced, choose=choose)
                else if variant == 11
                  SidebarFiles(id=id, selected=current, choose=choose)
                else if variant == 12
                  SidebarCalendar(id=id, reduced=reduced, choose=choose)
          column inert=(narrow and mobileOpen) aria-hidden=(narrow and mobileOpen) flex=1 min-width=0 min-height=0 margin=(variant == 8 and not narrow ? (expanded ? "ui.space-8 ui.space-8 ui.space-8 ui.space-0" : "ui.space-8") : "ui.space-0") border-radius=(variant == 8 and not narrow ? "ui.radius-xl" : "ui.radius-flat") background-color="ui.background" overflow="hidden"
            box-shadow=(variant == 8 and not narrow ? "ui.shadow-panel" : "none")
            -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing-linear")
            if variant != 16
              row height=(variant == 10 or variant == 15 ? "ui.space-56" : variant == 7 and compact ? "ui.space-48" : "ui.space-64") -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing-linear") flex-shrink=0 gap="ui.space-12" align-items="center" padding="ui.space-0 ui.space-16"
                border-bottom-width=(variant == 4 or variant == 7 or variant == 8 or variant == 10 or variant == 15 ? "0px" : "ui.border-width") border-bottom-style="solid" border-bottom-color="ui.border"
                view order=(variant == 14 ? 4 : 0)
                  SidebarTrigger(id=id + "-trigger", expanded=(narrow ? mobileOpen : expanded), controls=id + "-sidebar", press=toggle)
                if not narrow and variant != 10 and variant != 12 and variant != 15
                  view width="ui.border-width" height="ui.space-16" background-color="ui.border"
                  text (variant == 9 ? "All Inboxes" : variant == 11 ? "components / ui" : "Build Your Application") font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  SidebarIcon(name="ChevronRight")
                text current testId=(id + "-current") font-size="ui.text-sm" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                if variant == 10
                  if not narrow
                    text "Edit Oct 08" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  button id=(id + "-star") testId=(id + "-star") class=Control font-weight=uiWeights.medium press=toggleStar aria-label="Favorite page" aria-pressed=starred min-height="ui.space-28" padding="ui.space-4" border="0" background-color=(starred ? "ui.muted" : "transparent") color="ui.foreground"
                    SidebarIcon(name="Star")
                  DropdownMenu(id=id + "-actions", label="Actions", reduced=reduced, choose=choose, entries=[MenuEntry(id="Customize Page", label="Customize Page", shortcut="", disabled=false, destructive=false), MenuEntry(id="Turn into wiki", label="Turn into wiki", shortcut="", disabled=false, destructive=false), MenuEntry(id="Copy Link", label="Copy Link", shortcut="", disabled=false, destructive=false), MenuEntry(id="Duplicate", label="Duplicate", shortcut="", disabled=false, destructive=false), MenuEntry(id="Move to", label="Move to", shortcut="", disabled=false, destructive=false), MenuEntry(id="Move to Trash", label="Move to Trash", shortcut="", disabled=false, destructive=true), MenuEntry(id="Undo", label="Undo", shortcut="", disabled=false, destructive=false), MenuEntry(id="View analytics", label="View analytics", shortcut="", disabled=false, destructive=false), MenuEntry(id="Version History", label="Version History", shortcut="", disabled=false, destructive=false), MenuEntry(id="Notifications", label="Notifications", shortcut="", disabled=false, destructive=false), MenuEntry(id="Import", label="Import", shortcut="", disabled=false, destructive=false), MenuEntry(id="Export", label="Export", shortcut="", disabled=false, destructive=false)])
            scroll flex=1 min-height=0 padding=(variant == 10 ? "ui.space-40 ui.space-16" : variant == 4 or variant == 7 or variant == 8 ? "ui.space-0 ui.space-16 ui.space-16" : "ui.space-16") scroll=scrolled
              column gap="ui.space-16" min-width=0
                if query != ""
                  text ("Search: " + query) role="status" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                if variant == 2 or variant == 9
                  for i in range(24) key=i
                    view height="ui.space-48" border-radius="ui.radius-md" background-color="ui.muted" opacity="ui.opacity-muted"
                else if variant == 12
                  view display="grid" grid-template-columns=(narrow ? "repeat(2, minmax(0, 1fr))" : "repeat(5, minmax(0, 1fr))") gap="ui.space-16"
                    for i in range(20) key=i
                      view aspect-ratio="1" border-radius="ui.radius-card" background-color="ui.muted" opacity="ui.opacity-muted"
                else if variant == 10 or variant == 15
                  view height="ui.space-96" width="100%" max-width="48rem" align-self="center" border-radius="ui.radius-card" background-color="ui.muted" opacity="ui.opacity-muted"
                  view height=680 width="100%" max-width="48rem" align-self="center" border-radius="ui.radius-card" background-color="ui.muted" opacity="ui.opacity-muted"
                else
                  view display="grid" grid-template-columns=(narrow ? "minmax(0, 1fr)" : "repeat(3, minmax(0, 1fr))") gap="ui.space-16"
                    for i in range(3) key=i
                      view aspect-ratio="16/9" border-radius="ui.radius-card" background-color="ui.muted" opacity="ui.opacity-muted"
                  view min-height=400 flex=1 border-radius="ui.radius-card" background-color="ui.muted" opacity="ui.opacity-muted"
          if variant == 15 and not narrow
            column width="ui.sidebar-width-wide" min-height=0 flex-shrink=0 border-left-width="ui.border-width" border-left-style="solid" border-left-color="ui.border" background-color="ui.muted"
              SidebarCalendar(id=id + "-right", reduced=reduced, choose=choose)
          if narrow and mobileOpen
            if variant == 14
              button id=(id + "-backdrop") testId=(id + "-backdrop") press=dismiss aria-label="Close sidebar" tabindex=-1 position="absolute" top=0 bottom=0 left=0 right="min(ui.sidebar-width-wide, calc(100% - ui.space-48))" z-index=30 appearance="none" border="0" background-color="ui.overlay"
            else
              button id=(id + "-backdrop") testId=(id + "-backdrop") press=dismiss aria-label="Close sidebar" tabindex=-1 position="absolute" top=0 bottom=0 left="min(ui.sidebar-width-wide, calc(100% - ui.space-48))" right=0 z-index=30 appearance="none" border="0" background-color="ui.overlay"
