          view width="ui.border-width" height="ui.space-16" background-color="ui.border"
          text "Documents" font-size="ui.text-base" font-weight=uiWeights.medium flex=1 font-family=uiFontFamily(uiFont) data-rightui-font="body"
          link href="https://github.com/rightui-dev/ui/blob/main/blocks/dashboard.contract" color="ui.foreground" font-size="ui.text-sm" text-decoration="none" padding="ui.space-6 ui.space-12"
            text "GitHub" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        column id="dashboard-content" resize=measureContent padding=(narrow ? "ui.space-16" : "ui.space-24") gap="ui.space-24" min-width=0
          view display="grid" grid-template-columns=(contentWidth >= 1024 ? "repeat(4, minmax(0, 1fr))" : contentWidth >= 576 ? "repeat(2, minmax(0, 1fr))" : "minmax(0, 1fr)") gap="ui.space-16"
            DashboardMetric(label="Total Revenue", value="$1,250.00", change="+12.5%", trend="Trending up this month", detail="Visitors for the last 6 months")
            DashboardMetric(label="New Customers", value="1,234", change="-20%", trend="Down 20% this period", detail="Acquisition needs attention")
            DashboardMetric(label="Active Accounts", value="45,678", change="+12.5%", trend="Strong user retention", detail="Engagement exceed targets")
            DashboardMetric(label="Growth Rate", value="4.5%", change="+4.5%", trend="Steady performance increase", detail="Meets growth projections")
          column padding="ui.space-24" gap="ui.space-24" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-xl" background-color="ui.surface" min-width=0 box-shadow="ui.shadow-control"
            row gap="ui.space-16" min-height="ui.space-44" justify-content="space-between" flex-wrap="wrap" align-items="flex-start"
              column gap="ui.space-8"
                text "Total Visitors" font-size="ui.text-base" line-height="ui.leading-none" font-weight=uiWeights.semibold font-family=uiFontFamily(uiFont) data-rightui-font="body"
                text "Total for the last 3 months" font-size="ui.text-sm" line-height="ui.leading-control" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              row gap="ui.space-0" border="0" border-radius="ui.radius-md" overflow="hidden" flex-wrap="wrap"
                for p in ["90d", "30d", "7d"] key=p
                  button class=Control font-weight=uiWeights.medium id=("dashboard-period-" + p) testId=("dashboard-period-" + p) press=changePeriod(p) aria-pressed=period == p height="ui.space-36" min-height="ui.space-36" box-sizing="border-box" padding="ui.space-0 ui.space-16" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-left-width=(p == "90d" ? "ui.border-width" : "0px") border-left-style="solid" border-left-color="ui.border" border-radius="ui.radius-flat" background-color=(period == p ? "ui.muted" : "transparent") color="ui.foreground" font-size="ui.text-sm"
                    text (p == "90d" ? "Last 3 months" : p == "30d" ? "Last 30 days" : "Last 7 days") font-family=uiFontFamily(uiFont) data-rightui-font="body"
            view padding-top="ui.space-24" min-width=0
              AreaChart(id="dashboard-chart", points=points)
            text (points.length.toString() + " daily observations") testId="dashboard-period-count" font-size="ui.text-xs" position="absolute" width=1 height=1 overflow="hidden" opacity=0 aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"
          row gap="ui.space-12" justify-content="space-between" align-items="center" flex-wrap="wrap"
            CountedTabs(id="dashboard-document-tabs", labels=["Outline", "Past Performance", "Key Personnel", "Focus Documents"], counts=["", "3", "2", ""], selected=["Outline", "Past Performance", "Key Personnel", "Focus Documents"].indexOf(tab), reduced=reduced, choose=chooseTab)
            row gap="ui.space-8"
              button class=Control font-weight=uiWeights.medium id="dashboard-columns" testId="dashboard-columns" press=toggleColumns aria-expanded=columns aria-haspopup="menu" aria-controls="dashboard-columns-popup" min-height="ui.space-32" height="ui.space-32" box-sizing="border-box" padding="ui.space-0 ui.space-12" border-width="ui.border-width" border-style="solid" border-color="ui.border" background-color="ui.surface" color="ui.foreground" font-size="ui.text-xs"
                text "Customize Columns" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              ButtonContent(id="dashboard-add-section", label="+ Add Section", variant="outline", size="sm", disabled=false, press=addSection)
                text "+ Add Section" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          if columns
            column id="dashboard-columns-popup" testId="dashboard-columns-popup" role="menu" aria-label="Customize Columns" popover="auto" toggle=columnsChanged tabindex=-1
              position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" margin="ui.space-4" padding="ui.space-4" width="14rem" max-width="calc(100vw - ui.space-32)" box-sizing="border-box" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-sm" background-color="ui.surface" box-shadow="ui.shadow-menu"
              for col, i in ["Section Type", "Status", "Target", "Limit", "Reviewer"] key=col
                button id=("dashboard-column-" + col) testId=("dashboard-column-" + col) class=Control role="menuitemcheckbox" aria-checked=(not hidden.includes(col)) key=columnKeys(i) press=toggleColumn(col)
                  display="flex" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius="ui.radius-inline" background-color="transparent" color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.regular text-align="left"
                  view width="ui.space-16" height="ui.space-16" display="flex" align-items="center" justify-content="center" aria-hidden=true
                    if not hidden.includes(col)
                      svg width="ui.space-14" height="ui.space-14" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke"
                        path d="m5 12 4 4L19 6"
                  text col font-family=uiFontFamily(uiFont) data-rightui-font="body"
          if tab != "Outline"
            view id="dashboard-document-tabs-panel" role="tabpanel" aria-labelledby=("dashboard-document-tabs-" + ["Outline", "Past Performance", "Key Personnel", "Focus Documents"].indexOf(tab).toString()) border-width="ui.border-width" border-style="dashed" border-color="ui.border" border-radius="ui.radius-card" min-height=180 display="flex" align-items="center" justify-content="center"
              text tab color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          else
            column id="dashboard-document-tabs-panel" role="tabpanel" aria-labelledby="dashboard-document-tabs-0" gap="ui.space-16" min-width=0
              column max-width="20rem" min-width=0
                InputControl(id="dashboard-search", label="Filter documents", value=query, placeholder="Filter documents...", disabled=false, edit=search)
              scroll max-height=580 overflow="auto" min-width=0 border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-md" scroll=scrolled
                table width="100%" min-width=760 border-spacing=0 font-size="ui.text-caption"
                  thead background-color="ui.muted"
                    tr
                      th scope="col" padding="ui.space-4 ui.space-8" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border"
                        DataTableCheck(id="dashboard-select-all", label="Select all", checked=visible.length > 0 and visible.filter(r => selected.includes(r.id)).length == visible.length, disabled=visible.length == 0, change=selectAll)
                      for col in ["Header", "Section Type", "Status", "Target", "Limit", "Reviewer"] key=col
                        if not hidden.includes(col)
                          th scope="col" text-align="left" padding="ui.space-8" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" aria-sort=(sort == col ? (descending ? "descending" : "ascending") : "none")
                            button class=Control font-weight=uiWeights.medium press=order(col) id=("dashboard-sort-" + col) testId=("dashboard-sort-" + col) padding="ui.space-0" min-height="ui.space-28" border="0" background-color="transparent" color="ui.foreground" font-size="ui.text-xs"
                              text col font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  tbody
                    for r in visible key=r.id
                      tr testId=("dashboard-row-" + r.id.toString()) background-color=(selected.includes(r.id) ? "ui.muted" : "transparent")
                        td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-4 ui.space-8"
                          DataTableCheck(id="dashboard-select-" + r.id.toString(), label="Select " + r.header, checked=selected.includes(r.id), disabled=false, change=selectRow(r.id))
                        td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12 ui.space-8" font-weight=uiWeights.medium
                          text r.header font-family=uiFontFamily(uiFont) data-rightui-font="body"
                        if not hidden.includes("Section Type")
                          td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12 ui.space-8"
                            Badge(label=r.type, variant="outline")
                        if not hidden.includes("Status")
                          td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12 ui.space-8"
                            Badge(label=r.status, variant="outline")
                        if not hidden.includes("Target")
                          td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12 ui.space-8" text-align="right"
                            input class=Field font-weight=uiWeights.regular id=("dashboard-target-" + r.id.toString()) testId=("dashboard-target-" + r.id.toString()) value=r.target input=editDocument(r.id, "target") aria-label=("Target for " + r.header) width="4rem" min-height="ui.space-32" height="auto" padding="ui.space-4 ui.space-8" border-width="ui.border-width" border-style="solid" border-color="transparent" background-color="transparent" text-align="right" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                        if not hidden.includes("Limit")
                          td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12 ui.space-8" text-align="right"
                            input class=Field font-weight=uiWeights.regular id=("dashboard-limit-" + r.id.toString()) testId=("dashboard-limit-" + r.id.toString()) value=r.limit input=editDocument(r.id, "limit") aria-label=("Limit for " + r.header) width="4rem" min-height="ui.space-32" height="auto" padding="ui.space-4 ui.space-8" border-width="ui.border-width" border-style="solid" border-color="transparent" background-color="transparent" text-align="right" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                        if not hidden.includes("Reviewer")
                          td border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" padding="ui.space-12 ui.space-8"
                            text r.reviewer font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    if visible.length == 0
                      tr
                        td colspan=7 padding="ui.space-32" text-align="center"
                          text "No results." font-family=uiFontFamily(uiFont) data-rightui-font="body"
              row justify-content="space-between" align-items="center" gap="ui.space-16" padding="ui.space-0 ui.space-16" flex-wrap="wrap"
                text (selected.filter(s => filtered.map(r => r.id).includes(s)).length.toString() + " of " + filtered.length.toString() + " row(s) selected.") testId="dashboard-selection" font-size="ui.text-sm" color="ui.muted-foreground" flex=1 font-family=uiFontFamily(uiFont) data-rightui-font="body"
                row gap="ui.space-32" align-items="center" flex-wrap="wrap"
                  row gap="ui.space-8" align-items="center"
                    text "Rows per page" font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    button id="dashboard-page-size" testId="dashboard-page-size" class=Control press=togglePageSizes key=pageSizeTriggerKeys role="combobox" aria-expanded=pageSizes aria-haspopup="listbox" aria-controls="dashboard-page-size-options" aria-label="Rows per page" width="5rem" height="ui.space-32" min-height="ui.space-32" padding="ui.space-0 ui.space-12" border-width="ui.border-width" border-style="solid" border-color="ui.border" background-color="ui.surface" color="ui.foreground" display="flex" align-items="center" justify-content="space-between" gap="ui.space-8" font-size="ui.text-sm" font-weight=uiWeights.regular
                      text pageSize.toString() font-family=uiFontFamily(uiFont) data-rightui-font="body"
                      svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.muted-foreground" stroke-width="ui.icon-stroke" aria-hidden=true
                        path d="m6 9 6 6 6-6"
                  text ("Page " + (current + 1).toString() + " of " + pages.toString()) testId="dashboard-page" font-size="ui.text-sm" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  row gap="ui.space-8" align-items="center"
                    for direction in ["first", "previous", "next", "last"] key=direction
                      if not narrow or direction == "previous" or direction == "next"
                        IconButton(id="dashboard-" + direction, label="Go to " + direction + " page", variant="outline", disabled=(direction == "first" or direction == "previous" ? current == 0 : current == pages - 1), press=changePage(direction == "first" ? -pages : direction == "previous" ? -1 : direction == "next" ? 1 : pages))
                          svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                            path d=(direction == "first" ? "m11 7-5 5 5 5m6-10-5 5 5 5" : direction == "previous" ? "m15 18-6-6 6-6" : direction == "next" ? "m9 18 6-6-6-6" : "m7 7 5 5-5 5m6-10 5 5-5 5")
              if pageSizes
                column id="dashboard-page-size-options" testId="dashboard-page-size-options" role="listbox" aria-label="Rows per page" popover="auto" toggle=pageSizesChanged position-area="top span-right" position-try-fallbacks="flip-block, flip-inline" width="5rem" margin="ui.space-4" padding="ui.space-4" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-sm" background-color="ui.surface" box-shadow="ui.shadow-menu"
                  for size in [10, 20, 30, 40, 50] key=size
                    button id=("dashboard-size-" + size.toString()) testId=("dashboard-size-" + size.toString()) class=Control role="option" aria-selected=pageSize == size press=changeSize(size) key=pageSizeKeys(size) min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius="ui.radius-inline" background-color=(pageSize == size ? "ui.muted" : "transparent") color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.regular text-align="left"
                      text size.toString() font-family=uiFontFamily(uiFont) data-rightui-font="body"
          if notice != ""
            text notice testId="dashboard-notice" aria-live="polite" font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component DashboardMetric
  props
    label: string
    value: string
    change: string
    trend: string
    detail: string
  inject
    uiWeights: FontWeights
    uiFont: string
  view
    column position="relative" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-xl" background-image="linear-gradient(to top, ui.metric-shade, ui.surface)" padding="ui.space-24" gap="ui.space-24" min-width=0 box-shadow="ui.shadow-panel"
      row justify-content="space-between" gap="ui.space-8" align-items="flex-start" flex-wrap="wrap"
        column gap="ui.space-8" min-width=0 flex="1 1 8rem"
          text label font-size="ui.text-sm" line-height="ui.leading-control" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          text value font-size="ui.text-3xl" line-height="ui.leading-metric" font-weight=uiWeights.semibold font-variant-numeric="tabular-nums" overflow-wrap="anywhere" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        row gap="ui.space-4" padding="ui.space-2 ui.space-8" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-full" align-items="center"
          svg width="ui.space-12" height="ui.space-12" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke" aria-hidden=true
            path d=(change.startsWith("-") ? "m3 6 6 6 4-4 8 8M15 16h6v-6" : "m3 18 6-6 4 4 8-8M15 8h6v6")
          text change font-size="ui.text-xs" font-weight=uiWeights.medium font-family=uiFontFamily(uiFont) data-rightui-font="body"
      column gap="ui.space-6"
        row gap="ui.space-8" align-items="center"
          text trend font-size="ui.text-sm" line-height="ui.leading-control" font-weight=uiWeights.medium min-width=0 font-family=uiFontFamily(uiFont) data-rightui-font="body"
          svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke" aria-hidden=true
            path d=(change.startsWith("-") ? "m3 6 6 6 4-4 8 8M15 16h6v-6" : "m3 18 6-6 4 4 8-8M15 8h6v6")
        text detail font-size="ui.text-sm" line-height="ui.leading-control" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

