component DashboardMetric
  props
    label: string
    value: string
    change: string
    trend: string
    detail: string
  inject
    uiFont: string
  view
    column position="relative" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-xl" background-image="linear-gradient(to top, ui.metric-shade, ui.surface)" padding="ui.space-24" gap="ui.space-24" min-width=0 box-shadow="ui.shadow-panel"
      row justify-content="space-between" gap="ui.space-8" align-items="flex-start" flex-wrap="wrap"
        column gap="ui.space-8" min-width=0 flex="1 1 8rem"
          text label font-size="ui.text-sm" line-height="ui.leading-control" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          text value font-size="ui.text-3xl" line-height="ui.leading-metric" font-weight="ui.weight-semibold" font-variant-numeric="tabular-nums" overflow-wrap="anywhere" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        row gap="ui.space-4" padding="ui.space-2 ui.space-8" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-full" align-items="center"
          svg width="ui.space-12" height="ui.space-12" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke" aria-hidden=true
            path d=(change.startsWith("-") ? "m3 6 6 6 4-4 8 8M15 16h6v-6" : "m3 18 6-6 4 4 8-8M15 8h6v6")
          text change font-size="ui.text-xs" font-weight="ui.weight-medium" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      column gap="ui.space-6"
        row gap="ui.space-8" align-items="center"
          text trend font-size="ui.text-sm" line-height="ui.leading-control" font-weight="ui.weight-medium" min-width=0 font-family=uiFontFamily(uiFont) data-rightui-font="body"
          svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke" aria-hidden=true
            path d=(change.startsWith("-") ? "m3 6 6 6 4-4 8 8M15 16h6v-6" : "m3 18 6-6 4 4 8-8M15 8h6v6")
        text detail font-size="ui.text-sm" line-height="ui.leading-control" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component DashboardNavIcon
  props
    name: string
  view
    svg width=(name == "Acme Inc." ? "ui.space-20" : "ui.space-16") height=(name == "Acme Inc." ? "ui.space-20" : "ui.space-16") viewBox="0 0 24 24" fill=(name == "Quick Create" ? "ui.primary-foreground" : "none") stroke=(name == "Quick Create" ? "none" : "ui.foreground") stroke-width="ui.icon-stroke" stroke-linecap="round" stroke-linejoin="round" opacity=(name == "More" ? "ui.opacity-soft" : 1) aria-hidden=true
      if name == "Acme Inc."
        path d="M5.636 5.636a9 9 0 1 0 12.728 12.728a9 9 0 0 0 -12.728 -12.728z"
        path d="M16.243 7.757a6 6 0 0 0 -8.486 0"
      else if name == "Quick Create"
        path d="M4.929 4.929a10 10 0 1 1 14.141 14.141a10 10 0 0 1 -14.14 -14.14zm8.071 4.071a1 1 0 1 0 -2 0v2h-2a1 1 0 1 0 0 2h2v2a1 1 0 1 0 2 0v-2h2a1 1 0 1 0 0 -2h-2v-2z"
      else if name == "Dashboard"
        path d="M12 13m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
        path d="M13.45 11.55l2.05 -2.05"
        path d="M6.4 20a9 9 0 1 1 11.2 0z"
      else if name == "Lifecycle"
        path d="M13 5h8"
        path d="M13 9h5"
        path d="M13 15h8"
        path d="M13 19h5"
        path d="M3 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z"
        path d="M3 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z"
      else if name == "Analytics"
        path d="M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z"
        path d="M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z"
        path d="M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z"
        path d="M4 20h14"
      else if name == "Projects"
