component DashboardBlock
  props
    narrow: bool
    reduced: bool
  inject
    uiFont: string
  state desktopSidebar = true
  state mobileSidebar = false
  derive sidebar = narrow ? mobileSidebar : desktopSidebar
  state section = ""
  state period = narrow ? "7d" : "90d"
  state query = ""
  state tab = "Outline"
  state sort = "order"
  state descending = false
  state page = 0
  state pageSize = 10
  state selected: number[] = []
  state columns = false
  state contentWidth = 0
  state pageSizes = false
  state hidden: string[] = []
  state documents = dashboardDocuments()
  state notice = ""
  derive cutoff = period == "7d" ? "2024-06-23" : period == "30d" ? "2024-05-31" : "2024-04-01"
  derive points = dashboardVisitors().filter(p => p.label >= cutoff)
  derive filtered = documents.filter(r => r.header.toLowerCase().includes(query.toLowerCase()) or r.reviewer.toLowerCase().includes(query.toLowerCase()))
  derive asc = sort == "Target" ? sortBy(filtered, r => match parseNumber(r.target) { case some(n) => n, case none => 0 }) : sort == "Limit" ? sortBy(filtered, r => match parseNumber(r.limit) { case some(n) => n, case none => 0 }) : sort == "Section Type" ? sortBy(filtered, r => r.type) : sort == "Status" ? sortBy(filtered, r => r.status) : sort == "Reviewer" ? sortBy(filtered, r => r.reviewer) : sort == "Header" ? sortBy(filtered, r => r.header) : filtered
  derive ordered = descending ? range(asc.length).map(i => match asc.at(asc.length - 1 - i) { case some(r) => r, case none => DashboardDocument(id=0, header="", type="", status="", target="", limit="", reviewer="") }) : asc
  derive pages = max(1, ceil(filtered.length / pageSize))
  derive current = min(page, pages - 1)
  derive visible = ordered.slice(current * pageSize, (current + 1) * pageSize)
  action toggleSidebar
    if narrow
      mobileSidebar = not mobileSidebar
    else
      desktopSidebar = not desktopSidebar
  action navigateTo(v: string)
    section = v
    notice = v == "Search" ? "Filter documents below." : v + " selected."
    if v == "Search"
      focus("dashboard-search")
  action changePeriod(v: string)
    period = v
  action search(v: string)
    query = v
    page = 0
  action order(v: string)
    descending = sort == v ? not descending : false
    sort = v
    page = 0
  action measureContent(w: number, h: number)
    if w != contentWidth
      contentWidth = w
  action chooseTab(i: number)
    tab = match ["Outline", "Past Performance", "Key Personnel", "Focus Documents"].at(i) { case some(v) => v, case none => "Outline" }
  action toggleColumns
    if columns
      hidePopover("dashboard-columns-popup")
    else
      columns = true
      showPopover("dashboard-columns-popup", source="dashboard-columns")
      focus("dashboard-column-Section Type")
  action columnsChanged(e: ToggleEvent)
    columns = e.newState == "open"
    if e.newState == "closed"
      focus("dashboard-columns")
  action toggleColumn(v: string)
    hidden = hidden.includes(v) ? hidden.filter(c => c != v) : hidden.concat([v])
  action columnKeys(i: number, k: string)
    if k == "Escape" or k == "Tab"
      preventDefault()
      hidePopover("dashboard-columns-popup")
      focus("dashboard-columns")
    else if k == "Enter" or k == " "
      preventDefault()
      match ["Section Type", "Status", "Target", "Limit", "Reviewer"].at(i)
        case some(v)
          toggleColumn(v)
        case none
          columns = columns
    else if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
      preventDefault()
      let next = k == "Home" ? 0 : k == "End" ? 4 : (i + (k == "ArrowDown" ? 1 : 4)) % 5
      match ["Section Type", "Status", "Target", "Limit", "Reviewer"].at(next)
        case some(v)
          focus("dashboard-column-" + v)
        case none
          columns = columns
  action selectRow(rowId: number, checked: bool)
    selected = checked ? selected.concat([rowId]) : selected.filter(s => s != rowId)
  action selectAll(checked: bool)
    selected = checked ? selected.filter(s => not visible.map(r => r.id).includes(s)).concat(visible.map(r => r.id)) : selected.filter(s => not visible.map(r => r.id).includes(s))
  action editDocument(rowId: number, field: string, v: string)
    documents = documents.map(r => r.id == rowId ? (field == "target" ? DashboardDocument(r, target=v) : DashboardDocument(r, limit=v)) : r)
  action changePage(delta: number)
    page = max(0, min(pages - 1, current + delta))
  action changeSize(v: number)
    pageSize = v
    page = 0
    if pageSizes
      hidePopover("dashboard-page-size-options")
      focus("dashboard-page-size")
  action togglePageSizes
    if pageSizes
      hidePopover("dashboard-page-size-options")
    else
      pageSizes = true
      showPopover("dashboard-page-size-options", source="dashboard-page-size")
      focus("dashboard-size-" + pageSize.toString())
  action pageSizeTriggerKeys(k: string)
    if k == "ArrowDown" or k == "Enter" or k == " "
      preventDefault()
      togglePageSizes()
  action pageSizeKeys(size: number, k: string)
    if k == "Escape" or k == "Tab"
      preventDefault()
      hidePopover("dashboard-page-size-options")
      focus("dashboard-page-size")
    else if k == "Enter" or k == " "
      preventDefault()
      changeSize(size)
    else if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
      preventDefault()
      let next = k == "Home" ? 10 : k == "End" ? 50 : k == "ArrowDown" ? (size == 50 ? 10 : size + 10) : (size == 10 ? 50 : size - 10)
      focus("dashboard-size-" + next.toString())
  action pageSizesChanged(e: ToggleEvent)
    pageSizes = e.newState == "open"
    if e.newState == "closed"
      focus("dashboard-page-size")
  action addSection
    let id = documents.length + 1
    let nextPage = floor(documents.length / pageSize)
    documents = documents.concat([DashboardDocument(id=id, header="New section", type="Narrative", status="In Process", target="0", limit="0", reviewer="Assign reviewer")])
    page = nextPage
    query = ""
    sort = "order"
    descending = false
    notice = "New section added."
  view
    row testId="dashboard-block" position="relative" align-items="stretch" min-width=0 background-color="ui.sidebar" overflow="clip" color="ui.foreground" line-height="ui.leading-normal"
      view width=(narrow or not sidebar ? "0px" : "ui.sidebar-width-dashboard") flex-shrink=0 min-width=0 position="relative" z-index=20 overflow=(narrow ? "visible" : "clip") -exact-layout-transition=(reduced ? "none" : "ui.duration-normal ui.easing-linear")
        column id="dashboard-sidebar-panel" testId="dashboard-sidebar-panel" aria-hidden=(not sidebar) inert=(not sidebar) translate=(sidebar ? "0px 0px" : "-100% 0px") transition=(reduced ? "none" : "translate ui.duration-normal ui.easing-linear") position=(narrow ? "absolute" : "sticky") height="100vh" align-self="flex-start" z-index=20 left=0 top=0 bottom=0 width="ui.sidebar-width-dashboard" max-width="calc(100vw - ui.space-48)" flex-shrink=0 padding="ui.space-16" gap="ui.space-16" box-sizing="border-box" background-color="ui.sidebar"
          row gap="ui.space-8" padding="ui.space-4 ui.space-6" align-items="center"
            DashboardNavIcon(name="Acme Inc.")
            text "Acme Inc." font-size="ui.text-base" font-weight="ui.weight-semibold" flex=1 font-family=uiFontFamily(uiFont) data-rightui-font="body"
            if narrow
              IconButton(id="dashboard-sidebar-close", label="Close sidebar", variant="ghost", disabled=false, press=toggleSidebar)
                svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
                  path d="m6 6 12 12M6 18 18 6"
          row gap="ui.space-8" margin-bottom="ui.space-negative-8"
            button class=Control id="dashboard-quick-create" testId="dashboard-quick-create" press=addSection padding="ui.space-6 ui.space-8" min-height="ui.space-32" font-weight="ui.weight-regular" flex=1 background-color="ui.primary" color="ui.primary-foreground" border="0" text-align="left"
              row gap="ui.space-8" align-items="center"
                DashboardNavIcon(name="Quick Create")
                text "Quick Create" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            button class=Control press=navigateTo("Inbox") min-height="ui.space-32" width="ui.space-32" padding="ui.space-6" border-width="ui.border-width" border-style="solid" border-color="ui.border" background-color="ui.surface" aria-label="Inbox"
              svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="ui.foreground" stroke-width="ui.icon-stroke-soft" aria-hidden=true
                rect x=3 y=5 width=18 height=14 rx=2
                path d="m3 6 9 7 9-7"
          column gap="ui.space-4"
