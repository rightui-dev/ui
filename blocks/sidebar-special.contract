use Button from "@rightui/ui"
use FontWeights from "@rightui/ui"
use uiFontFamily, ControlStyle as Control, InputStyle as Field from "@rightui/ui"
use Calendar from "@rightui/ui"
use Checkbox from "@rightui/ui"
use Switch from "@rightui/ui"
use SidebarIcon, SidebarLink, SidebarUser from "./sidebar-parts.contract"
use sidebarMails, sidebarFiles, sidebarSettings from "./sidebar-data.contract"
component SidebarMail
  props
    id: string
    compact: bool
    selected: string
    reduced: bool
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state folder = "Inbox"
  state search = ""
  state unread = false
  action changeFolder(v: string)
    folder = v
  action editSearch(v: string)
    search = v
  action changeUnread(v: bool)
    unread = v
  view
    row height="100%" min-height=0
      column width="ui.sidebar-width-compact" min-width="ui.sidebar-width-compact" border-right-width="ui.border-width" border-right-style="solid" border-right-color="ui.border" padding="ui.space-4" gap="ui.space-8" box-sizing="border-box"
        view width="ui.space-32" height="ui.space-32" margin="ui.space-8 ui.space-0" border-radius="ui.radius-md" background-color="ui.primary" color="ui.primary-foreground" display="flex" align-items="center" justify-content="center"
          SidebarIcon(name="Command")
        for item, i in ["Inbox", "Drafts", "Sent", "Junk", "Trash"] key=item
          SidebarLink(id=id + "-folder-" + i.toString(), label=item, icon=(i == 0 ? "Inbox" : i == 1 ? "File" : i == 2 ? "Send" : i == 3 ? "ArchiveX" : "Trash2"), selected=(folder == item), compact=true, badge="", choose=changeFolder)
        view flex=1
        SidebarUser(id=id + "-user", compact=true, reduced=reduced, choose=choose)
      if not compact
        column flex=1 min-width=0 min-height=0
          column gap="ui.space-14" padding="ui.space-16" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border"
            row justify-content="space-between" align-items="center" gap="ui.space-8"
              text folder font-size="ui.text-base" font-weight=uiWeights.medium color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              Switch(id=id + "-unread", label="Unreads", checked=unread, disabled=false, reduced=reduced, change=changeUnread)
            input id=(id + "-search") testId=(id + "-search") class=Field font-weight=uiWeights.regular value=search input=editSearch placeholder="Type to search..." aria-label="Search mail" min-height="ui.space-32" padding="ui.space-6 ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          scroll flex=1 min-height=0
            column
              for mail, i in sidebarMails() key=mail.email
                if (not unread or i % 2 == 0) and (search == "" or (mail.name + " " + mail.subject + " " + mail.teaser).toLowerCase().includes(search.toLowerCase()))
                  button id=(id + "-mail-" + i.toString()) testId=(id + "-mail-" + i.toString()) class=Control press=choose(mail.subject)
                    display="flex" flex-direction="column" align-items="stretch" gap="ui.space-8" padding="ui.space-16" border="0" border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border" border-radius="ui.radius-flat"
                    background-color=(selected == mail.subject ? "ui.muted" : "transparent") color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.regular
                    :hover
                      background-color="ui.muted"
                    row justify-content="space-between" gap="ui.space-8"
                      text mail.name font-size="ui.text-sm" text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                      text mail.date font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    text mail.subject font-size="ui.text-sm" font-weight=uiWeights.medium text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    text mail.teaser font-size="ui.text-xs" line-height="ui.leading-snug" text-align="left" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component SidebarFiles
  props
    id: string
    selected: string
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state opened: string[] = ["/components", "/components/ui"]
  derive files = sidebarFiles()
  action toggle(path: string)
    opened = opened.includes(path) ? opened.filter(v => v != path) : opened.concat([path])
  view
    scroll height="100%" min-height=0
      column padding="ui.space-8" gap="ui.space-12"
        text "Changes" padding="ui.space-8" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        for item, i in ["README.md", "api/hello/route.ts", "app/layout.tsx"] key=item
          SidebarLink(id=id + "-change-" + i.toString(), label=item, icon="File", selected=(selected == item), compact=false, badge=(i == 1 ? "U" : "M"), choose=choose)
        text "Files" padding="ui.space-8" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        column gap="ui.space-2"
          for file, i in files key=file.path
            if file.parent == "" or (opened.includes(file.parent) and not files.filter(parent => parent.folder and file.path.startsWith(parent.path + "/")).map(parent => opened.includes(parent.path)).includes(false))
              row min-width=0
                for level in range(file.depth) key=level
                  view width="ui.space-12" flex-shrink=0 aria-hidden=true
                view flex=1 min-width=0
                  if file.folder
                    button id=(id + "-file-" + i.toString()) testId=(id + "-file-" + i.toString()) class=Control font-weight=uiWeights.medium press=toggle(file.path)
                      aria-expanded=opened.includes(file.path) display="flex" align-items="center" gap="ui.space-6" min-height="ui.space-32" width="100%" padding="ui.space-6 ui.space-8" border="0" background-color="transparent" color="ui.foreground"
                      view rotate=(opened.includes(file.path) ? "90deg" : "0deg")
                        SidebarIcon(name="ChevronRight")
                      SidebarIcon(name="Folder")
                      text file.name text-align="left" font-size="ui.text-sm" font-weight=uiWeights.regular font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  else
                    SidebarLink(id=id + "-file-" + i.toString(), label=file.name, icon="File", selected=(selected == file.name), compact=false, badge="", choose=choose)

component SidebarCalendar
  props
    id: string
    reduced: bool
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state selected = "2024-10-08"
  state year = 2024
  state month = 10
  state hidden: string[] = ["Family", "Travel", "Reminders", "Deadlines"]
  state expanded: string[] = ["My Calendars"]
  state adding = false
  state draft = ""
  state extra: string[] = []
  action changeMonth(y: number, m: number)
    year = y
    month = m
  action selectDate(value: string)
    selected = value
    choose(value)
  action toggleGroup(value: string)
    expanded = expanded.includes(value) ? expanded.filter(v => v != value) : expanded.concat([value])
  action toggleCalendar(value: string, checked: bool)
    hidden = checked ? hidden.filter(v => v != value) : hidden.concat([value])
  action startAdding(label: string)
    adding = true
    focus(id + "-new-name")
  action editName(v: string)
    draft = v
  action addCalendar
    if draft.trim() != "" and not ["Personal", "Work", "Family", "Holidays", "Birthdays", "Travel", "Reminders", "Deadlines"].concat(extra).includes(draft.trim())
      extra = extra.concat([draft.trim()])
      draft = ""
      adding = false
  view
    column height="100%" min-height=0
      view border-bottom-width="ui.border-width" border-bottom-style="solid" border-bottom-color="ui.border"
        SidebarUser(id=id + "-user", compact=false, reduced=reduced, choose=choose)
      scroll flex=1 min-height=0
        column
          Calendar(id=id + "-calendar", value=selected, year=year, month=month, changeMonth=changeMonth, end="", mode="single", disabled=false, change=selectDate)
          for group, gi in ["My Calendars", "Favorites", "Other"] key=group
            column padding="ui.space-8" border-top-width="ui.border-width" border-top-style="solid" border-top-color="ui.border" gap="ui.space-2"
              button id=(id + "-group-" + gi.toString()) testId=(id + "-group-" + gi.toString()) class=Control font-weight=uiWeights.medium press=toggleGroup(group) aria-expanded=expanded.includes(group)
                display="flex" align-items="center" justify-content="space-between" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" background-color="transparent" color="ui.foreground" font-size="ui.text-sm"
                text group font-family=uiFontFamily(uiFont) data-rightui-font="body"
                view rotate=(expanded.includes(group) ? "90deg" : "0deg")
                  SidebarIcon(name="ChevronRight")
              if expanded.includes(group)
                for item, i in (gi == 0 ? ["Personal", "Work", "Family"].concat(extra) : gi == 1 ? ["Holidays", "Birthdays"] : ["Travel", "Reminders", "Deadlines"]) key=item
                  Checkbox(id=id + "-calendar-" + gi.toString() + "-" + i.toString(), label=item, checked=(not hidden.includes(item)), disabled=false, change=toggleCalendar(item))
      column padding="ui.space-8" gap="ui.space-8" border-top-width="ui.border-width" border-top-style="solid" border-top-color="ui.border"
        if adding
          input id=(id + "-new-name") testId=(id + "-new-name") class=Field font-weight=uiWeights.regular value=draft input=editName submit=addCalendar placeholder="Calendar name" aria-label="Calendar name" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          Button(id=id + "-add-calendar", label="Add calendar", variant="outline", disabled=false, press=addCalendar)
        else
          SidebarLink(id=id + "-new", label="New Calendar", icon="Plus", selected=false, compact=false, badge="", choose=startAdding)
