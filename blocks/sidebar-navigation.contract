use ButtonContent from "@rightui/ui"
use FontWeights from "@rightui/ui"
use uiFontFamily, ControlStyle as Control, InputStyle as Field from "@rightui/ui"
use DropdownMenu, MenuEntry from "@rightui/ui"
use SidebarIcon, SidebarLink, SidebarBrand, SidebarUser from "./sidebar-parts.contract"
use SidebarSection, sidebarDocs, sidebarPlatform, sidebarFavorites, sidebarFavoriteIcons, sidebarWorkspaces from "./sidebar-data.contract"
component SidebarDocs
  props
    id: string
    variant: number
    selected: string
    reduced: bool
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state collapsed: string[] = []
  state expanded: string[] = ["Build Your Application"]
  state search = ""
  state version = "1.0.1"
  state email = ""
  state subscribed = false
  derive groups = sidebarDocs().concat(variant == 1 or variant == 6 ? [] : [SidebarSection(title="Community", icon="", items=["Contribution Guide"])])
  action editSearch(v: string)
    search = v
  action changeVersion(v: string)
    version = v
  action toggle(title: string)
    if variant == 2
      collapsed = collapsed.includes(title) ? collapsed.filter(v => v != title) : collapsed.concat([title])
    else
      expanded = expanded.includes(title) ? expanded.filter(v => v != title) : expanded.concat([title])
  action editEmail(v: string)
    email = v
    subscribed = false
  action subscribe
    subscribed = email.includes("@") and email.includes(".")
  view
    column height="100%" min-height=0 gap="ui.space-8"
      if variant == 1 or variant == 2
        column gap="ui.space-8" padding="ui.space-8"
          DropdownMenu(id=id + "-version", label=("Documentation v" + version), entries=[MenuEntry(id="1.0.1", label="1.0.1", shortcut="", disabled=false, destructive=false), MenuEntry(id="1.1.0-alpha", label="1.1.0-alpha", shortcut="", disabled=false, destructive=false), MenuEntry(id="2.0.0-beta1", label="2.0.0-beta1", shortcut="", disabled=false, destructive=false)], reduced=reduced, choose=changeVersion)
      else if variant != 14
        SidebarBrand(id=id, docs=true, compact=false, switcher=false, reduced=reduced)
      if variant == 1 or variant == 2 or variant == 5
        input id=(id + "-search") testId=(id + "-search") class=Field font-weight=uiWeights.regular value=search input=editSearch placeholder="Search the docs..." aria-label="Search the docs" margin="ui.space-0 ui.space-8" width="calc(100% - ui.space-16)" height="ui.space-32" min-height="ui.space-32" padding="ui.space-4 ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      if variant == 14
        text "Table of Contents" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.sidebar-label" padding="ui.space-12 ui.space-16" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      scroll flex=1 min-height=0
        column gap=(variant == 4 ? "ui.space-16" : "ui.space-8") padding="ui.space-8"
          for group, gi in groups key=group.title
            column gap="ui.space-2"
              if variant == 6
                DropdownMenu(id=id + "-group-" + gi.toString(), label=group.title, reduced=reduced, choose=choose, entries=group.items.map(item => MenuEntry(id=item, label=item, shortcut="", disabled=false, destructive=false)))
              else if variant == 2 or variant == 5
                button id=(id + "-group-" + gi.toString()) testId=(id + "-group-" + gi.toString()) class=Control press=toggle(group.title)
                  aria-expanded=(variant == 2 ? not collapsed.includes(group.title) : expanded.includes(group.title)) aria-controls=(id + "-children-" + gi.toString())
                  display="flex" align-items="center" justify-content="space-between" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" background-color="transparent" color="ui.foreground" font-size="ui.text-sm" font-weight=uiWeights.medium
                  text group.title text-align="left" flex=1 font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke-soft" aria-hidden=true
                    if variant == 5
                      path d="M5 12h14"
                      if not expanded.includes(group.title)
                        path d="M12 5v14"
                    else
                      path d=(variant == 2 ? (collapsed.includes(group.title) ? "m9 5 7 7-7 7" : "m5 9 7 7 7-7") : (expanded.includes(group.title) ? "m5 9 7 7 7-7" : "m9 5 7 7-7 7"))
              else
                text group.title padding="ui.space-8" font-size=(variant == 1 ? "ui.text-xs" : "ui.text-sm") font-weight=uiWeights.medium color=(variant == 1 ? "ui.muted-foreground" : "ui.foreground") font-family=uiFontFamily(uiFont) data-rightui-font="body"
              if variant != 6 and (search != "" or (variant == 2 ? not collapsed.includes(group.title) : variant == 5 ? expanded.includes(group.title) : true))
                column id=(id + "-children-" + gi.toString()) testId=(id + "-children-" + gi.toString()) gap="ui.space-2"
                  margin-left=(variant == 3 or variant == 5 or variant == 6 or variant == 14 ? "ui.space-14" : "ui.space-0")
                  padding-left=(variant == 3 or variant == 5 or variant == 6 or variant == 14 ? "ui.space-10" : "ui.space-0")
                  border-left-width=(variant == 3 or variant == 5 or variant == 6 or variant == 14 ? "ui.border-width" : "0px") border-left-style="solid" border-left-color="ui.border"
                  for item, i in group.items key=item
                    if search == "" or item.toLowerCase().includes(search.toLowerCase())
                      SidebarLink(id=id + "-doc-" + gi.toString() + "-" + i.toString(), label=item, icon="", selected=(selected == item), compact=false, badge="", choose=choose)
      if variant == 6
        column gap="ui.space-10" padding="ui.space-16" margin="ui.space-12" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-lg" background-color="ui.surface"
          text "Subscribe to our newsletter" font-size="ui.text-sm" font-weight=uiWeights.semibold color="ui.foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          text "Opt-in to receive updates and news about the sidebar." font-size="ui.text-sm" color="ui.muted-foreground" line-height="ui.leading-snug" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          input id=(id + "-email") testId=(id + "-email") class=Field font-weight=uiWeights.regular type="email" value=email input=editEmail placeholder="Email" aria-label="Email" min-height="ui.space-32" padding="ui.space-6 ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          ButtonContent(id=id + "-subscribe", label=(subscribed ? "Subscribed" : "Subscribe"), variant="primary", size="sm", disabled=false, press=subscribe)
            text (subscribed ? "Subscribed" : "Subscribe") font-family=uiFontFamily(uiFont) data-rightui-font="body"
          if email != "" and not subscribed and not email.includes("@")
            text "Enter a valid email address." role="status" font-size="ui.text-xs" color="ui.danger" font-family=uiFontFamily(uiFont) data-rightui-font="body"

component SidebarPlatform
  props
    id: string
    variant: number
    compact: bool
    selected: string
    reduced: bool
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state expanded: string[] = ["Playground"]
  action toggle(title: string)
    expanded = expanded.includes(title) ? expanded.filter(v => v != title) : expanded.concat([title])
  view
    column height="100%" min-height=0
      SidebarBrand(id=id, docs=false, compact=compact, switcher=(variant == 7), reduced=reduced)
      scroll flex=1 min-height=0
        column gap="ui.space-8"
          column padding="ui.space-8" gap="ui.space-0"
            if not compact
              text "Platform" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.sidebar-label" padding="ui.space-0 ui.space-8" height="ui.space-32" display="flex" align-items="center" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column gap="ui.space-4"
              for group, gi in sidebarPlatform() key=group.title
                column gap="ui.space-0"
                  button id=(id + "-platform-" + gi.toString()) testId=(id + "-platform-" + gi.toString()) class=Control press=toggle(group.title)
                    aria-label=group.title aria-expanded=expanded.includes(group.title) display="flex" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" background-color="transparent" color="ui.foreground" font-weight=uiWeights.regular
                    SidebarIcon(name=group.icon)
                    if not compact
                      text group.title flex=1 min-width=0 text-align="left" font-size="ui.text-sm" font-weight=uiWeights.regular font-family=uiFontFamily(uiFont) data-rightui-font="body"
                      view rotate=(expanded.includes(group.title) ? "90deg" : "0deg")
                        SidebarIcon(name="ChevronRight")
                  if not compact and expanded.includes(group.title)
                    column gap="ui.space-4" margin="ui.space-4 ui.space-14" padding="ui.space-2 ui.space-10" border-left-width="ui.border-width" border-left-style="solid" border-left-color="ui.border"
                      for item, i in group.items key=item
                        SidebarLink(id=id + "-platform-" + gi.toString() + "-" + i.toString(), label=item, icon="", selected=(selected == item), compact=false, badge="", choose=choose)
          if not compact
            column padding="ui.space-8" gap="ui.space-0"
              text "Projects" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.sidebar-label" padding="ui.space-0 ui.space-8" height="ui.space-32" display="flex" align-items="center" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              column gap="ui.space-4"
                for project, i in ["Design Engineering", "Sales & Marketing", "Travel"] key=project
                  SidebarLink(id=id + "-project-" + i.toString(), label=project, icon=(i == 0 ? "Frame" : i == 1 ? "PieChart" : "Map"), selected=(selected == project), compact=false, badge="", choose=choose)
                SidebarLink(id=id + "-projects-more", label="More", icon="More", selected=false, compact=false, badge="", choose=choose)
      if variant == 8 or variant == 16
        column padding="ui.space-8" gap="ui.space-4"
          SidebarLink(id=id + "-support", label="Support", icon="LifeBuoy", selected=(selected == "Support"), compact=compact, badge="", choose=choose)
          SidebarLink(id=id + "-feedback", label="Feedback", icon="Send", selected=(selected == "Feedback"), compact=compact, badge="", choose=choose)
      SidebarUser(id=id + "-user", compact=compact, reduced=reduced, choose=choose)

component SidebarNotion
  props
    id: string
    selected: string
    reduced: bool
    choose: action
  inject
    uiWeights: FontWeights
    uiFont: string
  state collapsed: string[] = sidebarWorkspaces().map(workspace => workspace.title)
  action toggle(title: string)
    collapsed = collapsed.includes(title) ? collapsed.filter(v => v != title) : collapsed.concat([title])
  view
    column height="100%" min-height=0
      SidebarBrand(id=id, docs=false, compact=false, switcher=true, reduced=reduced)
      column padding="ui.space-8" gap="ui.space-2"
        for item, i in ["Search", "Ask AI", "Home", "Inbox"] key=item
          SidebarLink(id=id + "-main-" + i.toString(), label=item, icon=(i == 0 ? "Search" : i == 1 ? "Sparkles" : i == 2 ? "Home" : "Inbox"), selected=(selected == item), compact=false, badge=(i == 3 ? "10" : ""), choose=choose)
      scroll flex=1 min-height=0
        column padding="ui.space-8" gap="ui.space-12"
          text "Favorites" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.sidebar-label" padding="ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          for item, i in sidebarFavorites() key=item
            row gap="ui.space-0" align-items="center" min-width=0
              text (match sidebarFavoriteIcons().at(i) { case some(icon) => icon, case none => "" }) font-size="ui.text-sm" padding-left="ui.space-8" aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"
              SidebarLink(id=id + "-favorite-" + i.toString(), label=item, icon="", selected=(selected == item), compact=false, badge="", choose=choose)
          text "Workspaces" font-size="ui.text-xs" font-weight=uiWeights.medium color="ui.sidebar-label" padding="ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          for workspace, wi in sidebarWorkspaces() key=workspace.title
            column gap="ui.space-2"
              button id=(id + "-workspace-" + wi.toString()) testId=(id + "-workspace-" + wi.toString()) class=Control font-weight=uiWeights.medium press=toggle(workspace.title)
                aria-expanded=(not collapsed.includes(workspace.title)) display="flex" align-items="center" gap="ui.space-6" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" background-color="transparent" color="ui.foreground"
                view rotate=(collapsed.includes(workspace.title) ? "0deg" : "90deg")
                  SidebarIcon(name="ChevronRight")
                text workspace.icon font-size="ui.text-sm" aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"
                text workspace.title flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="ui.text-sm" font-weight=uiWeights.regular font-family=uiFontFamily(uiFont) data-rightui-font="body"
              if not collapsed.includes(workspace.title)
                column gap="ui.space-2" margin-left="ui.space-16" padding-left="ui.space-12" border-left-width="ui.border-width" border-left-style="solid" border-left-color="ui.border"
                  for item, i in workspace.items key=item
                    SidebarLink(id=id + "-page-" + wi.toString() + "-" + i.toString(), label=item, icon="File", selected=(selected == item), compact=false, badge="", choose=choose)
      column padding="ui.space-8" gap="ui.space-2"
        for item, i in ["Calendar", "Settings", "Templates", "Trash", "Help"] key=item
          SidebarLink(id=id + "-secondary-" + i.toString(), label=item, icon=(i == 0 ? "Calendar" : i == 1 ? "Settings2" : i == 2 ? "Blocks" : i == 3 ? "Trash2" : "MessageCircleQuestion"), selected=(selected == item), compact=false, badge="", choose=choose)
